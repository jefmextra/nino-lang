fn dotenv_trim_val(s: string) -> string {
    let slen = len(s)
    mut start = 0
    while start < slen {
        let ch = char_at(s, start)
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            start = start + 1
        } else {
            break
        }
    }
    mut end = slen
    while end > start {
        let ch = char_at(s, end - 1)
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            end = end - 1
        } else {
            break
        }
    }
    let trimmed = slice(s, start, end - start)
    let tlen = len(trimmed)
    if tlen >= 2 {
        let first = char_at(trimmed, 0)
        let last = char_at(trimmed, tlen - 1)
        if (first == "\"" && last == "\"") || (first == "'" && last == "'") {
            return slice(trimmed, 1, tlen - 2)
        }
    }
    return trimmed
}

fn dotenv_parse_key(env_content: string, target_key: string, default_val: string) -> string {
    let slen = len(env_content)
    mut pos = 0
    while pos < slen {
        mut lend = pos
        while lend < slen && char_at(env_content, lend) != "\n" {
            lend = lend + 1
        }
        let line = dotenv_trim_val(slice(env_content, pos, lend - pos))
        let llen = len(line)
        if llen > 0 {
            mut eq_pos = -1
            for i in 0..llen {
                if char_at(line, i) == "=" && eq_pos == -1 {
                    eq_pos = i
                }
            }
            if eq_pos > 0 {
                let k = dotenv_trim_val(slice(line, 0, eq_pos))
                let v = dotenv_trim_val(slice(line, eq_pos + 1, llen - eq_pos - 1))
                if k == target_key {
                    return v
                }
            }
        }
        pos = lend + 1
    }
    return default_val
}

fn dotenv_get_from_file(env_path: string, target_key: string, default_val: string) -> string {
    let sys_v = get_env(target_key)
    if len(sys_v) > 0 {
        return sys_v
    }
    if file_exists(env_path) == false {
        return default_val
    }
    let content = read_file(env_path)
    return dotenv_parse_key(content, target_key, default_val)
}
