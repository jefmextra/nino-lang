fn json_escape_str(s: string) -> string {
    let slen = len(s)
    mut out = ""
    let q = "\""
    let bs = "\\"
    for i in 0..slen {
        let ch = char_at(s, i)
        if ch == q {
            out = out + bs + q
        } else if ch == bs {
            out = out + bs + bs
        } else if ch == "\n" {
            out = out + bs + "n"
        } else if ch == "\r" {
            out = out + bs + "r"
        } else if ch == "\t" {
            out = out + bs + "t"
        } else {
            out = out + ch
        }
    }
    return out
}

fn json_find_key_value_pos(json: string, key: string) -> int {
    let jlen = len(json)
    mut i = 0
    while i < jlen {
        let wc = char_at(json, i)
        if wc == " " || wc == "\t" || wc == "\r" || wc == "\n" {
            i = i + 1
        } else {
            break
        }
    }
    if i >= jlen || char_at(json, i) != "{" {
        return -1
    }
    mut obj_depth = 0
    mut arr_depth = 0
    mut expect_key = false
    while i < jlen {
        let ch = char_at(json, i)
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            i = i + 1
        } else if ch == "{" {
            obj_depth = obj_depth + 1
            arr_depth = arr_depth
            if obj_depth == 1 && arr_depth == 0 {
                expect_key = true
            } else {
                expect_key = false
            }
            i = i + 1
        } else if ch == "}" {
            obj_depth = obj_depth - 1
            expect_key = false
            i = i + 1
            if obj_depth <= 0 {
                return -1
            }
        } else if ch == "[" {
            arr_depth = arr_depth + 1
            expect_key = false
            i = i + 1
        } else if ch == "]" {
            arr_depth = arr_depth - 1
            expect_key = false
            i = i + 1
        } else if ch == "," {
            if obj_depth == 1 && arr_depth == 0 {
                expect_key = true
            }
            i = i + 1
        } else if ch == ":" {
            expect_key = false
            i = i + 1
        } else if ch == "\"" {
            i = i + 1
            mut parsed_s = ""
            while i < jlen {
                let sc = char_at(json, i)
                if sc == "\\" && i + 1 < jlen {
                    let nx = char_at(json, i + 1)
                    if nx == "n" {
                        parsed_s = parsed_s + "\n"
                    } else if nx == "r" {
                        parsed_s = parsed_s + "\r"
                    } else if nx == "t" {
                        parsed_s = parsed_s + "\t"
                    } else {
                        parsed_s = parsed_s + nx
                    }
                    i = i + 2
                } else if sc == "\"" {
                    i = i + 1
                    break
                } else {
                    parsed_s = parsed_s + sc
                    i = i + 1
                }
            }
            if obj_depth == 1 && arr_depth == 0 && expect_key {
                expect_key = false
                mut after = i
                while after < jlen {
                    let ac = char_at(json, after)
                    if ac == " " || ac == "\t" || ac == "\r" || ac == "\n" {
                        after = after + 1
                    } else {
                        break
                    }
                }
                if after < jlen && char_at(json, after) == ":" {
                    if parsed_s == key {
                        mut vpos = after + 1
                        while vpos < jlen {
                            let vc = char_at(json, vpos)
                            if vc == " " || vc == "\t" || vc == "\r" || vc == "\n" {
                                vpos = vpos + 1
                            } else {
                                break
                            }
                        }
                        return vpos
                    }
                    i = after + 1
                }
            }
        } else {
            expect_key = false
            i = i + 1
        }
    }
    return -1
}

fn json_has_key(json: string, key: string) -> bool {
    return json_find_key_value_pos(json, key) != -1
}

fn json_get_string(json: string, key: string) -> string {
    let vpos = json_find_key_value_pos(json, key)
    if vpos == -1 {
        return ""
    }
    let jlen = len(json)
    if vpos >= jlen || char_at(json, vpos) != "\"" {
        return ""
    }
    mut i = vpos + 1
    mut out = ""
    while i < jlen {
        let ch = char_at(json, i)
        if ch == "\\" && i + 1 < jlen {
            let nxt = char_at(json, i + 1)
            if nxt == "n" {
                out = out + "\n"
            } else if nxt == "r" {
                out = out + "\r"
            } else if nxt == "t" {
                out = out + "\t"
            } else {
                out = out + nxt
            }
            i = i + 2
        } else if ch == "\"" {
            return out
        } else {
            out = out + ch
            i = i + 1
        }
    }
    return out
}

fn json_get_number(json: string, key: string) -> int {
    let vpos = json_find_key_value_pos(json, key)
    if vpos == -1 {
        return 0
    }
    let jlen = len(json)
    mut i = vpos
    mut sign = 1
    if i < jlen && char_at(json, i) == "-" {
        sign = -1
        i = i + 1
    }
    mut val = 0
    while i < jlen {
        let code = char_code_at(json, i)
        if code >= 48 && code <= 57 {
            val = val * 10 + (code - 48)
            i = i + 1
        } else {
            break
        }
    }
    return val * sign
}

fn json_get_bool(json: string, key: string) -> bool {
    let vpos = json_find_key_value_pos(json, key)
    if vpos == -1 {
        return false
    }
    if vpos + 4 <= len(json) && slice(json, vpos, 4) == "true" {
        return true
    }
    return false
}

fn json_kv_str(key: string, val: string) -> string {
    return "\"" + json_escape_str(key) + "\":\"" + json_escape_str(val) + "\""
}

fn json_kv_int(key: string, val: int) -> string {
    return "\"" + json_escape_str(key) + "\":" + int_to_str(val)
}

fn json_kv_bool(key: string, val: bool) -> string {
    mut bstr = "false"
    if val {
        bstr = "true"
    }
    return "\"" + json_escape_str(key) + "\":" + bstr
}

fn json_object2(f1: string, f2: string) -> string {
    let lb = "{"
    let rb = "}"
    return lb + f1 + "," + f2 + rb
}

fn json_object3(f1: string, f2: string, f3: string) -> string {
    let lb = "{"
    let rb = "}"
    return lb + f1 + "," + f2 + "," + f3 + rb
}
