fn json_escape_str(s: string) -> string {
    let slen = len(s)
    mut out = ""
    let q = "\""
    let bs = "\\"
    for i in 0..slen {
        let ch = char_at(s, i)
        if ch == q {
            out = out + bs + q
        } else if ch == bs {
            out = out + bs + bs
        } else if ch == "\n" {
            out = out + bs + "n"
        } else if ch == "\r" {
            out = out + bs + "r"
        } else if ch == "\t" {
            out = out + bs + "t"
        } else {
            out = out + ch
        }
    }
    return out
}

fn json_hex_nib(ch: string) -> int {
    let c = char_code(ch)
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    return -1
}

fn json_decode_string_at(json: string, start_q: int, mut out_next: [int]) -> string {
    let jlen = len(json)
    mut i = start_q + 1
    mut out = ""
    while i < jlen {
        let ch = char_at(json, i)
        if ch == "\\" && i + 1 < jlen {
            let nxt = char_at(json, i + 1)
            if nxt == "n" {
                out = out + "\n"
                i = i + 2
            } else if nxt == "r" {
                out = out + "\r"
                i = i + 2
            } else if nxt == "t" {
                out = out + "\t"
                i = i + 2
            } else if nxt == "b" {
                out = out + char_from_code(8)
                i = i + 2
            } else if nxt == "f" {
                out = out + char_from_code(12)
                i = i + 2
            } else if nxt == "u" && i + 5 < jlen {
                let d0 = json_hex_nib(char_at(json, i + 2))
                let d1 = json_hex_nib(char_at(json, i + 3))
                let d2 = json_hex_nib(char_at(json, i + 4))
                let d3 = json_hex_nib(char_at(json, i + 5))
                if d0 >= 0 && d1 >= 0 && d2 >= 0 && d3 >= 0 {
                    let cp = (d0 << 12) | (d1 << 8) | (d2 << 4) | d3
                    if cp > 0 && cp < 128 {
                        out = out + char_from_code(cp)
                    } else if cp >= 128 && cp < 2048 {
                        out = out + char_from_code(192 | (cp >> 6)) + char_from_code(128 | (cp & 63))
                    } else if cp >= 2048 {
                        out = out + char_from_code(224 | (cp >> 12)) + char_from_code(128 | ((cp >> 6) & 63)) + char_from_code(128 | (cp & 63))
                    }
                    i = i + 6
                } else {
                    out = out + nxt
                    i = i + 2
                }
            } else {
                out = out + nxt
                i = i + 2
            }
        } else if ch == "\"" {
            i = i + 1
            break
        } else {
            out = out + ch
            i = i + 1
        }
    }
    out_next[0] = i
    return out
}

fn json_find_key_value_pos(json: string, key: string) -> int {
    let jlen = len(json)
    mut i = 0
    while i < jlen {
        let wc = char_at(json, i)
        if wc == " " || wc == "\t" || wc == "\r" || wc == "\n" {
            i = i + 1
        } else {
            break
        }
    }
    if i >= jlen || char_at(json, i) != "{" {
        return -1
    }
    mut obj_depth = 0
    mut arr_depth = 0
    mut expect_key = false
    while i < jlen {
        let ch = char_at(json, i)
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            i = i + 1
        } else if ch == "{" {
            obj_depth = obj_depth + 1
            arr_depth = arr_depth
            if obj_depth == 1 && arr_depth == 0 {
                expect_key = true
            } else {
                expect_key = false
            }
            i = i + 1
        } else if ch == "}" {
            obj_depth = obj_depth - 1
            expect_key = false
            i = i + 1
            if obj_depth <= 0 {
                return -1
            }
        } else if ch == "[" {
            arr_depth = arr_depth + 1
            expect_key = false
            i = i + 1
        } else if ch == "]" {
            arr_depth = arr_depth - 1
            expect_key = false
            i = i + 1
        } else if ch == "," {
            if obj_depth == 1 && arr_depth == 0 {
                expect_key = true
            }
            i = i + 1
        } else if ch == ":" {
            expect_key = false
            i = i + 1
        } else if ch == "\"" {
            mut nx_pos: [int] = [0]
            let parsed_s = json_decode_string_at(json, i, nx_pos)
            i = nx_pos[0]
            if obj_depth == 1 && arr_depth == 0 && expect_key {
                expect_key = false
                mut after = i
                while after < jlen {
                    let ac = char_at(json, after)
                    if ac == " " || ac == "\t" || ac == "\r" || ac == "\n" {
                        after = after + 1
                    } else {
                        break
                    }
                }
                if after < jlen && char_at(json, after) == ":" {
                    if parsed_s == key {
                        mut vpos = after + 1
                        while vpos < jlen {
                            let vc = char_at(json, vpos)
                            if vc == " " || vc == "\t" || vc == "\r" || vc == "\n" {
                                vpos = vpos + 1
                            } else {
                                break
                            }
                        }
                        return vpos
                    }
                    i = after + 1
                }
            }
        } else {
            expect_key = false
            i = i + 1
        }
    }
    return -1
}

fn json_has_key(json: string, key: string) -> bool {
    return json_find_key_value_pos(json, key) != -1
}

fn json_get_string(json: string, key: string) -> string {
    let vpos = json_find_key_value_pos(json, key)
    if vpos == -1 {
        return ""
    }
    let jlen = len(json)
    if vpos >= jlen || char_at(json, vpos) != "\"" {
        return ""
    }
    mut nx_pos: [int] = [0]
    return json_decode_string_at(json, vpos, nx_pos)
}

fn json_get_number(json: string, key: string) -> int {
    let vpos = json_find_key_value_pos(json, key)
    if vpos == -1 {
        return 0
    }
    let jlen = len(json)
    mut i = vpos
    mut sign = 1
    if i < jlen && char_at(json, i) == "-" {
        sign = -1
        i = i + 1
    }
    mut val = 0
    while i < jlen {
        let code = char_code_at(json, i)
        if code >= 48 && code <= 57 {
            val = val * 10 + (code - 48)
            i = i + 1
        } else {
            break
        }
    }
    return val * sign
}

fn json_get_bool(json: string, key: string) -> bool {
    let vpos = json_find_key_value_pos(json, key)
    if vpos == -1 {
        return false
    }
    if vpos + 4 <= len(json) && slice(json, vpos, 4) == "true" {
        return true
    }
    return false
}

fn json_kv_str(key: string, val: string) -> string {
    return "\"" + json_escape_str(key) + "\":\"" + json_escape_str(val) + "\""
}

fn json_kv_int(key: string, val: int) -> string {
    return "\"" + json_escape_str(key) + "\":" + int_to_str(val)
}

fn json_kv_bool(key: string, val: bool) -> string {
    mut bstr = "false"
    if val {
        bstr = "true"
    }
    return "\"" + json_escape_str(key) + "\":" + bstr
}

fn json_object2(f1: string, f2: string) -> string {
    let lb = "{"
    let rb = "}"
    return lb + f1 + "," + f2 + rb
}

fn json_object3(f1: string, f2: string, f3: string) -> string {
    let lb = "{"
    let rb = "}"
    return lb + f1 + "," + f2 + "," + f3 + rb
}
