fn regex_class_match(pat: string, pi: int, clen_tok: int, txt: string, ti: int) -> bool {
    let ch_c = char_code_at(txt, ti)
    mut idx = pi + 1
    let cls_end = pi + clen_tok - 1
    mut neg = false
    if idx < cls_end && char_at(pat, idx) == "^" {
        neg = true
        idx = idx + 1
    }
    mut matched = false
    while idx < cls_end && matched == false {
        let cur_c = char_code_at(pat, idx)
        if idx + 2 < cls_end && char_at(pat, idx + 1) == "-" {
            let hi_c = char_code_at(pat, idx + 2)
            if ch_c >= cur_c && ch_c <= hi_c {
                matched = true
            }
            idx = idx + 3
        } else if cur_c == 92 && idx + 1 < cls_end {
            let nx = char_at(pat, idx + 1)
            if nx == "d" && ch_c >= 48 && ch_c <= 57 {
                matched = true
            } else if nx == "w" && ((ch_c >= 65 && ch_c <= 90) || (ch_c >= 97 && ch_c <= 122) || (ch_c >= 48 && ch_c <= 57) || ch_c == 95) {
                matched = true
            } else if ch_c == char_code_at(pat, idx + 1) {
                matched = true
            }
            idx = idx + 2
        } else {
            if ch_c == cur_c {
                matched = true
            }
            idx = idx + 1
        }
    }
    if neg {
        return !matched
    }
    return matched
}

fn regex_atom_eq(pat: string, pi: int, slen_tok: int, txt: string, ti: int) -> bool {
    let pc = char_at(pat, pi)
    if pc == "[" {
        return regex_class_match(pat, pi, slen_tok, txt, ti)
    }
    if pc == "." {
        return true
    }
    if pc == "\\" && pi + 1 < len(pat) {
        let esc = char_at(pat, pi + 1)
        let code_num = char_code_at(txt, ti)
        if esc == "d" {
            return code_num >= 48 && code_num <= 57
        }
        if esc == "w" {
            let is_up = code_num >= 65 && code_num <= 90
            let is_lo = code_num >= 97 && code_num <= 122
            let is_dg = code_num >= 48 && code_num <= 57
            return is_up || is_lo || is_dg || code_num == 95
        }
        if esc == "s" {
            return code_num == 32 || code_num == 9 || code_num == 10 || code_num == 13
        }
        return char_at(txt, ti) == esc
    }
    return pc == char_at(txt, ti)
}

fn regex_step_len(pat: string, pi: int, end_pi: int) -> int {
    let ch = char_at(pat, pi)
    if ch == "\\" && pi + 1 < end_pi {
        return 2
    }
    if ch == "[" {
        mut j = pi + 1
        if j < end_pi && char_at(pat, j) == "^" { j = j + 1 }
        if j < end_pi && char_at(pat, j) == "]" { j = j + 1 }
        while j < end_pi {
            let jc = char_at(pat, j)
            if jc == "\\" && j + 1 < end_pi {
                j = j + 2
            } else if jc == "]" {
                return j - pi + 1
            } else {
                j = j + 1
            }
        }
    }
    if ch == "(" {
        mut depth = 1
        mut in_cls = false
        mut j = pi + 1
        while j < end_pi && depth > 0 {
            let jc = char_at(pat, j)
            if jc == "\\" && j + 1 < end_pi {
                j = j + 2
            } else if in_cls {
                if jc == "]" { in_cls = false }
                j = j + 1
            } else if jc == "[" {
                in_cls = true
                j = j + 1
            } else if jc == "(" {
                depth = depth + 1
                j = j + 1
            } else if jc == ")" {
                depth = depth - 1
                j = j + 1
            } else {
                j = j + 1
            }
        }
        if depth == 0 {
            return j - pi
        }
    }
    return 1
}

fn regex_find_top_alt(pat: string, pi: int, end_pi: int) -> int {
    mut depth = 0
    mut in_cls = false
    mut j = pi
    while j < end_pi {
        let jc = char_at(pat, j)
        if jc == "\\" && j + 1 < end_pi {
            j = j + 2
        } else if in_cls {
            if jc == "]" { in_cls = false }
            j = j + 1
        } else if jc == "[" {
            in_cls = true
            j = j + 1
        } else if jc == "(" {
            depth = depth + 1
            j = j + 1
        } else if jc == ")" {
            if depth > 0 { depth = depth - 1 }
            j = j + 1
        } else if jc == "|" && depth == 0 {
            return j
        } else {
            j = j + 1
        }
    }
    return -1
}

fn regex_match_range(pat: string, pi: int, end_pi: int, txt: string, ti: int, anchor_end: bool, mut steps: [int]) -> bool {
    if steps[0] > 20000 {
        return false
    }
    steps[0] = steps[0] + 1
    let alt_pos = regex_find_top_alt(pat, pi, end_pi)
    if alt_pos != -1 {
        if regex_match_range(pat, pi, alt_pos, txt, ti, anchor_end, steps) {
            return true
        }
        return regex_match_range(pat, alt_pos + 1, end_pi, txt, ti, anchor_end, steps)
    }
    let tlen = len(txt)
    if pi >= end_pi {
        if anchor_end {
            return ti == tlen
        }
        return true
    }
    let step = regex_step_len(pat, pi, end_pi)
    mut quant = ""
    if pi + step < end_pi {
        let qc = char_at(pat, pi + step)
        if qc == "*" || qc == "+" || qc == "?" {
            quant = qc
        }
    }
    if char_at(pat, pi) == "(" && step >= 2 && char_at(pat, pi + step - 1) == ")" {
        let g_start = pi + 1
        let g_end = pi + step - 1
        mut next_pi = pi + step
        if len(quant) > 0 {
            next_pi = next_pi + 1
        }
        if quant == "*" || quant == "?" {
            if regex_match_range(pat, next_pi, end_pi, txt, ti, anchor_end, steps) {
                return true
            }
        }
        mut end_pos = tlen
        while end_pos >= ti {
            let sub = slice(txt, ti, end_pos - ti)
            if regex_match_range(pat, g_start, g_end, sub, 0, true, steps) {
                if quant == "*" || quant == "+" {
                    if end_pos > ti {
                        if regex_match_range(pat, pi, end_pi, txt, end_pos, anchor_end, steps) {
                            return true
                        }
                    }
                    if quant == "+" {
                        if regex_match_range(pat, next_pi, end_pi, txt, end_pos, anchor_end, steps) {
                            return true
                        }
                    }
                } else {
                    if regex_match_range(pat, next_pi, end_pi, txt, end_pos, anchor_end, steps) {
                        return true
                    }
                }
            }
            end_pos = end_pos - 1
        }
        return false
    }
    if quant == "*" {
        let next_pi = pi + step + 1
        if regex_match_range(pat, next_pi, end_pi, txt, ti, anchor_end, steps) {
            return true
        }
        mut cur_t = ti
        while cur_t < tlen && regex_atom_eq(pat, pi, step, txt, cur_t) {
            cur_t = cur_t + 1
            if regex_match_range(pat, next_pi, end_pi, txt, cur_t, anchor_end, steps) {
                return true
            }
        }
        return false
    }
    if quant == "+" {
        let next_pi = pi + step + 1
        mut cur_t = ti
        while cur_t < tlen && regex_atom_eq(pat, pi, step, txt, cur_t) {
            cur_t = cur_t + 1
            if regex_match_range(pat, next_pi, end_pi, txt, cur_t, anchor_end, steps) {
                return true
            }
        }
        return false
    }
    if quant == "?" {
        let next_pi = pi + step + 1
        if ti < tlen && regex_atom_eq(pat, pi, step, txt, ti) {
            if regex_match_range(pat, next_pi, end_pi, txt, ti + 1, anchor_end, steps) {
                return true
            }
        }
        return regex_match_range(pat, next_pi, end_pi, txt, ti, anchor_end, steps)
    }
    if ti < tlen && regex_atom_eq(pat, pi, step, txt, ti) {
        return regex_match_range(pat, pi + step, end_pi, txt, ti + 1, anchor_end, steps)
    }
    return false
}

fn regex_find_pos(pattern: string, text: string) -> int {
    mut pat = pattern
    mut anchor_start = false
    mut anchor_end = false
    if len(pat) > 0 && char_at(pat, 0) == "^" {
        anchor_start = true
        pat = slice(pat, 1, len(pat) - 1)
    }
    if len(pat) > 0 && char_at(pat, len(pat) - 1) == "$" {
        anchor_end = true
        pat = slice(pat, 0, len(pat) - 1)
    }
    let plen = len(pat)
    mut steps = [0]
    if anchor_start {
        if regex_match_range(pat, 0, plen, text, 0, anchor_end, steps) {
            return 0
        }
        return -1
    }
    let tlen = len(text)
    mut ti = 0
    while ti <= tlen {
        if regex_match_range(pat, 0, plen, text, ti, anchor_end, steps) {
            return ti
        }
        ti = ti + 1
    }
    return -1
}

fn regex_search(pattern: string, text: string) -> bool {
    return regex_find_pos(pattern, text) != -1
}

fn regex_match(pattern: string, text: string) -> bool {
    mut pat = pattern
    if len(pat) == 0 || char_at(pat, 0) != "^" {
        pat = "^" + pat
    }
    if len(pat) == 0 || char_at(pat, len(pat) - 1) != "$" {
        pat = pat + "$"
    }
    return regex_find_pos(pat, text) == 0
}
