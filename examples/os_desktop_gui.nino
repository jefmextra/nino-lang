fn main() {
    print("==================================================")
    print("       NINO OS GRAPHICAL DESKTOP ENVIRONMENT      ")
    print("==================================================")
    print("Launching Native Windows 11 Style Desktop Engine...")

    let win = gui_create_window("Nino OS [v0.4.0 Vanguard] - Desktop Environment", 960, 600)

    mut start_open = false
    mut active_win = "control_panel"
    mut control_tab = "security"
    mut audit_count = 1
    mut selected_file = "kernel_os.o"
    mut term_cmd = "sysinfo"
    mut term_out = "[Nino Kernel OS v0.4.0 - Pioneer Cryptographic Bare-Metal System]"
    mut status_msg = "All security enclaves sealed (0 memory leaks)"

    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)

    print("==================================================")
    print("SUCCESS: Nino OS Modern Desktop OPERATIONAL!")
    print("[Nino GUI] Windows 11 Desktop Style active with clean icons, taskbar & Control Panel!")
    print("==================================================")

    while gui_is_active(win) {
        let click = gui_poll_click(win)
        if click != nil {
            let cx = click[0]
            let cy = click[1]

            if cx >= 16 and cx <= 111 and cy >= 557 and cy <= 593 {
                start_open = not start_open
                render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
            }
            else if start_open and cx >= 16 and cx <= 376 and cy >= 150 and cy <= 545 {
                if cx >= 32 and cx <= 187 and cy >= 240 and cy <= 282 {
                    active_win = "control_panel"
                    start_open = false
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 200 and cx <= 360 and cy >= 240 and cy <= 282 {
                    active_win = "file_explorer"
                    start_open = false
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 32 and cx <= 187 and cy >= 292 and cy <= 334 {
                    active_win = "terminal"
                    start_open = false
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 200 and cx <= 360 and cy >= 292 and cy <= 334 {
                    active_win = "settings"
                    start_open = false
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 295 and cx <= 360 and cy >= 497 and cy <= 527 {
                    print("[Nino GUI] User requested power shut down.")
                    gui_clear(win)
                    break
                }
            }
            else {
                if start_open {
                    start_open = false
                }

                if cx >= 20 and cx <= 94 and cy >= 20 and cy <= 92 {
                    active_win = "file_explorer"
                    status_msg = "Opened File Explorer"
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 20 and cx <= 94 and cy >= 105 and cy <= 177 {
                    active_win = "control_panel"
                    status_msg = "Opened Control Panel"
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 20 and cx <= 94 and cy >= 190 and cy <= 262 {
                    active_win = "terminal"
                    status_msg = "Opened Nino Terminal"
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 20 and cx <= 94 and cy >= 275 and cy <= 347 {
                    active_win = "settings"
                    status_msg = "Opened System Settings"
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 20 and cx <= 94 and cy >= 360 and cy <= 432 {
                    status_msg = "Official Authority: ninosec.me (Architect: vvictor)"
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }
                else if cx >= 20 and cx <= 94 and cy >= 445 and cy <= 517 {
                    status_msg = "Recycle Bin is empty (0 items)"
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }

                else if active_win != "none" and cx >= 805 and cx <= 845 and cy >= 40 and cy <= 70 {
                    active_win = "none"
                    status_msg = "Closed window"
                    render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                }

                else if active_win == "control_panel" {
                    if cx >= 148 and cx <= 308 {
                        if cy >= 90 and cy <= 126 {
                            control_tab = "security"
                            render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                        } else if cy >= 135 and cy <= 171 {
                            control_tab = "kernel"
                            render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                        } else if cy >= 180 and cy <= 216 {
                            control_tab = "display"
                            render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                        } else if cy >= 225 and cy <= 261 {
                            control_tab = "about"
                            render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                        }
                    }

                    if control_tab == "security" and cx >= 330 and cx <= 570 and cy >= 368 and cy <= 406 {
                        audit_count = audit_count + 1
                        status_msg = "Enclave Audit #" + audit_count + ": PASS (0 Leaks)"
                        render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                    }
                }

                else if active_win == "terminal" and cy >= 430 and cy <= 475 {
                    if cx >= 155 and cx <= 295 {
                        term_cmd = "sysinfo"
                        term_out = "[OS] Nino Kernel OS v0.4.0 (x86_64 Long Mode, Ring 0 Supervisor)"
                        render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                    } else if cx >= 305 and cx <= 465 {
                        audit_count = audit_count + 1
                        term_cmd = "enclave --audit"
                        term_out = "[ENCLAVE #" + audit_count + "] Hardware Enclave 100% Sealed | Memory Integrity: PASS"
                        render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                    } else if cx >= 475 and cx <= 615 {
                        term_cmd = "whoami"
                        term_out = "[USER] root (Ring 0 Kernel Authority - Architect: vvictor)"
                        render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                    } else if cx >= 625 and cx <= 745 {
                        term_cmd = "clear"
                        term_out = "[BUFFER] Terminal shell screen cleared."
                        render_desktop(win, start_open, active_win, control_tab, audit_count, selected_file, term_cmd, term_out, status_msg)
                    }
                }
            }
        }
        gui_sleep(win, 16)
    }
}
