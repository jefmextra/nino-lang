import "std/option.nino"
import "std/result.nino"

fn safe_divide(numerator: i64, denominator: i64) -> OptionI64 {
    if denominator == 0 {
        return none_i64()
    }
    return some_i64(numerator / denominator)
}

fn parse_sovereign_token(token: str) -> ResultStr {
    if len(token) < 5 {
        return err_str("TOKEN_TOO_SHORT")
    }
    return ok_str("PARSED:" + token)
}

fn main() {
    print("================================================================================")
    print("     NINO PARAMETRIC GENERICS & POLYMORPHISM (Option<T>, Result<T, E>)")
    print("================================================================================")

    print("\n[1/3] Parametric Option<i64> Evaluation:")
    let res1 = safe_divide(100, 4)
    print("  -> safe_divide(100, 4) is_some :", option_i64_is_some(res1))
    print("  -> safe_divide(100, 4) unwrap  :", option_i64_unwrap(res1))

    let res2 = safe_divide(100, 0)
    print("  -> safe_divide(100, 0) is_none :", option_i64_is_none(res2))
    print("  -> safe_divide(100, 0) unwrap_or:", option_i64_unwrap_or(res2, -1))

    print("\n[2/3] Parametric Result<str, str> Evaluation:")
    let ok_res = parse_sovereign_token("SOVEREIGN_AUTH_KEY_2026")
    print("  -> Valid Token is_ok           :", result_str_is_ok(ok_res))
    print("  -> Valid Token unwrap          :", result_str_unwrap(ok_res))

    let err_res = parse_sovereign_token("KEY")
    print("  -> Invalid Token is_err        :", result_str_is_err(err_res))
    print("  -> Invalid Token unwrap_err    :", result_str_unwrap_err(err_res))

    print("\n[3/3] Parametric Array<T> Slice Polymorphism:")
    let num_slice: [i64] = [10, 20, 30, 40]
    let str_slice: [str] = ["ALPHA", "BETA", "GAMMA"]
    print("  -> Typed Array<i64> length     :", len(num_slice))
    print("  -> Typed Array<str> length     :", len(str_slice))

    print("\n================================================================================")
    print("  [SUCCESS] All Parametric Generic Abstractions Evaluated 100% Soundly!")
    print("================================================================================")
}
