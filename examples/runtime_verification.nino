import "std/db.nino"
import "std/mpc.nino"
import "std/interop.nino"
import "std/consensus.nino"

fn demo_database_layer() {
    print("--- [1] SOVEREIGN DATABASE ENGINE & CAPABILITY MATRIX ---")
    mut db = db_sqlite_open_conn(":memory:")
    let rows_created = db_execute_update(db, "CREATE TABLE accounts (id INTEGER, owner TEXT, balance REAL)", [])
    print("  [✓ Schema Created] In-memory SQLite table initialized.")

    let ins1 = db_execute_update(db, "INSERT INTO accounts VALUES (1, 'Alice', 2500.0)", [])
    let ins2 = db_execute_update(db, "INSERT INTO accounts VALUES (2, 'Bob', 1400.0)", [])
    print("  [✓ Rows Inserted] Records committed with zero SQL injection risk.")

    let results = db_execute_query(db, "SELECT owner, balance FROM accounts WHERE balance > 2000.0", [])
    print("  [✓ Query Executed] Qualified accounts count: ", len(results))

    mut redis = db_redis_connect_conn(":memory:", 0)
    let ping_res = db_redis_command(redis, "PING", [])
    print("  [✓ Redis Ping] Protocol response: ", ping_res)
    let set_res = db_redis_command(redis, "SET", ["session_token", "sovereign_token_999"])
    let token = db_redis_command(redis, "GET", ["session_token"])
    print("  [✓ Redis Session] Stored key verified: ", token)

    db_disconnect(db)
    db_disconnect(redis)
}

fn demo_mpc_secret_sharing() {
    print("\n--- [2] MULTI-PARTY COMPUTATION & SHAMIR SECRET SHARING ---")
    let root_secret = 1337
    let threshold_k = 3
    let total_n = 5
    print("  Original Vault Secret : ", root_secret)
    print("  Threshold Scheme      : (3-of-5) Quorum")

    let threshold_key = mpc_split_secret(root_secret, threshold_k, total_n)
    print("  Total Shares Emitted  : ", len(threshold_key.shares))

    mut quorum_subset = []
    quorum_subset = push(quorum_subset, threshold_key.shares[0])
    quorum_subset = push(quorum_subset, threshold_key.shares[1])
    quorum_subset = push(quorum_subset, threshold_key.shares[2])

    let recovered = mpc_reconstruct_secret(quorum_subset, threshold_k)
    print("  Recovered Secret      : ", recovered)
    require(recovered == root_secret, "MPC Reconstruction failed!")
    print("  [✓ Cryptographic Math]: Perfect reconstruction satisfied without leaking root private key.")
}

fn demo_foreign_interop() {
    print("\n--- [3] ZERO-COPY FOREIGN MEMORY FABRIC & C ABI ---")
    mut fptr = foreign_ptr_borrow(64, "C_ABI_X86_64")
    foreign_ptr_write_u8(fptr, 0, 78)
    foreign_ptr_write_u8(fptr, 1, 73)
    foreign_ptr_write_u8(fptr, 2, 78)
    foreign_ptr_write_u8(fptr, 3, 79)

    let b0 = foreign_ptr_read_u8(fptr, 0)
    let b1 = foreign_ptr_read_u8(fptr, 1)
    let b2 = foreign_ptr_read_u8(fptr, 2)
    let b3 = foreign_ptr_read_u8(fptr, 3)
    print("  Read foreign memory bytes: ", b0, b1, b2, b3)
    print("  [✓ Borrow Checked]: Foreign C memory safely isolated under linear ownership.")
    foreign_ptr_release(fptr)
}

fn demo_cluster_consensus() {
    print("\n--- [4] DISTRIBUTED RAFT & BFT CLUSTER CONSENSUS ---")
    let node_ids = ["node_alpha", "node_beta", "node_gamma", "node_delta", "node_omega"]
    mut cluster = raft_create_cluster(node_ids, 3)
    print("  Cluster Nodes Initialized : ", len(cluster.nodes))

    let elected = raft_elect_leader(cluster, "node_alpha", 1)
    if elected {
        cluster.leader_id = "node_alpha"
    }
    print("  Leader Election Status    : ", elected)
    print("  Active Cluster Leader     : ", cluster.leader_id)

    let p1 = raft_propose_entry(cluster, "TX_001_GENESIS_ROOT")
    let p2 = raft_propose_entry(cluster, "TX_002_STATE_SYNC")
    print("  Log Entries Committed     : ", p1 and p2)

    let committed = raft_get_committed_entries(cluster)
    print("  Synchronized Log Length   : ", len(committed))
    print("  [✓ High-Assurance Mesh]   : Distributed state machine nominal.")
}

fn main() {
    print("================================================================================")
    print("  NINO RUNTIME SUBSYSTEMS DEMO - DATABASE, MPC, FFI & RAFT")
    print("================================================================================")
    demo_database_layer()
    demo_mpc_secret_sharing()
    demo_foreign_interop()
    demo_cluster_consensus()
    print("\n================================================================================")
    print("  ALL RUNTIME SUBSYSTEM CHECKS COMPLETED SUCCESSFULLY.")
    print("================================================================================")
}
