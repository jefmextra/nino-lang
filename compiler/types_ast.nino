    mut scope_id: int,
    parent_scope_id: int,
    mut depth: int,
    mut kind: int,
    mut head_sym: int,
    arena_depth_entry: int
}

struct SymTable {
    mut entries: [SymbolInfo],
    mut scopes: [Scope],
    mut buckets: [int],
    mut params: [ParamInfo],
    mut fields: [FieldInfo],
    mut bucket_count: int,
    mut active_count: int,
    mut next_scope_id: int,
    mut current_scope_idx: int,
    mut scope_depth: int
}

