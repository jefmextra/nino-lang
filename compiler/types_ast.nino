fn sym_table_new() -> SymTable {
    mut b: [int] = []
    for i in 0..1024 {
        let neg1_b: int = -1
        b = push(b, neg1_b)
    }
    mut sc_arr: [Scope] = []
    let g_sc = Scope { scope_id: 0, parent_scope_id: -1, depth: 0, kind: SCOPE_GLOBAL(), head_sym: -1, arena_depth_entry: 0 }
    sc_arr = push(sc_arr, g_sc)
    mut ent_arr: [SymbolInfo] = []
    mut p_arr: [ParamInfo] = []
    mut f_arr: [FieldInfo] = []
    mut tbl = SymTable {
        entries: ent_arr,
        scopes: sc_arr,
        buckets: b,
        params: p_arr,
        fields: f_arr,
        bucket_count: 1024,
        active_count: 0,
        next_scope_id: 0,
        current_scope_idx: 0,
        scope_depth: 0
    }
    sym_seed_builtins(tbl)
    return tbl
}

fn ast_pool_new() -> AstPool {
    mut nds: [AstNode] = []
    mut chs: [int] = []
    mut fls: [string] = []
    mut lns: [string] = []
    return AstPool {
        nodes: nds,
        children: chs,
        files: fls,
        lines: lns,
        root: -1,
        has_error: false,
        err_msg: "",
        err_line: 0,
        err_col: 0,
        err_file: ""
    }
}

fn ast_add_node(mut pool: AstPool, kind: int, op: string, name: string, str_val: string, type_ann: string, line: int, col: int, file_id: int, left: int, right: int, extra: int, flags: int) -> int {
    let nid = len(pool.nodes)
    let nd = AstNode {
        kind: kind, op: op, name: name, str_val: str_val, type_ann: type_ann,
        inferred_type: "", c11_type: "", line: line, col: col, file_id: file_id,
        left: left, right: right, extra: extra, child_start: 0, child_count: 0,
        flags: flags, sym_id: -1
    }
    mut narr = pool.nodes
    narr = push(narr, nd)
    pool.nodes = narr
    return nid
}

fn ast_attach_children(mut pool: AstPool, parent_id: int, kids: [int]) {
    let kc = len(kids)
    if parent_id < 0 || parent_id >= len(pool.nodes) || kc == 0 {
        return
    }
    let start_idx = len(pool.children)
    mut carr = pool.children
    for i in 0..kc {
        let kid = kids[i]
        carr = push(carr, kid)
    }
    pool.children = carr
    mut pnode: AstNode = pool.nodes[parent_id]
    pnode.child_start = start_idx
    pnode.child_count = kc
    pool.nodes[parent_id] = pnode
}

fn ast_set_error(mut pool: AstPool, msg: string, file_id: int, line: int, col: int) {
    if pool.has_error {
        return
    }
    let has_e = true
    pool.has_error = has_e
    pool.err_msg = msg
    pool.err_line = line
    pool.err_col = col
    mut fname = "source.nino"
    if file_id >= 0 && file_id < len(pool.files) {
        fname = pool.files[file_id]
    }
    pool.err_file = fname
}

fn cur_new(toks: [NinoTok]) -> TokCursor {
    let n = len(toks)
    return TokCursor { toks: toks, pos: 0, n: n, allow_struct_lit: true, pending_gt: 0 }
}

fn cur_peek(cur: TokCursor) -> NinoTok {
    if cur.pos >= cur.n {
        return NinoTok { kind: TK_EOF(), text: "", file_id: 0, line: 1, col: 1 }
    }
    return cur.toks[cur.pos]
}

fn cur_peek_at(cur: TokCursor, offset: int) -> NinoTok {
    let idx = cur.pos + offset
    if idx < 0 || idx >= cur.n {
        return NinoTok { kind: TK_EOF(), text: "", file_id: 0, line: 1, col: 1 }
    }
    return cur.toks[idx]
}

fn cur_eof(cur: TokCursor) -> bool {
    return cur_peek(cur).kind == TK_EOF()
}

fn cur_advance(mut cur: TokCursor) -> NinoTok {
    let t = cur_peek(cur)
    if cur.pos < cur.n {
        let nxt = cur.pos + 1
        cur.pos = nxt
    }
    return t
}

fn cur_skip_nl(mut cur: TokCursor) {
    while cur_peek(cur).kind == TK_NL() {
        let nxt = cur.pos + 1
        cur.pos = nxt
    }
}

fn cur_skip_nl_semi(mut cur: TokCursor) {
    mut looping = true
    while looping {
        let k = cur_peek(cur).kind
        if k == TK_NL() || k == TK_SEMI() {
            let nxt = cur.pos + 1
            cur.pos = nxt
        } else {
            looping = false
        }
    }
}

