fn f1_is_digit(ch: string) -> bool {
    if len(ch) == 0 {
        return false
    }
    let cc = char_code(ch)
    return cc >= 48 && cc <= 57
}

fn f1_is_hex_digit(ch: string) -> bool {
    if len(ch) == 0 {
        return false
    }
    let cc = char_code(ch)
    if cc >= 48 && cc <= 57 {
        return true
    }
    if cc >= 65 && cc <= 70 {
        return true
    }
    if cc >= 97 && cc <= 102 {
        return true
    }
    return ch == "_"
}

fn f1_is_ident_start(ch: string) -> bool {
    if len(ch) == 0 {
        return false
    }
    let cc = char_code(ch)
    if cc >= 65 && cc <= 90 {
        return true
    }
    if cc >= 97 && cc <= 122 {
        return true
    }
    return cc == 95
}

fn f1_is_reserved_kw(w: string) -> bool {
    if w == "fn" || w == "let" || w == "mut" || w == "sealed" || w == "morphic" || w == "struct" || w == "actor" || w == "receive" || w == "extern" || w == "import" {
        return true
    }
    if w == "return" || w == "if" || w == "else" || w == "while" || w == "for" || w == "in" || w == "break" || w == "continue" || w == "match" {
        return true
    }
    if w == "defer" || w == "guard" || w == "transact" || w == "transaction" || w == "compensate" || w == "rollback" || w == "inline_asm" || w == "comptime" || w == "abort" {
        return true
    }
    if w == "require" || w == "ensure" || w == "invariant" || w == "true" || w == "false" || w == "nil" || w == "and" || w == "or" || w == "not" {
        return true
    }
    return false
}

fn f1_is_scalar_c11(ct: string) -> bool {
    return ct == "int64_t" || ct == "int32_t" || ct == "uint32_t" || ct == "uint64_t" || ct == "uint8_t" || ct == "double" || ct == "float" || ct == "bool" || ct == "const char*" || ct == "void" || ct == "int"
}

fn f1_c11_elem_type(arr_c11: string) -> string {
    if arr_c11 == "const char**" {
        return "const char*"
    }
    if arr_c11 == "void**" || arr_c11 == "void*" || len(arr_c11) == 0 {
        return "int64_t"
    }
    if ends_with(arr_c11, "*") {
        return slice(arr_c11, 0, len(arr_c11) - 1)
    }
    return "int64_t"
}

fn f1_nino_elem_type(nt: string) -> string {
    let t = trim(nt)
    if starts_with(t, "[") && ends_with(t, "]") && len(t) >= 2 {
        return trim(slice(t, 1, len(t) - 2))
    }
    if starts_with(t, "Array<") && ends_with(t, ">") && len(t) >= 7 {
        return trim(slice(t, 6, len(t) - 7))
    }
    return ""
}

fn f1_is_arr_nino_type(nt: string) -> bool {
    let t = trim(nt)
    return (starts_with(t, "[") && ends_with(t, "]")) || (starts_with(t, "Array<") && ends_with(t, ">"))
}

fn sym_hash(name: string) -> int {
    mut h = 2166136261
    let n = len(name)
    for i in 0..n {
        let cc = char_code(char_at(name, i))
        h = ((h ^ cc) * 16777619) & 2147483647
    }
    return h
}

fn sym_info_empty() -> SymbolInfo {
    return SymbolInfo {
        name: "", kind: 0, scope_id: 0, scope_depth: 0, active: false, decl_line: 0,
        nino_type: "", c11_type: "", elem_nino_type: "", elem_c11_type: "",
        is_mut: false, is_mut_param: false, is_sealed: false, is_morphic: false, sealed_tainted: false,
        region_depth: 0, tainted_at_depth: 0, is_pinned: false, is_rolled_back: false,
        min_arity: 0, max_arity: 0, ret_nino_type: "", ret_c11_type: "",
        is_extern: false, extern_lib: "", cap_effects: "", child_start: 0, child_count: 0,
        bucket_idx: -1, next_in_bucket: -1, next_in_scope: -1
    }
}

fn sym_rehash_if_needed(mut tbl: SymTable) {
    if tbl.active_count * 4 < tbl.bucket_count * 3 {
        return
    }
    let new_bc = tbl.bucket_count * 2
    mut nb: [int] = []
    for i in 0..new_bc {
        let neg1_b: int = -1
        nb = push(nb, neg1_b)
    }
    let ec = len(tbl.entries)
    for ei in 0..ec {
        mut e: SymbolInfo = tbl.entries[ei]
        if e.active {
            let b = sym_hash(e.name) % new_bc
            e.bucket_idx = b
            let prev_head = nb[b]
            e.next_in_bucket = prev_head
            nb[b] = ei
            tbl.entries[ei] = e
        }
    }
    tbl.buckets = nb
    tbl.bucket_count = new_bc
}

fn sym_push_scope(mut tbl: SymTable, kind: int, arena_depth: int) -> int {
    let sid = tbl.next_scope_id + 1
    tbl.next_scope_id = sid
    let nd = tbl.scope_depth + 1
    tbl.scope_depth = nd
    let parent_sc: Scope = tbl.scopes[tbl.current_scope_idx]
    let pid = parent_sc.scope_id
    let sc = Scope { scope_id: sid, parent_scope_id: pid, depth: nd, kind: kind, head_sym: -1, arena_depth_entry: arena_depth }
    mut sc_arr = tbl.scopes
    sc_arr = push(sc_arr, sc)
    tbl.scopes = sc_arr
    let next_idx = len(tbl.scopes) - 1
    tbl.current_scope_idx = next_idx
    return sid
}

fn sym_pop_scope(mut tbl: SymTable) {
    if tbl.current_scope_idx <= 0 {
        return
    }
    let cur_sc: Scope = tbl.scopes[tbl.current_scope_idx]
    mut idx = cur_sc.head_sym
    while idx != -1 {
        mut e: SymbolInfo = tbl.entries[idx]
        let nxt = e.next_in_scope
        if e.bucket_idx >= 0 && e.bucket_idx < tbl.bucket_count {
            let nxt_b = e.next_in_bucket
            tbl.buckets[e.bucket_idx] = nxt_b
        }
        e.active = false
        let neg1 = -1
        e.next_in_bucket = neg1
        tbl.entries[idx] = e
        let next_ac = tbl.active_count - 1
        tbl.active_count = next_ac
        idx = nxt
    }
    mut sc_arr = tbl.scopes
    sc_arr = pop(sc_arr)
    tbl.scopes = sc_arr
    let nidx = len(tbl.scopes) - 1
    tbl.current_scope_idx = nidx
    let top_sc: Scope = tbl.scopes[nidx]
    let top_d = top_sc.depth
    tbl.scope_depth = top_d
}

fn sym_insert(mut tbl: SymTable, name: string, info: SymbolInfo) -> int {
    sym_rehash_if_needed(tbl)
    let b = sym_hash(name) % tbl.bucket_count
    mut sc: Scope = tbl.scopes[tbl.current_scope_idx]
    mut e: SymbolInfo = info
    e.name = name
    let sc_id = sc.scope_id
    let sc_d = sc.depth
    let prev_b = tbl.buckets[b]
    let prev_head = sc.head_sym
    e.scope_id = sc_id
    e.scope_depth = sc_d
    e.active = true
    e.bucket_idx = b
    e.next_in_bucket = prev_b
    e.next_in_scope = prev_head
    let sym_idx = len(tbl.entries)
    mut ent_arr = tbl.entries
    ent_arr = push(ent_arr, e)
    tbl.entries = ent_arr
    tbl.buckets[b] = sym_idx
    sc.head_sym = sym_idx
    tbl.scopes[tbl.current_scope_idx] = sc
    let next_ac = tbl.active_count + 1
    tbl.active_count = next_ac
    return sym_idx
}

fn sym_lookup(tbl: SymTable, name: string) -> int {
    if tbl.bucket_count <= 0 {
        return -1
    }
    let b = sym_hash(name) % tbl.bucket_count
    mut idx = tbl.buckets[b]
    while idx != -1 {
        let e: SymbolInfo = tbl.entries[idx]
        if e.active && e.name == name {
            return idx
        }
        idx = e.next_in_bucket
    }
    return -1
}

fn sym_lookup_current(tbl: SymTable, name: string) -> int {
    if tbl.bucket_count <= 0 {
        return -1
    }
    let cur_sc: Scope = tbl.scopes[tbl.current_scope_idx]
    let cur_sid = cur_sc.scope_id
    let cur_d = cur_sc.depth
    let b = sym_hash(name) % tbl.bucket_count
    mut idx = tbl.buckets[b]
    while idx != -1 {
        let e: SymbolInfo = tbl.entries[idx]
        if e.scope_depth < cur_d {
            return -1
        }
        if e.active && e.scope_id == cur_sid && e.name == name {
            return idx
        }
        idx = e.next_in_bucket
    }
    return -1
}

fn sym_update(mut tbl: SymTable, sym_idx: int, updated: SymbolInfo) {
    if sym_idx < 0 || sym_idx >= len(tbl.entries) {
        return
    }
    let old: SymbolInfo = tbl.entries[sym_idx]
    mut e: SymbolInfo = updated
    e.scope_id = old.scope_id
    e.scope_depth = old.scope_depth
    e.active = old.active
    e.bucket_idx = old.bucket_idx
    e.next_in_bucket = old.next_in_bucket
    e.next_in_scope = old.next_in_scope
    tbl.entries[sym_idx] = e
}

fn sym_seed_fn(mut tbl: SymTable, name: string, ret_nino: string, ret_c11: string, min_a: int, max_a: int) {
    mut info = sym_info_empty()
    info.kind = SK_FN()
    info.ret_nino_type = ret_nino
    info.ret_c11_type = ret_c11
    info.min_arity = min_a
    info.max_arity = max_a
    sym_insert(tbl, name, info)
}

fn sym_seed_mut0_fn(mut tbl: SymTable, name: string, ret_nino: string, ret_c11: string, min_a: int, max_a: int) {
    let p0 = ParamInfo { name: "arg0", nino_type: "any", c11_type: "void", is_mut: true, is_ptr_writeback: true, has_default: false }
    let p_start = len(tbl.params)
    mut parr = tbl.params
    parr = push(parr, p0)
    tbl.params = parr
    mut info = sym_info_empty()
    info.kind = SK_FN()
    info.ret_nino_type = ret_nino
    info.ret_c11_type = ret_c11
    info.min_arity = min_a
    info.max_arity = max_a
    info.is_mut_param = true
    info.child_start = p_start
    info.child_count = 1
    sym_insert(tbl, name, info)
}

