// compiler/types_ast.nino: Token/AST/Symbol/Lowerer data types, constants & symbol table
fn nir_is_small_int(raw: string) -> bool {
    let s = trim(raw)
    let n = len(s)
    if n == 0 || n > 10 {
        return false
    }
    mut i = 0
    if char_at(s, 0) == "-" {
        if n == 1 || n > 11 {
            return false
        }
        i = 1
    }
    while i < n {
        let c = char_code(char_at(s, i))
        if c < 48 || c > 57 {
            return false
        }
        i = i + 1
    }
    return true
}

fn nir_fold_const_int(expr: string, depth: int) -> string {
    if depth > 8 {
        return ""
    }
    mut ex = trim(expr)
    mut elen = len(ex)
    if elen == 0 {
        return ""
    }
    if starts_with(ex, "(") && ends_with(ex, ")") {
        mut pd = 0
        mut strip_p = true
        for i in 0..(elen - 1) {
            let ch = char_at(ex, i)
            if ch == "(" {
                pd = pd + 1
            } else if ch == ")" {
                pd = pd - 1
                if pd == 0 {
                    strip_p = false
                }
            }
        }
        if strip_p {
            return nir_fold_const_int(slice(ex, 1, elen - 2), depth + 1)
        }
    }
    if nir_is_small_int(ex) {
        return ex
    }
    let plus_p = find_top_binary_op(ex, "+")
    let minus_p = find_top_binary_op(ex, "-")
    if plus_p > 0 || minus_p > 0 {
        mut op_p = plus_p
        mut op_c = "+"
        if minus_p > op_p {
            op_p = minus_p
            op_c = "-"
        }
        let lf = nir_fold_const_int(slice(ex, 0, op_p), depth + 1)
        let rf = nir_fold_const_int(slice(ex, op_p + 1, elen - op_p - 1), depth + 1)
        if len(lf) > 0 && len(rf) > 0 && len(lf) <= 10 && len(rf) <= 10 {
            let lv = parse_int(lf)
            let rv = parse_int(rf)
            if op_c == "+" {
                return int_to_str(lv + rv)
            }
            return int_to_str(lv - rv)
        }
        return ""
    }
    let mul_p = find_top_binary_op(ex, "*")
    let div_p = find_top_binary_op(ex, "/")
    let mod_p = find_top_binary_op(ex, "%")
    if mul_p > 0 || div_p > 0 || mod_p > 0 {
        mut op_p = mul_p
        mut op_c = "*"
        if div_p > op_p {
            op_p = div_p
            op_c = "/"
        }
        if mod_p > op_p {
            op_p = mod_p
            op_c = "%"
        }
        let lf = nir_fold_const_int(slice(ex, 0, op_p), depth + 1)
        let rf = nir_fold_const_int(slice(ex, op_p + 1, elen - op_p - 1), depth + 1)
        if len(lf) > 0 && len(rf) > 0 && len(lf) <= 9 && len(rf) <= 9 {
            let lv = parse_int(lf)
            let rv = parse_int(rf)
            if op_c == "*" {
                return int_to_str(lv * rv)
            }
            if rv != 0 {
                if op_c == "/" {
                    return int_to_str(lv / rv)
                }
                return int_to_str(lv % rv)
            }
        }
    }
    return ""
}

fn nir_loop_mutates_arr(norm: string, for_pos: int, arr_id: string) -> bool {
    let nlen = len(norm)
    mut p = for_pos
    let first_nl = find_char(norm, "\n", p)
    if first_nl == -1 {
        return true
    }
    p = first_nl + 1
    mut bdepth = 1
    while p < nlen && bdepth > 0 {
        mut le = find_char(norm, "\n", p)
        if le == -1 {
            le = nlen
        }
        let ln = trim(slice(norm, p, le - p))
        bdepth = bdepth + count_braces_outside_str(ln)
        if bdepth > 0 {
            if starts_with(ln, arr_id + " =") || starts_with(ln, arr_id + "=") || find_str(ln, "arr_free(" + arr_id, 0) != -1 {
                return true
            }
        }
        p = le + 1
    }
    return false
}

