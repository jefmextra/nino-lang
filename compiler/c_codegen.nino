                return
            }
        }
        let lo_c = lower_expr(pool, nd.left, ctx)
        let hi_c = lower_expr(pool, nd.right, ctx)
        mut step_c = "1"
        if nd.extra != -1 {
            step_c = lower_expr(pool, nd.extra, ctx)
        }
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        let sc_lp = SCOPE_LOOP()
        sym_push_scope(ctx.sym, sc_lp, 0)
        mut vinfo = sym_info_empty()
        vinfo.kind = SK_VAR()
        vinfo.nino_type = "int"
        vinfo.c11_type = "int64_t"
        sym_insert(ctx.sym, nd.name, vinfo)
        let loop_d = ctx.sym.scope_depth
        if (nd.flags & NF_BCE_SAFE()) != 0 {
            let hi_nd: AstNode = pool.nodes[nd.right]
            if hi_nd.kind == NK_CALL() && hi_nd.child_count == 1 {
                let arr_id = pool.children[hi_nd.child_start]
                let arr_nd: AstNode = pool.nodes[arr_id]
                let bp = BcePair { arr_name: arr_nd.name, idx_name: nd.name, scope_depth: loop_d }
                mut barr = ctx.bce_pairs
                barr = push(barr, bp)
                ctx.bce_pairs = barr
            }
        }
        mut hdr_c = ""
        if nd.extra != -1 {
            hdr_c = "    for (int64_t _nino_hi = (int64_t)(" + hi_c + "), _nino_st = (int64_t)(" + step_c + "), " + nd.name + " = (int64_t)(" + lo_c + "); (_nino_st >= 0) ? (" + nd.name + " < _nino_hi) : (" + nd.name + " > _nino_hi); " + nd.name + " += _nino_st) " + lb + "\n"
        } else {
            hdr_c = "    for (int64_t " + nd.name + " = " + lo_c + "; " + nd.name + " < " + hi_c + "; " + nd.name + "++) " + lb + "\n"
        }
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = f1_scat(out_b, pre)
        out_b = f1_scat(out_b, hdr_c)
        ctx.body_code = out_b
        if nd.child_count >= 1 {
            let body_id = pool.children[nd.child_start]
            lower_stmt(pool, body_id, ctx, emit_ldir)
        }
        lower_pop_bce_depth(ctx, loop_d)
        sym_pop_scope(ctx.sym)
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_FOR_IN() {
        let coll_c = lower_expr(pool, nd.left, ctx)
        let c_nd: AstNode = pool.nodes[nd.left]
        let elem_c11 = f1_c11_elem_type(c_nd.c11_type)
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        let sc_lp = SCOPE_LOOP()
        sym_push_scope(ctx.sym, sc_lp, 0)
        mut vinfo = sym_info_empty()
        vinfo.kind = SK_VAR()
        vinfo.nino_type = f1_nino_elem_type(c_nd.inferred_type)
        vinfo.c11_type = elem_c11
        sym_insert(ctx.sym, nd.name, vinfo)
        let v = nd.name
        mut ptr_decl = ""
        mut item_decl = ""
        if elem_c11 == "const char*" {
            ptr_decl = "const char* const *_fl_c_" + v + " = (const char* const*)(" + coll_c + "), * const *_fl_end_" + v + " = (_fl_c_" + v + " ? (_fl_c_" + v + " + nino_len_arr(_fl_c_" + v + ")) : _fl_c_" + v + ");"
            item_decl = "const char* " + v + " = *_fl_c_" + v + ";"
        } else {
            ptr_decl = "const " + elem_c11 + " *_fl_c_" + v + " = (const " + elem_c11 + "*)(" + coll_c + "), *_fl_end_" + v + " = (_fl_c_" + v + " ? (_fl_c_" + v + " + nino_len_arr(_fl_c_" + v + ")) : _fl_c_" + v + ");"
            item_decl = "const " + elem_c11 + " " + v + " = *_fl_c_" + v + ";"
        }
        let loop_hdr = "    for (" + ptr_decl + " _fl_c_" + v + " < _fl_end_" + v + "; _fl_c_" + v + "++) " + lb + " " + item_decl + "\n"
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = f1_scat(out_b, pre)
        out_b = f1_scat(out_b, loop_hdr)
        ctx.body_code = out_b
        lower_stmt(pool, nd.right, ctx, emit_ldir)
        sym_pop_scope(ctx.sym)
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_MATCH_STMT() {
        let sc_c = lower_expr(pool, nd.left, ctx)
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = f1_scat(out_b, pre)
        out_b = out_b + "    switch (" + sc_c + ") " + lb + "\n"
        ctx.body_code = out_b
        for ci in 0..nd.child_count {
            let aid = pool.children[nd.child_start + ci]
            let and_nd: AstNode = pool.nodes[aid]
            mut lbl_c = "    case " + and_nd.name + ": " + lb + "\n"
            if and_nd.name == "_" {
                lbl_c = "    default: " + lb + "\n"
            }
            mut out_a = ctx.body_code + lbl_c
            ctx.body_code = out_a
            lower_stmt(pool, and_nd.right, ctx, emit_ldir)
            mut out_e = ctx.body_code + "    " + rb + " break;\n"
            ctx.body_code = out_e
        }
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_GUARD_STMT() {
        let cond_c = lower_expr(pool, nd.left, ctx)
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = f1_scat(out_b, pre)
        out_b = out_b + "    if (!(" + cond_c + ")) " + lb + "\n"
        ctx.body_code = out_b
        lower_stmt(pool, nd.right, ctx, emit_ldir)
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_TRANSACT_STMT() {
        let tx_seq = ctx.temp_seq
        let nxt_tx = tx_seq + 1
        ctx.temp_seq = nxt_tx
        let fnd_v = "_nino_tx_fnd_" + int_to_str(tx_seq)
        let try_hdr = "    " + lb + " int " + fnd_v + " = _nino_tx.fn_depth; if (setjmp(_nino_tx_frame_ptr(nino_tx_push_idx())->buf) == 0) " + lb + "\n"
        let else_hdr = "    nino_tx_commit(); " + rb + " else " + lb + " _nino_tx.fn_depth = " + fnd_v + "; atomic_signal_fence(memory_order_seq_cst);\n"

        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = out_b + try_hdr
        ctx.body_code = out_b
        lower_stmt(pool, nd.left, ctx, emit_ldir)
        mut out_b2 = ctx.body_code + else_hdr
        ctx.body_code = out_b2
        if nd.right != -1 {
            lower_stmt(pool, nd.right, ctx, emit_ldir)
        }
        mut out_b3 = ctx.body_code + "    " + rb + " " + rb + "\n"
        ctx.body_code = out_b3
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_INLINE_ASM() {
        let asm_hdr = "    " + lb + " atomic_signal_fence(memory_order_seq_cst);\n"

        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = out_b + asm_hdr
        ctx.body_code = out_b
        for ci in 0..nd.child_count {
            let cid = pool.children[nd.child_start + ci]
            lower_stmt(pool, cid, ctx, emit_ldir)
        }
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_RDTSC_STMT() {
        mut out_b = ctx.body_code + "    (void)cpu_get_cycles();\n"
        ctx.body_code = out_b
        return
    }
    if nd.kind == NK_CPUID_STMT() {
        mut out_b = ctx.body_code + "    (void)cpu_get_register(\"rax\");\n"
        ctx.body_code = out_b
        return
    }
    if nd.kind == NK_COMPTIME() {
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = out_b + "    " + lb + "\n"
        ctx.body_code = out_b
        lower_stmt(pool, nd.left, ctx, emit_ldir)
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_ABORT_STMT() {
        let mc = lower_expr(pool, nd.left, ctx)
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = f1_scat(out_b, pre)
        out_b = out_b + "    nino_abort(" + mc + ");\n"
        ctx.body_code = out_b
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_CONTRACT_REQ() || nd.kind == NK_CONTRACT_ENS() || nd.kind == NK_CONTRACT_INV() {
        let cc = lower_expr(pool, nd.left, ctx)
        mut mc = "\"Loop invariant violated\""
        if nd.right != -1 {
            mc = lower_expr(pool, nd.right, ctx)
        } else if nd.kind != NK_CONTRACT_INV() {
            mc = "\"Contract failed\""
        }
        mut cfn = "nino_ensure"
        if nd.kind == NK_CONTRACT_REQ() {
            cfn = "nino_require"
        }
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = f1_scat(out_b, pre)
        out_b = out_b + "    " + cfn + "(" + cc + ", " + mc + ");\n"
        ctx.body_code = out_b
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_RECEIVE_STMT() {
        let sc_blk = SCOPE_BLOCK()
        sym_push_scope(ctx.sym, sc_blk, 0)
        mut pinfo = sym_info_empty()
        pinfo.kind = SK_PARAM()
        pinfo.nino_type = "string"
        pinfo.c11_type = "const char*"
        sym_insert(ctx.sym, nd.name, pinfo)
        mut out_b = ctx.body_code + "    " + lb + " const char* " + nd.name + " = _nino_actor_msg ? _nino_actor_msg : \"\"; (void)" + nd.name + ";\n"
        ctx.body_code = out_b
        lower_stmt(pool, nd.left, ctx, emit_ldir)
        sym_pop_scope(ctx.sym)
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_EXPR_STMT() {
        let e_nd: AstNode = pool.nodes[nd.left]
        if e_nd.kind == NK_PIPE() && e_nd.right >= 0 && e_nd.right < len(pool.nodes) {
            let pr_nd: AstNode = pool.nodes[e_nd.right]
            mut is_pipe_print = false
            if pr_nd.kind == NK_IDENT() && pr_nd.name == "print" {
                is_pipe_print = true
            } else if pr_nd.kind == NK_CALL() && pr_nd.left >= 0 && pr_nd.left < len(pool.nodes) {
                let pcal: AstNode = pool.nodes[pr_nd.left]
                if pcal.kind == NK_IDENT() && pcal.name == "print" {
                    is_pipe_print = true
                }
            }
            if is_pipe_print {
                let leak_vp = lower_sealed_leak_check(pool, e_nd.left, ctx.sym)
                if len(leak_vp) > 0 {
                    print("\033[91m[Nino Security Error]\033[0m Cannot leak sealed variable '" + leak_vp + "' directly to I/O without explicit unseal() at line " + int_to_str(nd.line))
                    let snip_p = lower_diag_line_text(pool, nd.file_id, nd.line)
                    emit_rustc_style_diag(fnm, nd.line, nd.col, "E0042", "security_error", "Cannot leak sealed variable '" + leak_vp + "' directly to I/O without explicit unseal()", snip_p, len(leak_vp), "confidential memory enclaves must be explicitly unsealed with unseal(" + leak_vp + ")")
                    let err_tp = true
                    ctx.has_error = err_tp
                    return
                }
            }
        }
        if e_nd.kind == NK_CALL() && e_nd.left >= 0 && e_nd.left < len(pool.nodes) {
            let cal_nd: AstNode = pool.nodes[e_nd.left]
            if cal_nd.kind == NK_IDENT() && cal_nd.name == "print" {
                for pi in 0..e_nd.child_count {
                    let arg_id = pool.children[e_nd.child_start + pi]
                    let leak_v = lower_sealed_leak_check(pool, arg_id, ctx.sym)
                    if len(leak_v) > 0 {
                        print("\033[91m[Nino Security Error]\033[0m Cannot leak sealed variable '" + leak_v + "' directly to I/O without explicit unseal() at line " + int_to_str(nd.line))
                        let snip = lower_diag_line_text(pool, nd.file_id, nd.line)
                        emit_rustc_style_diag(fnm, nd.line, nd.col, "E0042", "security_error", "Cannot leak sealed variable '" + leak_v + "' directly to I/O without explicit unseal()", snip, len(leak_v), "confidential memory enclaves must be explicitly unsealed with unseal(" + leak_v + ")")
                        let err_t = true
                        ctx.has_error = err_t
                        return
                    }
                }
                if e_nd.child_count > 1 {
                    mut pcall = "    "
                    for pi in 0..e_nd.child_count {
                        let arg_id = pool.children[e_nd.child_start + pi]
                        let ac = lower_expr(pool, arg_id, ctx)
                        pcall = pcall + "nino_print_val(" + ac + "); "
                    }
                    pcall = pcall + "printf(\"\\n\");\n"
                    mut pre = ctx.pre_stmts
                    let empty_s = ""
                    ctx.pre_stmts = empty_s
                    mut out_b = ctx.body_code
                    if emit_ldir { out_b = f1_scat(out_b, ldir) }
                    out_b = f1_scat(out_b, pre)
                    out_b = f1_scat(out_b, pcall)
                    ctx.body_code = out_b
                    let fl_false = false
                    ctx.last_stmt_was_return = fl_false
                    return
                }
            }
        }
        if e_nd.kind == NK_CALL() && e_nd.left >= 0 && e_nd.left < len(pool.nodes) {
            let cal_nd2: AstNode = pool.nodes[e_nd.left]
            if cal_nd2.kind == NK_IDENT() && (cal_nd2.name == "arena_rollback" || cal_nd2.name == "arena_reset") {
                lower_pop_bce_depth(ctx, 0)
            }
        }
        let ec = lower_expr(pool, nd.left, ctx)
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = f1_scat(out_b, pre)
        out_b = out_b + "    " + ec + ";\n"
        ctx.body_code = out_b
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
}

fn lower_register_top_items(pool: AstPool, mut ctx: LowerCtx) {
    if pool.root < 0 {
        return
    }
    let root_nd: AstNode = pool.nodes[pool.root]
    mut known_scalar_structs = "|"
    for ci in 0..root_nd.child_count {
        let iid = pool.children[root_nd.child_start + ci]
        let nd: AstNode = pool.nodes[iid]
        if nd.kind == NK_STRUCT_DECL() {
            let f_start = len(ctx.sym.fields)
            mut farr = ctx.sym.fields
            mut all_sc = true
            for fi in 0..nd.child_count {
                let fid_n = pool.children[nd.child_start + fi]
                let fnd: AstNode = pool.nodes[fid_n]
                let f_c11 = map_type(fnd.type_ann)
                let f_mut = (fnd.flags & NF_MUT()) != 0
                let finfo = FieldInfo { name: fnd.name, nino_type: fnd.type_ann, c11_type: f_c11, is_mut: f_mut }
                farr = push(farr, finfo)
                if is_scalar_struct_field_type(fnd.type_ann) == false && find_str(known_scalar_structs, "|" + fnd.type_ann + "|", 0) == -1 {
                    all_sc = false
                }
            }
            ctx.sym.fields = farr
            mut sinfo = sym_info_empty()
            sinfo.kind = SK_STRUCT()
            sinfo.nino_type = nd.name
            sinfo.c11_type = nd.name
            sinfo.decl_line = nd.line
            sinfo.child_start = f_start
            sinfo.child_count = nd.child_count
            sym_insert(ctx.sym, nd.name, sinfo)
            if all_sc && nd.child_count > 0 && find_char(nd.name, "<", 0) == -1 {
                known_scalar_structs = known_scalar_structs + nd.name + "|"
                sym_seed_fn(ctx.sym, nd.name + "_to_json", "string", "const char*", 1, 1)
                sym_seed_fn(ctx.sym, nd.name + "_from_json", nd.name, nd.name, 1, 1)
                sym_seed_fn(ctx.sym, nd.name + "_eq", "bool", "bool", 2, 2)
            }
        } else if nd.kind == NK_EXTERN_FN() || nd.kind == NK_FN_DECL() {
            let p_start = len(ctx.sym.params)
            mut parr = ctx.sym.params
            mut has_wb = false
            mut min_a = 0
            for pi in 0..nd.child_count {
                let pid_n = pool.children[nd.child_start + pi]
                let pnd: AstNode = pool.nodes[pid_n]
                let p_c11 = map_type(pnd.type_ann)
                let p_mut = (pnd.flags & NF_MUT()) != 0
                let is_wb = p_mut && f1_is_scalar_c11(p_c11) == false && ends_with(p_c11, "*") == false
                if is_wb {
                    has_wb = true
                }
                if pnd.left == -1 {
                    min_a = min_a + 1
                }
                let pinfo = ParamInfo { name: pnd.name, nino_type: pnd.type_ann, c11_type: p_c11, is_mut: p_mut, is_ptr_writeback: is_wb, has_default: pnd.left != -1 }
                parr = push(parr, pinfo)
            }
            ctx.sym.params = parr
            mut ret_n = nd.type_ann
            mut ret_c = "void"
            if nd.name == "main" {
                ret_n = "int"
                ret_c = "int"
            } else if len(ret_n) > 0 {
                ret_c = map_type(ret_n)
            }
            mut finfo = sym_info_empty()
            if nd.kind == NK_EXTERN_FN() {
                finfo.kind = SK_EXTERN_FN()
                finfo.is_extern = true
                finfo.extern_lib = nd.str_val
            } else {
                finfo.kind = SK_FN()
            }
            finfo.ret_nino_type = ret_n
            finfo.ret_c11_type = ret_c
            finfo.is_mut_param = has_wb
            finfo.min_arity = min_a
            finfo.max_arity = nd.child_count
            finfo.child_start = p_start
            finfo.child_count = nd.child_count
            finfo.decl_line = nd.line
            sym_insert(ctx.sym, nd.name, finfo)
        } else if nd.kind == NK_ACTOR_DECL() {
            mut ainfo = sym_info_empty()
            ainfo.kind = SK_ACTOR()
            ainfo.nino_type = nd.name
            ainfo.c11_type = nd.name
            sym_insert(ctx.sym, nd.name, ainfo)
        } else if nd.kind == NK_GLOBAL_LET() {
            mut ginfo = sym_info_empty()
            ginfo.kind = SK_VAR()
            ginfo.nino_type = nd.type_ann
            if len(nd.type_ann) > 0 {
                ginfo.c11_type = map_type(nd.type_ann)
            } else {
                ginfo.c11_type = "int64_t"
            }
            ginfo.is_mut = (nd.flags & NF_MUT()) != 0
            sym_insert(ctx.sym, nd.name, ginfo)
        }
    }
    let tn = len(pool.nodes)
    for ni in 0..tn {
        let tnd: AstNode = pool.nodes[ni]
        if len(tnd.type_ann) > 0 && find_char(tnd.type_ann, "<", 0) != -1 {
            sym_register_generic_struct_one(ctx.sym, tnd.type_ann)
        }
    }
}

fn lower_synthesize_struct_methods_ast(pool: AstPool) -> string {
    if pool.root < 0 {
        return ""
    }
    let root_nd: AstNode = pool.nodes[pool.root]
    mut out = ""
    mut known_structs = "|"
    for ci in 0..root_nd.child_count {
        let iid = pool.children[root_nd.child_start + ci]
        let nd: AstNode = pool.nodes[iid]
        if nd.kind == NK_STRUCT_DECL() {
            mut fnames = ""
            mut ftypes = ""
            mut fcount = 0
            mut all_sc = true
            for fi in 0..nd.child_count {
                let fid_n = pool.children[nd.child_start + fi]
                let fnd: AstNode = pool.nodes[fid_n]
                if is_scalar_struct_field_type(fnd.type_ann) || find_str(known_structs, "|" + fnd.type_ann + "|", 0) != -1 {
                    fnames = fnames + fnd.name + "|"
                    ftypes = ftypes + fnd.type_ann + "|"
                    fcount = fcount + 1
                } else {
                    all_sc = false
                }
            }
            if all_sc && fcount > 0 {
                out = out + emit_single_struct_helpers(nd.name, fnames, ftypes, fcount)
                known_structs = known_structs + nd.name + "|"
            }
        }
    }
    return out
}

fn lower_collect_type_anns(pool: AstPool) -> string {
    mut out = ""
    let n = len(pool.nodes)
    for i in 0..n {
        let nd: AstNode = pool.nodes[i]
        if len(nd.type_ann) > 0 && find_char(nd.type_ann, "<", 0) != -1 {
            out = out + nd.type_ann + "\n"
        }
    }
    return out
}

fn lower_item(mut pool: AstPool, iid: int, mut ctx: LowerCtx) {
    if iid < 0 || iid >= len(pool.nodes) || ctx.has_error {
        return
    }
    let nd: AstNode = pool.nodes[iid]
    let lb = "{"
    let rb = "}"
    let fnm = lower_node_file_name(pool, nd.file_id)
    let ldir = "#line " + int_to_str(nd.line) + " \"" + fnm + "\"\n"
    if nd.kind == NK_NO_STD() || nd.kind == NK_IMPORT() {
        return
    }
    if nd.kind == NK_STRUCT_DECL() {
        mut sc = ldir + "typedef struct " + nd.name + " " + nd.name + ";\nstruct " + nd.name + " " + lb + "\n"
        for fi in 0..nd.child_count {
            let fid_n = pool.children[nd.child_start + fi]
            let fnd: AstNode = pool.nodes[fid_n]
            sc = sc + "    " + map_type(fnd.type_ann) + " " + fnd.name + ";\n"
        }
        sc = sc + rb + ";\n"
        mut nxt_sc = ctx.struct_code + sc
        ctx.struct_code = nxt_sc
        return
    }
    if nd.kind == NK_EXTERN_FN() {
        let low_lib = f1_ascii_lower(nd.str_val)
        if find_str(low_lib, "kernel32", 0) != -1 || find_str(low_lib, "user32", 0) != -1 || find_str(low_lib, "gdi32", 0) != -1 {
            return
        }
        mut ret_c = "void"
        if len(nd.type_ann) > 0 {
            ret_c = map_type(nd.type_ann)
        }
        mut p_c = ""
        for pi in 0..nd.child_count {
            let pid_n = pool.children[nd.child_start + pi]
            let pnd: AstNode = pool.nodes[pid_n]
            let pt_c = map_type(pnd.type_ann)
            if pi > 0 {
                p_c = p_c + ", "
            }
            p_c = p_c + pt_c + " " + pnd.name
        }
        if nd.child_count == 0 {
            p_c = "void"
        }
        mut nxt_ex = ctx.extern_code
        nxt_ex = f1_scat(nxt_ex, ldir)
        nxt_ex = f1_scat(nxt_ex, ret_c) + " " + nd.name + "(" + p_c + ");\n"
        ctx.extern_code = nxt_ex
        return
    }
    if nd.kind == NK_GLOBAL_LET() {
        let rhs_c = lower_expr(pool, nd.left, ctx)
        let r_nd: AstNode = pool.nodes[nd.left]
        mut g_c11 = ""
        if len(nd.type_ann) > 0 {
            g_c11 = map_type(nd.type_ann)
        } else {
            g_c11 = r_nd.c11_type
            if len(g_c11) == 0 {
                g_c11 = "int64_t"
            }
        }
        let sid = sym_lookup(ctx.sym, nd.name)
        if sid != -1 {
            mut se: SymbolInfo = ctx.sym.entries[sid]
            se.c11_type = g_c11
            sym_update(ctx.sym, sid, se)
        }
        let is_mut = (nd.flags & NF_MUT()) != 0
        mut gc = ""
        if is_mut || starts_with(g_c11, "const ") {
            gc = f1_scat(ldir, g_c11)
            gc = gc + " " + nd.name + " = " + rhs_c + ";\n"
        } else {
            gc = ldir + "const " + g_c11 + " " + nd.name + " = " + rhs_c + ";\n"
        }
        mut nxt_b = ctx.body_code + gc
        ctx.body_code = nxt_b
        return
    }
    if nd.kind == NK_ACTOR_DECL() {
        let act_t = true
        ctx.in_actor = act_t
        let sc_act = SCOPE_FN()
        sym_push_scope(ctx.sym, sc_act, 0)
        mut m_info = sym_info_empty()
        m_info.kind = SK_PARAM()
        m_info.nino_type = "string"
        m_info.c11_type = "const char*"
        m_info.decl_line = nd.line
        sym_insert(ctx.sym, "msg", m_info)
        mut ahdr = ldir + "typedef struct " + lb + " int _actor_id; " + rb + " " + nd.name + ";\nstatic inline const char* _nino_actor_fn_" + nd.name + "(const char* _nino_actor_msg) " + lb + "\n    const char* msg = _nino_actor_msg ? _nino_actor_msg : \"\";\n    (void)msg;\n"
        mut nxt_b = ctx.body_code + ahdr
        ctx.body_code = nxt_b
        for ri in 0..nd.child_count {
            let rid = pool.children[nd.child_start + ri]
            lower_stmt(pool, rid, ctx, true)
        }
        mut nxt_b2 = ctx.body_code + "    return nino_str_concat(\"" + nd.name + "_ACK:\", msg);\n" + rb + "\n"
        ctx.body_code = nxt_b2
        sym_pop_scope(ctx.sym)
        let act_f = false
        ctx.in_actor = act_f
        return
    }
    if nd.kind == NK_FN_DECL() {
        let fn_sid = sym_lookup(ctx.sym, nd.name)
        ctx.cur_fn_name = nd.name
        ctx.cur_fn_sym_idx = fn_sid
        let is_m = (nd.name == "main")
        ctx.is_main_fn = is_m
        if is_m {
            let hm = true
            ctx.has_main = hm
            ctx.cur_fn_ret_c11 = "int"
            ctx.cur_fn_ret_nino = "int"
        } else {
            mut rt_c = "void"
            if len(nd.type_ann) > 0 {
                rt_c = map_type(nd.type_ann)
            }
            ctx.cur_fn_ret_c11 = rt_c
            ctx.cur_fn_ret_nino = nd.type_ann
        }
        mut d_empty: [DeferItem] = []
        mut b_empty: [BcePair] = []
        ctx.defers = d_empty
        ctx.bce_pairs = b_empty
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        let sc_fn = SCOPE_FN()
        sym_push_scope(ctx.sym, sc_fn, 0)
        mut c_params = ""
        mut copy_in = ""
        for pi in 0..nd.child_count {
            let pid_n = pool.children[nd.child_start + pi]
            let pnd: AstNode = pool.nodes[pid_n]
            let p_c11 = map_type(pnd.type_ann)
            let p_mut = (pnd.flags & NF_MUT()) != 0
            let is_wb = p_mut && f1_is_scalar_c11(p_c11) == false && ends_with(p_c11, "*") == false
            if pi > 0 {
                c_params = c_params + ", "
            }
            if is_wb {
                c_params = c_params + p_c11 + "* _nino_ptr_" + pnd.name
                copy_in = copy_in + "    " + p_c11 + " " + pnd.name + " = _nino_ptr_" + pnd.name + " ? *_nino_ptr_" + pnd.name + " : (" + p_c11 + ")" + lb + "0" + rb + ";\n"
            } else {
                c_params = c_params + p_c11 + " " + pnd.name
            }
            mut pinfo = sym_info_empty()
            pinfo.kind = SK_PARAM()
            pinfo.nino_type = pnd.type_ann
            pinfo.c11_type = p_c11
            if f1_is_arr_nino_type(pnd.type_ann) {
                let en = f1_nino_elem_type(pnd.type_ann)
                pinfo.elem_nino_type = en
                pinfo.elem_c11_type = map_type(en)
            }
            pinfo.is_mut = p_mut
            pinfo.decl_line = pnd.line
            sym_insert(ctx.sym, pnd.name, pinfo)
        }
        if nd.child_count == 0 {
            c_params = "void"
        }
        mut fn_hdr = ""
        if is_m {
            if ctx.is_no_std {
                fn_hdr = ldir + "int main(void) " + lb + "\n"
            } else {
                fn_hdr = ldir + "int main(int argc, char** argv) " + lb + "\n    nino_init_args(argc, argv);\n" + ctx.actor_inits + "    const nino_fn_scope_t _nino_fn_tx_sc = nino_tx_fn_enter();\n"
            }
        } else {
            fn_hdr = f1_scat(ldir, ctx.cur_fn_ret_c11)
            fn_hdr = fn_hdr + " " + nd.name + "(" + c_params + ") " + lb + "\n" + copy_in
            if ctx.is_no_std == false {
                fn_hdr = fn_hdr + "    const nino_fn_scope_t _nino_fn_tx_sc = nino_tx_fn_enter();\n"
            }
        }
        mut nxt_b = ctx.body_code + fn_hdr
        ctx.body_code = nxt_b
        if nd.left != -1 {
            let bnd: AstNode = pool.nodes[nd.left]
            if bnd.kind == NK_BLOCK() {
                for si in 0..bnd.child_count {
                    let sid = pool.children[bnd.child_start + si]
                    lower_stmt(pool, sid, ctx, true)
                }
            } else {
                lower_stmt(pool, nd.left, ctx, true)
            }
        }
        if ctx.last_stmt_was_return == false {
            let cleanup = lower_emit_cleanup(ctx)
            mut full_cleanup = cleanup
            if ctx.is_no_std == false {
                full_cleanup = full_cleanup + "    nino_tx_fn_leave(_nino_fn_tx_sc);\n"
            }
            if len(full_cleanup) > 0 {
                mut nxt_c = ctx.body_code + full_cleanup
                ctx.body_code = nxt_c
            }
            if is_m {
                mut nxt_r = ctx.body_code + "    return 0;\n"
                ctx.body_code = nxt_r
            }
        }
        mut nxt_end = ctx.body_code + rb + "\n"
        ctx.body_code = nxt_end
        sym_pop_scope(ctx.sym)
        ctx.defers = d_empty
        ctx.bce_pairs = b_empty
        let neg1 = -1
        ctx.cur_fn_sym_idx = neg1
        ctx.is_main_fn = fl_false
        return
    }
    lower_stmt(pool, iid, ctx, true)
}

fn get_nostd_runtime_header() -> string {
    let lb = "{"
    let rb = "}"
    mut h = "#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n#include <iso646.h>\n\n"
    h = h + "static char _nino_ns_heap[65536];\nstatic size_t _nino_ns_off = 0;\n"
    h = h + "static inline void* _nino_ns_alloc(size_t n) " + lb + " size_t a = (n + 7U) & ~7U; if (a == 0) a = 8; if (_nino_ns_off + a > sizeof(_nino_ns_heap)) _nino_ns_off = 0; void* p = &_nino_ns_heap[_nino_ns_off]; _nino_ns_off += a; return p; " + rb + "\n"
    h = h + "static inline int64_t nino_len_str(const void* s) " + lb + " if (!s) return 0; const char* p = (const char*)s; int64_t n = 0; while (p[n]) n++; return n; " + rb + "\n"
    h = h + "static inline int64_t nino_str_len(const char* s) " + lb + " return nino_len_str(s); " + rb + "\n"
    h = h + "static inline bool nino_str_eq(const char* a, const char* b) " + lb + " if (a == b) return true; if (!a || !b) return false; while (*a && *b && *a == *b) " + lb + " a++; b++; " + rb + " return *a == *b; " + rb + "\n"
    h = h + "static inline char* nino_str_concat(const char* a, const char* b) " + lb + " if (!a) a = \"\"; if (!b) b = \"\"; int64_t la = nino_len_str(a), lb0 = nino_len_str(b); char* r = (char*)_nino_ns_alloc((size_t)(la + lb0 + 1)); for (int64_t i = 0; i < la; i++) r[i] = a[i]; for (int64_t i = 0; i < lb0; i++) r[la + i] = b[i]; r[la + lb0] = 0; return r; " + rb + "\n"
    h = h + "static inline char* nino_str_concat_int(const char* a, int64_t v) " + lb + " char buf[32]; int i = 0; uint64_t uv = (v < 0) ? (uint64_t)(-(v + 1)) + 1ULL : (uint64_t)v; char tmp[32]; int ti = 0; if (uv == 0) tmp[ti++] = \'0\'; while (uv > 0) " + lb + " tmp[ti++] = (char)(\'0\' + (uv % 10ULL)); uv /= 10ULL; " + rb + " if (v < 0) buf[i++] = \'-\'; while (ti > 0) buf[i++] = tmp[--ti]; buf[i] = 0; return nino_str_concat(a, buf); " + rb + "\n"
    h = h + "#define nino_auto_concat(A, B) _Generic((B), char*: nino_str_concat, const char*: nino_str_concat, default: nino_str_concat_int)((A), (B))\n"
    h = h + "#define len(X) nino_len_str((X))\n"
    h = h + "static inline void outb(uint16_t port, uint8_t val) " + lb + "\n#if defined(__x86_64__) || defined(__i386__)\n    __asm__ volatile(\"outb %0, %1\" : : \"a\"(val), \"Nd\"(port));\n#else\n    (void)port; (void)val;\n#endif\n" + rb + "\n"
    h = h + "static inline uint8_t inb(uint16_t port) " + lb + "\n#if defined(__x86_64__) || defined(__i386__)\n    uint8_t r; __asm__ volatile(\"inb %1, %0\" : \"=a\"(r) : \"Nd\"(port)); return r;\n#else\n    (void)port; return 0;\n#endif\n" + rb + "\n"
    h = h + "static inline void hlt(void) " + lb + "\n#if defined(__x86_64__) || defined(__i386__)\n    __asm__ volatile(\"hlt\");\n#endif\n" + rb + "\n"
    h = h + "static inline void write_vga(int64_t row, int64_t col, const char* s, int64_t clr) " + lb + " if (!s || row < 0 || row >= 25 || col < 0 || col >= 80) return;\n#if defined(__x86_64__) || defined(__i386__)\n    volatile uint16_t* vga = (volatile uint16_t*)(uintptr_t)0xB8000;\n    int64_t off = row * 80 + col;\n    for (int64_t i = 0; s[i] && off + i < 2000; i++) vga[off + i] = (uint16_t)(((uint16_t)(clr & 0xFF) << 8) | (uint8_t)s[i]);\n#else\n    (void)clr;\n#endif\n" + rb + "\n"
    h = h + "static inline void nino_panic(const char* m) " + lb + " (void)m; for(;;) hlt(); " + rb + "\n"
    h = h + "static inline void nino_require(bool c, const char* m) " + lb + " if (!c) nino_panic(m); " + rb + "\n"
    h = h + "static inline void nino_ensure(bool c, const char* m) " + lb + " if (!c) nino_panic(m); " + rb + "\n"
    h = h + "#define nino_print(X) ((void)(X))\n#define print(X) ((void)(X))\n#define panic(M) nino_panic(M)\n"
    h = h + "static inline int64_t nino_div(int64_t a, int64_t b, int line) " + lb + " (void)line; if (b == 0) nino_panic(\"div0\"); return a / b; " + rb + "\n"
    h = h + "static inline void nino_tx_checkpoint(void* a, size_t s) " + lb + " (void)a; (void)s; " + rb + "\n"
    h = h + "static inline void nino_tx_checkpoint_local(void* a, size_t s) " + lb + " (void)a; (void)s; " + rb + "\n"
    return h
}

fn lower_program_to_c(mut pool: AstPool, file_name: string, pcc_code: string, strict_c11: bool) -> string {
    if pool.has_error {
        emit_rustc_style_diag(pool.err_file, pool.err_line, pool.err_col, "E0001", "syntax_error", pool.err_msg, lower_diag_line_text(pool, 0, pool.err_line), 1, "fix syntax error before compilation")
        return ""
    }
    mut norm_fn = replace_str(file_name, "\\", "/")
    if len(norm_fn) == 0 {
        norm_fn = "source.nino"
    }
    let st = sym_table_new()
    mut d_init: [DeferItem] = []
    mut b_init: [BcePair] = []
    mut ctx = LowerCtx {
        sym: st,
        norm_fname: norm_fn,
        strict_c11: strict_c11,
        struct_code: "",
        extern_code: "",
        body_code: "",
        pre_stmts: "",
        cur_fn_name: "",
        cur_fn_ret_nino: "void",
        cur_fn_ret_c11: "void",
        cur_fn_sym_idx: -1,
        is_main_fn: false,
        in_actor: false,
        has_main: false,
        has_error: false,
        temp_seq: 0,
        defers: d_init,
        bce_pairs: b_init,
        last_stmt_was_return: false,
        is_no_std: false,
        actor_inits: ""
    }
    if pool.root >= 0 {
        let r0: AstNode = pool.nodes[pool.root]
        mut ns_f = false
        mut act_reg_s = ""
        mut act_fwd_s = ""
        for ci0 in 0..r0.child_count {
            let iid0 = pool.children[r0.child_start + ci0]
            let nd0: AstNode = pool.nodes[iid0]
            if nd0.kind == NK_NO_STD() {
                ns_f = true
            } else if nd0.kind == NK_ACTOR_DECL() && len(nd0.name) > 0 {
                act_fwd_s = act_fwd_s + "static inline const char* _nino_actor_fn_" + nd0.name + "(const char* _nino_actor_msg);\n"
                act_reg_s = act_reg_s + "    _nino_actor_register(\"" + nd0.name + "\", _nino_actor_fn_" + nd0.name + ");\n"
            }
        }
        ctx.is_no_std = ns_f
        ctx.extern_code = act_fwd_s
        ctx.actor_inits = act_reg_s
    }
    lower_register_top_items(pool, ctx)
    if pool.root >= 0 {
        let root_nd: AstNode = pool.nodes[pool.root]
        mut body_acc = ""
        mut body_mid = ""
        for ci in 0..root_nd.child_count {
            let iid = pool.children[root_nd.child_start + ci]
            lower_item(pool, iid, ctx)
            if ctx.has_error {
                return ""
            }
            if ci % 16 == 0 {
                body_mid = body_mid + ctx.body_code
                let empty_s = ""
                ctx.body_code = empty_s
                if ci % 128 == 0 {
                    body_acc = body_acc + body_mid
                    body_mid = ""
                }
            }
        }
        let final_body = body_acc + body_mid + ctx.body_code
        ctx.body_code = final_body
    }
    let struct_methods = lower_synthesize_struct_methods_ast(pool)
    let type_anns_str = lower_collect_type_anns(pool)
    let mono_decls = monomorphize_generics(type_anns_str)
    let rt_hdr = ctx.is_no_std ? get_nostd_runtime_header() : get_runtime_header()
    mut full_code = pcc_code + rt_hdr + ctx.struct_code + ctx.extern_code + struct_methods + mono_decls + ctx.body_code
    if ctx.has_main == false && ctx.is_no_std == false && find_str(pcc_code, "NINO_SHARED_LIB", 0) == -1 {
        let lb = "{"
        let rb = "}"
        full_code = full_code + "\nint main(int argc, char** argv) " + lb + "\n    nino_init_args(argc, argv);\n" + ctx.actor_inits + "    return 0;\n" + rb + "\n"
    }
    return full_code
}

fn transpile_to_c_full(source: string, base_dir: string, file_name: string, pcc_code: string, strict_c11: bool, opt_nir: bool) -> string {
    mut pool = ast_parse_unit(source, base_dir, file_name)
    if opt_nir {
        nir_optimize_ast(pool)
    }
    return lower_program_to_c(pool, file_name, pcc_code, strict_c11)
}

fn transpile_to_c_pcc(source: string, base_dir: string, file_name: string, pcc_code: string) -> string {
    return transpile_to_c_full(source, base_dir, file_name, pcc_code, false, true)
}

fn transpile_to_c_named(source: string, base_dir: string, file_name: string) -> string {
    return transpile_to_c_pcc(source, base_dir, file_name, "")
}

fn transpile_to_c(source: string, base_dir: string) -> string {
    return transpile_to_c_pcc(source, base_dir, "source.nino", "")
}

fn emit_native_c_full(source_code: string, output_c_path: string, base_dir: string, pcc_code: string, strict_c11: bool) -> int {
    require(len(source_code) > 0, "Source code must be valid")
    mut src_name = "source.nino"
    if ends_with(output_c_path, ".c") {
        src_name = slice(output_c_path, 0, len(output_c_path) - 2)
    }
    let c_code = transpile_to_c_full(source_code, base_dir, src_name, pcc_code, strict_c11, true)
    if len(c_code) == 0 {
        return 0
    }
    let written = write_file(output_c_path, c_code)
    require(written > 0, "C emission must write non-zero bytes")
    return written
}

fn emit_native_c_pcc(source_code: string, output_c_path: string, base_dir: string, pcc_code: string) -> int {
    return emit_native_c_full(source_code, output_c_path, base_dir, pcc_code, false)
}

fn emit_native_c(source_code: string, output_c_path: string, base_dir: string) -> int {
    return emit_native_c_pcc(source_code, output_c_path, base_dir, "")
}

fn cli_quote_path(p: string) -> string {
    if len(p) == 0 {
        return p
    }
    if find_char(p, " ", 0) != -1 && starts_with(p, "\"") == false {
        return "\"" + p + "\""
    }
    return p
}

fn get_system_gcc() -> string {
    let env_nino_gcc = get_env("NINO_GCC")
    if len(env_nino_gcc) > 0 && file_exists(env_nino_gcc) {
        return cli_quote_path(env_nino_gcc)
    }
    let env_nino_cc = get_env("NINO_CC")
    if len(env_nino_cc) > 0 && file_exists(env_nino_cc) {
        return cli_quote_path(env_nino_cc)
    }
    let env_cc = get_env("CC")
    if len(env_cc) > 0 && file_exists(env_cc) {
        return cli_quote_path(env_cc)
    }
    if exec_cmd("gcc --version " + null_redir()) == 0 {
        return "gcc"
    }
    if is_host_windows() {
        if file_exists("C:\\MinGW\\bin\\gcc.exe") {
            return "C:\\MinGW\\bin\\gcc.exe"
        }
        if file_exists("C:\\msys64\\mingw64\\bin\\gcc.exe") {
            return "C:\\msys64\\mingw64\\bin\\gcc.exe"
        }
        if file_exists("C:\\msys64\\ucrt64\\bin\\gcc.exe") {
            return "C:\\msys64\\ucrt64\\bin\\gcc.exe"
        }
        let lapp = get_env("LOCALAPPDATA")
        if len(lapp) > 0 {
            let clion_gcc = lapp + "\\Programs\\CLion\\bin\\mingw\\bin\\gcc.exe"
            if file_exists(clion_gcc) {
                return cli_quote_path(clion_gcc)
            }
        }
    }
    return "gcc"
}

fn get_system_clang() -> string {
    let env_nino_clang = get_env("NINO_CLANG")
    if len(env_nino_clang) > 0 && file_exists(env_nino_clang) {
        return cli_quote_path(env_nino_clang)
    }
    let env_clang = get_env("CLANG")
    if len(env_clang) > 0 && file_exists(env_clang) {
        return cli_quote_path(env_clang)
    }
    if exec_cmd("clang --version " + null_redir()) == 0 {
        return "clang"
    }
    if is_host_windows() {
        let pfiles = get_env("ProgramFiles")
        if len(pfiles) > 0 {
            let sys_clang = pfiles + "\\LLVM\\bin\\clang.exe"
            if file_exists(sys_clang) {
                return cli_quote_path(sys_clang)
            }
        }
    }
    return "clang"
}

fn verify_syntax_balance(source: string) -> bool {
    let slen = len(source)
    mut p_depth = 0
    mut b_depth = 0
    mut br_depth = 0
    mut in_q = false
    mut in_lcmt = false
    mut in_bcmt = false
    mut line_no = 1
    mut i = 0
    while i < slen {
        let ch = char_at(source, i)
        if in_bcmt {
            if ch == "\n" {
                line_no = line_no + 1
            } else if ch == "*" && i + 1 < slen && char_at(source, i + 1) == "/" {
                in_bcmt = false
                i = i + 2
                continue
            }
            i = i + 1
            continue
        }
        if ch == "\n" {
            line_no = line_no + 1
            in_lcmt = false
        } else if in_lcmt {
            line_no = line_no
        } else if !in_q && ch == "/" && i + 1 < slen && char_at(source, i + 1) == "/" {
            in_lcmt = true
            i = i + 2
            continue
        } else if !in_q && ch == "/" && i + 1 < slen && char_at(source, i + 1) == "*" {
            in_bcmt = true
            i = i + 2
            continue
        } else if ch == "\"" {
            mut bcount = 0
            mut bj = i - 1
            while bj >= 0 && char_at(source, bj) == "\\" {
                bcount = bcount + 1
                bj = bj - 1
            }
            if bcount % 2 == 0 {
                in_q = !in_q
            }
        } else if !in_q {
            if ch == "(" {
                p_depth = p_depth + 1
            } else if ch == ")" {
                p_depth = p_depth - 1
                if p_depth < 0 {
                    print("\033[91m[Nino Syntax Error]\033[0m Unexpected ')' at line " + line_no)
                    return false
                }
            } else if ch == "{" {
                b_depth = b_depth + 1
            } else if ch == "}" {
                b_depth = b_depth - 1
                if b_depth < 0 {
                    print("\033[91m[Nino Syntax Error]\033[0m Unexpected '}' at line " + line_no)
                    return false
                }
            } else if ch == "[" {
                br_depth = br_depth + 1
            } else if ch == "]" {
                br_depth = br_depth - 1
                if br_depth < 0 {
                    print("\033[91m[Nino Syntax Error]\033[0m Unexpected ']' at line " + line_no)
                    return false
                }
            }
        }
        i = i + 1
    }
    if in_bcmt {
        print("\033[91m[Nino Syntax Error]\033[0m Unclosed '/*' block comment in source file")
        return false
    }
    if p_depth != 0 {
        print("\033[91m[Nino Syntax Error]\033[0m Unclosed '(' in source file")
        return false
    }
    if b_depth != 0 {
        print("\033[91m[Nino Syntax Error]\033[0m Unclosed '{' in source file")
        return false
    }
    if br_depth != 0 {
        print("\033[91m[Nino Syntax Error]\033[0m Unclosed '[' in source file")
        return false
    }
    return true
}

fn lex_count_tokens(source: string) -> int {
    let slen = len(source)
    mut pos = 0
    mut count = 0
    while pos < slen {
        let ch = char_at(source, pos)
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            pos = pos + 1
        } else if ch == "/" && pos + 1 < slen && char_at(source, pos + 1) == "/" {
            while pos < slen && char_at(source, pos) != "\n" {
                pos = pos + 1
            }
        } else if ch == "/" && pos + 1 < slen && char_at(source, pos + 1) == "*" {
            pos = pos + 2
            while pos + 1 < slen && !(char_at(source, pos) == "*" && char_at(source, pos + 1) == "/") {
                pos = pos + 1
            }
            if pos + 1 < slen { pos = pos + 2 } else { pos = slen }
        } else if ch == "\"" {
            count = count + 1
            pos = pos + 1
            mut in_str = true
            while pos < slen && in_str {
                let sc = char_at(source, pos)
                let is_esc = (sc == "\\")
                if is_esc {
                    if (pos + 1) < slen {
                        pos = pos + 2
                    } else {
                        pos = pos + 1
                    }
                } else if sc == "\"" {
                    pos = pos + 1
                    in_str = false
                } else {
                    pos = pos + 1
                }
            }
        } else if is_alpha_num(ch) || ch == "_" {
            count = count + 1
            while pos < slen && (is_alpha_num(char_at(source, pos)) || char_at(source, pos) == "_") {
                pos = pos + 1
            }
        } else {
            count = count + 1
            if (pos + 1) < slen {
                let op2 = slice(source, pos, 2)
                if op2 == "==" || op2 == "!=" || op2 == "<=" || op2 == ">=" || op2 == "&&" || op2 == "||" || op2 == "<<" || op2 == ">>" || op2 == "->" || op2 == ".." || op2 == "|>" || op2 == "=>" {
                    pos = pos + 1
                }
            }
            pos = pos + 1
        }
    }
    return count
}

fn is_nino_keyword(word: string) -> bool {
    if word == "fn" || word == "let" || word == "mut" || word == "if" || word == "else" {
        return true
    }
    if word == "while" || word == "for" || word == "in" || word == "return" || word == "struct" {
        return true
    }
    if word == "match" || word == "require" || word == "ensure" || word == "sealed" || word == "unseal" {
        return true
    }
    if word == "true" || word == "false" || word == "int" || word == "string" || word == "bool" || word == "float" || word == "void" {
        return true
    }
    return false
}

fn lex_dump_tokens(source: string, max_tokens: int) -> int {
    let slen = len(source)
    mut pos = 0
    mut count = 0
    while pos < slen && count < max_tokens {
        let ch = char_at(source, pos)
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
            pos = pos + 1
        } else if ch == "/" && pos + 1 < slen && char_at(source, pos + 1) == "/" {
            while pos < slen && char_at(source, pos) != "\n" {
                pos = pos + 1
            }
        } else if ch == "\"" {
            let start = pos
            pos = pos + 1
            mut in_str = true
            while pos < slen && in_str {
                let sc = char_at(source, pos)
                let is_esc = (sc == "\\")
                if is_esc {
                    if (pos + 1) < slen {
                        pos = pos + 2
                    } else {
                        pos = pos + 1
                    }
                } else if sc == "\"" {
                    pos = pos + 1
                    in_str = false
                } else {
                    pos = pos + 1
                }
            }
            let tok_str = slice(source, start, pos - start)
            count = count + 1
            print("    [Token #" + count + "] TYPE: STRING_LITERAL | VALUE: " + tok_str)
        } else if is_alpha_num(ch) || ch == "_" {
            let start = pos
            while pos < slen && (is_alpha_num(char_at(source, pos)) || char_at(source, pos) == "_") {
                pos = pos + 1
            }
            let word = slice(source, start, pos - start)
            count = count + 1
            if is_nino_keyword(word) {
                print("    [Token #" + count + "] TYPE: KEYWORD        | VALUE: '" + word + "'")
            } else if find_char("0123456789", char_at(word, 0), 0) != -1 {
                print("    [Token #" + count + "] TYPE: NUMBER_LITERAL  | VALUE: " + word)
            } else {
                print("    [Token #" + count + "] TYPE: IDENTIFIER      | VALUE: '" + word + "'")
            }
        } else {
            mut op_len = 1
            if (pos + 1) < slen {
                let op2 = slice(source, pos, 2)
                if op2 == "==" || op2 == "!=" || op2 == "<=" || op2 == ">=" || op2 == "&&" || op2 == "||" || op2 == "<<" || op2 == ">>" || op2 == "->" || op2 == ".." || op2 == "=>" {
                    op_len = 2
                }
            }
            let sym = slice(source, pos, op_len)
            pos = pos + op_len
            count = count + 1
            if op_len == 2 || sym == "+" || sym == "-" || sym == "*" || sym == "/" || sym == "%" || sym == "=" || sym == "<" || sym == ">" || sym == "!" {
                print("    [Token #" + count + "] TYPE: OPERATOR        | VALUE: '" + sym + "'")
            } else {
                print("    [Token #" + count + "] TYPE: DELIMITER       | VALUE: '" + sym + "'")
            }
        }
    }
    return count
}

fn generate_api_doc(source: string, file_path: string) -> string {
    let clean = replace_str(source, "\r\n", "\n")
    let slen = len(clean)
    mut pos = 0
    mut doc = "# API Documentation: `" + file_path + "`\n\n"
    mut in_fn = false
    mut fn_sig = ""
    mut fn_doc = ""
    mut doc_buf = ""
    mut req_list = ""
    mut ens_list = ""
    
    while pos < slen {
        mut line_end = pos
        mut searching = true
        while line_end < slen && searching {
            let ch = char_at(clean, line_end)
            if ch == "\n" {
                searching = false
            } else {
                line_end = line_end + 1
            }
        }
        let line = trim(slice(clean, pos, line_end - pos))
        if starts_with(line, "///") && in_fn == false {
            let dtxt = trim(slice(line, 3, len(line) - 3))
            if len(dtxt) > 0 {
                doc_buf = doc_buf + dtxt + "\n"
            }
        } else if starts_with(line, "struct ") && find_char(line, "{", 0) != -1 {
            let s_ob = find_char(line, "{", 0)
            let s_name = trim(slice(line, 7, s_ob - 7))
            doc = doc + "### `struct " + s_name + "`\n"
            if len(doc_buf) > 0 {
                doc = doc + doc_buf
            }
            doc = doc + "\n"
            doc_buf = ""
        } else if starts_with(line, "fn ") && find_char(line, "{", 0) != -1 {
            if in_fn {
                doc = doc + "### `fn " + fn_sig + "`\n"
                if len(fn_doc) > 0 {
                    doc = doc + fn_doc
                }
                if len(req_list) > 0 {
                    doc = doc + "  - **Preconditions (`require`)**:\n" + req_list
                }
                if len(ens_list) > 0 {
                    doc = doc + "  - **Postconditions (`ensure`)**:\n" + ens_list
                }
                doc = doc + "\n"
            }
            let f_ob = find_char(line, "{", 0)
            fn_sig = trim(slice(line, 3, f_ob - 3))
            fn_doc = doc_buf
            doc_buf = ""
            req_list = ""
            ens_list = ""
            in_fn = true
        } else if in_fn {
            if starts_with(line, "require(") && ends_with(line, ")") {
                let req_arg = slice(line, 8, len(line) - 9)
                req_list = req_list + "    - `" + req_arg + "`\n"
            } else if starts_with(line, "ensure(") && ends_with(line, ")") {
                let ens_arg = slice(line, 7, len(line) - 8)
                ens_list = ens_list + "    - `" + ens_arg + "`\n"
            } else if line == "}" {
                doc = doc + "### `fn " + fn_sig + "`\n"
                if len(fn_doc) > 0 {
                    doc = doc + fn_doc
                }
                if len(req_list) > 0 {
                    doc = doc + "  - **Preconditions (`require`)**:\n" + req_list
                }
                if len(ens_list) > 0 {
                    doc = doc + "  - **Postconditions (`ensure`)**:\n" + ens_list
                }
                doc = doc + "\n"
                fn_doc = ""
                in_fn = false
            }
        } else if starts_with(line, "@") == false && len(line) > 0 {
            doc_buf = ""
        }
        pos = line_end + 1
    }
    if in_fn {
        doc = doc + "### `fn " + fn_sig + "`\n"
        if len(fn_doc) > 0 {
            doc = doc + fn_doc
        }
        if len(req_list) > 0 {
            doc = doc + "  - **Preconditions (`require`)**:\n" + req_list
        }
        if len(ens_list) > 0 {
            doc = doc + "  - **Postconditions (`ensure`)**:\n" + ens_list
        }
        doc = doc + "\n"
    }
    return doc
}

fn parse_program_ast(source: string) -> int {
    let pool = ast_parse_unit_ex(source, ".", "source.nino", false)
    let n = len(pool.nodes)
    if n < 1 {
        return 1
    }
    return n
}

fn ast_render_tree(source: string) -> string {
    let pool = ast_parse_unit_ex(source, ".", "source.nino", false)
    return ast_render_from_pool(pool)
}

fn sem_norm_type(t_raw: string) -> string {
    let t = trim(t_raw)
    if t == "int" || t == "i64" || t == "i32" || t == "u32" || t == "u64" || t == "byte" || t == "u8" || t == "usize" {
        return "int"
    }
    if t == "float" || t == "f64" || t == "f32" {
        return "float"
    }
    if t == "bool" {
        return "bool"
    }
    if t == "string" || t == "str" {
        return "string"
    }
    if t == "void" {
        return "void"
    }
    if starts_with(t, "[") || starts_with(t, "Array<") {
        return "array"
    }
    return ""
}

fn sem_tok_in_expr(expr: string, tok: string) -> bool {
    let elen = len(expr)
    let tlen = len(tok)
    if elen == 0 || tlen == 0 {
        return false
    }
    mut in_q = false
    mut i = 0
    while i < elen {
        let ch = char_at(expr, i)
        if ch == "\"" {
            mut bc = 0
            mut bj = i - 1
            while bj >= 0 && char_at(expr, bj) == "\\" {
                bc = bc + 1
                bj = bj - 1
            }
            if bc % 2 == 0 {
                in_q = !in_q
            }
            i = i + 1
        } else if in_q {
            i = i + 1
        } else if i + tlen <= elen && slice(expr, i, tlen) == tok {
            mut prev_ok = (i == 0)
            if prev_ok == false {
                let pc = char_at(expr, i - 1)
                prev_ok = (is_alpha_num(pc) == false && pc != "_")
            }
            mut next_ok = (i + tlen == elen)
            if next_ok == false {
                let nc = char_at(expr, i + tlen)
                next_ok = (is_alpha_num(nc) == false && nc != "_")
            }
            if prev_ok && next_ok {
                return true
            }
            i = i + 1
        } else {
            i = i + 1
        }
    }
    return false
}

fn sem_scrub_unseal(expr: string, sv: string) -> string {
    return replace_str(expr, "unseal(" + sv + ")", "")
}

fn sem_extract_interp_eval(p_arg: string) -> string {
    mut leak_eval = ""
    mut l_inq = false
    mut l_inb = 0
    mut l_idx = 0
    let l_plen = len(p_arg)
    while l_idx < l_plen {
        let l_ch = char_at(p_arg, l_idx)
        if l_ch == "\\" {
            l_idx = l_idx + 2
        } else {
            if l_ch == "\"" {
                l_inq = !l_inq
                leak_eval = leak_eval + " "
            } else if l_inq == false {
                leak_eval = leak_eval + l_ch
            } else if l_ch == "{" {
                l_inb = l_inb + 1
            } else if l_ch == "}" && l_inb > 0 {
                l_inb = l_inb - 1
                leak_eval = leak_eval + " "
            } else if l_inb > 0 {
                leak_eval = leak_eval + l_ch
            }
            l_idx = l_idx + 1
        }
    }
    return leak_eval
}

fn sem_infer_expr(ex_raw: string, var_types: string, fn_sigs: string) -> string {
    let ex = trim(ex_raw)
    let elen = len(ex)
    if elen == 0 {
        return ""
    }
    if ex == "true" || ex == "false" {
        return "bool"
    }
    if starts_with(ex, "\"") && ends_with(ex, "\"") && find_char(slice(ex, 1, elen - 2), "\"", 0) == -1 {
        return "string"
    }
    if starts_with(ex, "[") && ends_with(ex, "]") {
        return "array"
    }
    if nir_is_small_int(ex) {
        return "int"
    }
    if find_char(ex, ".", 0) != -1 && find_char(ex, "(", 0) == -1 && find_char(ex, "\"", 0) == -1 && find_char(ex, " ", 0) == -1 {
        let dc = char_code(char_at(ex, 0))
        if (dc >= 48 && dc <= 57) || dc == 45 {
            return "float"
        }
    }
    if find_top_binary_op(ex, "==") != -1 || find_top_binary_op(ex, "!=") != -1 || find_top_binary_op(ex, "<=") != -1 || find_top_binary_op(ex, ">=") != -1 || find_top_binary_op(ex, "<") != -1 || find_top_binary_op(ex, ">") != -1 || find_top_binary_op(ex, "&&") != -1 || find_top_binary_op(ex, "||") != -1 || starts_with(ex, "!") {
        return "bool"
    }
    if is_valid_identifier(ex) {
        return c11_sub_get_type(var_types, ex)
    }
    let op_p = find_char(ex, "(", 0)
    if op_p != -1 && ends_with(ex, ")") && sem_is_single_call(ex, op_p) {
        let fnm = trim(slice(ex, 0, op_p))
        if is_valid_identifier(fnm) {
            if fnm == "len" || fnm == "parse_int" || fnm == "char_code" || fnm == "argc" || fnm == "find_str" || fnm == "find_char" || fnm == "exec_cmd" || fnm == "actor_inbox_len" {
                return "int"
            }
            if fnm == "int_to_str" || fnm == "trim" || fnm == "slice" || fnm == "char_at" || fnm == "read_file" || fnm == "file_read" || fnm == "sha256" || fnm == "sha512" || fnm == "ed25519_keygen" || fnm == "ed25519_keygen_seed" || fnm == "ed25519_pubkey_from_sk" || fnm == "ed25519_sign" || fnm == "region_pin" || fnm == "unseal" || fnm == "db_driver_mode" {
                return "string"
            }
            if fnm == "file_exists" || fnm == "file_delete" || fnm == "str_contains" || fnm == "str_starts_with" || fnm == "str_ends_with" || fnm == "is_windows" || fnm == "seal_is_locked" || fnm == "ed25519_verify" || fnm == "is_nan" || fnm == "is_inf" || fnm == "is_finite" {
                return "bool"
            }
            if fnm == "fp_abs" || fnm == "fp_sqrt" || fnm == "to_float" || fnm == "math_ln" {
                return "float"
            }
            let fkey = "|" + fnm + ":"
            let fpos = find_str(fn_sigs, fkey, 0)
            if fpos != -1 {
                let s = fpos + len(fkey)
                let c1 = find_char(fn_sigs, ":", s)
                let c2 = find_char(fn_sigs, ":", c1 + 1)
                let bar = find_char(fn_sigs, "|", c2 + 1)
                if c1 != -1 && c2 != -1 && bar != -1 {
                    let rt = slice(fn_sigs, c2 + 1, bar - c2 - 1)
                    if rt != "void" {
                        return rt
                    }
                }
            }
        }
    }
    return ""
}

fn sem_types_incompatible(expected: string, actual: string) -> bool {
    if len(expected) == 0 || len(actual) == 0 {
        return false
    }
    if expected == actual {
        return false
    }
    if expected == "float" && actual == "int" {
        return false
    }
    return true
}

fn sem_count_call_args(inner_raw: string) -> int {
    let inn = trim(inner_raw)
    let ilen = len(inn)
    if ilen == 0 {
        return 0
    }
    mut cnt = 1
    mut pd = 0
    mut bd = 0
    mut brd = 0
    mut in_q = false
    for i in 0..ilen {
        let ch = char_at(inn, i)
        if ch == "\"" {
            mut bc = 0
            mut bj = i - 1
            while bj >= 0 && char_at(inn, bj) == "\\" {
                bc = bc + 1
                bj = bj - 1
            }
            if bc % 2 == 0 {
                in_q = !in_q
            }
        } else if in_q == false {
            if ch == "(" {
                pd = pd + 1
            } else if ch == ")" {
                pd = pd - 1
            } else if ch == "{" {
                bd = bd + 1
            } else if ch == "}" {
                bd = bd - 1
            } else if ch == "[" {
                brd = brd + 1
            } else if ch == "]" {
                brd = brd - 1
            } else if ch == "," && pd == 0 && bd == 0 && brd == 0 {
                cnt = cnt + 1
            }
        }
    }
    return cnt
}

fn sem_check_direct_call_arity(ex_raw: string, fn_sigs: string, file_name: string, line_no: int, line_src: string) -> bool {
    let ex = trim(ex_raw)
    let op = find_char(ex, "(", 0)
    if op != -1 && ends_with(ex, ")") && sem_is_single_call(ex, op) {
        let fnm = trim(slice(ex, 0, op))
        if is_valid_identifier(fnm) {
            let fkey = "|" + fnm + ":"
            let fpos = find_str(fn_sigs, fkey, 0)
            if fpos != -1 {
                let s = fpos + len(fkey)
                let c1 = find_char(fn_sigs, ":", s)
                let c2 = find_char(fn_sigs, ":", c1 + 1)
                let bar = find_char(fn_sigs, "|", c2 + 1)
                if c1 != -1 && c2 != -1 && bar != -1 {
                    let min_a = parse_int(slice(fn_sigs, s, c1 - s))
                    let max_a = parse_int(slice(fn_sigs, c1 + 1, c2 - c1 - 1))
                    let inner = slice(ex, op + 1, len(ex) - op - 2)
                    let passed = sem_count_call_args(inner)
                    if passed < min_a || passed > max_a {
                        emit_rustc_style_diag(file_name, line_no, 1, "E0061", "type_error", "Function '" + fnm + "' expects " + int_to_str(min_a) + " argument(s), found " + int_to_str(passed), line_src, len(fnm), "adjust argument count to match function signature")
                        return false
                    }
                }
            }
        }
    }
    return true
}

fn sem_pipe_add(tbl: string, name: string) -> string {
    if len(name) == 0 {
        return tbl
    }
    if find_str(tbl, "|" + name + "|", 0) != -1 {
        return tbl
    }
    return tbl + name + "|"
}

fn sem_pipe_remove(tbl: string, name: string) -> string {
    if len(name) == 0 {
        return tbl
    }
    return replace_str(tbl, "|" + name + "|", "|")
}

fn sem_expr_taints_with_sealed(expr: string, sealed_vars: string) -> string {
    let tx = trim(expr)
    if starts_with(tx, "zk_") || starts_with(tx, "zkp_") || starts_with(tx, "sha256(") || starts_with(tx, "sha512(") || starts_with(tx, "hmac_sha256(") || starts_with(tx, "ed25519_sign(") || starts_with(tx, "enclave_attest(") || starts_with(tx, "len(") {
        return ""
    }
    let eval_part = sem_extract_interp_eval(expr)
    mut s_scan = 1
    let s_len = len(sealed_vars)
    while s_scan < s_len {
        let nb = find_char(sealed_vars, "|", s_scan)
        if nb == -1 {
            s_scan = s_len
        } else {
            let sv = slice(sealed_vars, s_scan, nb - s_scan)
            let scrubbed = sem_scrub_unseal(eval_part, sv)
            if len(sv) > 0 && sem_tok_in_expr(scrubbed, sv) {
                return sv
            }
            s_scan = nb + 1
        }
    }
    return ""
}

