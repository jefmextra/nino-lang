            sym_push_scope(ctx.sym, sc_blk, 0)
            lower_stmt(pool, nd.right, ctx, emit_ldir)
            sym_pop_scope(ctx.sym)
        }
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        if nd.extra != -1 {
            mut out_b3 = ctx.body_code + "    else " + lb + "\n"
            ctx.body_code = out_b3
            let el_nd: AstNode = pool.nodes[nd.extra]
            if el_nd.kind == NK_BLOCK() {
                lower_stmt(pool, nd.extra, ctx, emit_ldir)
            } else {
                let sc_blk2 = SCOPE_BLOCK()
                sym_push_scope(ctx.sym, sc_blk2, 0)
                lower_stmt(pool, nd.extra, ctx, emit_ldir)
                sym_pop_scope(ctx.sym)
            }
            mut out_b4 = ctx.body_code + "    " + rb + "\n"
            ctx.body_code = out_b4
        }
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_WHILE_STMT() {
        let cond_c = lower_expr(pool, nd.left, ctx)
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut out_b = ctx.body_code
        if emit_ldir { out_b = f1_scat(out_b, ldir) }
        out_b = f1_scat(out_b, pre)
        out_b = out_b + "    while (" + cond_c + ") " + lb + "\n"
        ctx.body_code = out_b
        let sc_lp = SCOPE_LOOP()
        sym_push_scope(ctx.sym, sc_lp, 0)
        lower_stmt(pool, nd.right, ctx, emit_ldir)
        sym_pop_scope(ctx.sym)
        mut out_b2 = ctx.body_code + "    " + rb + "\n"
        ctx.body_code = out_b2
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_FOR_RANGE() {
