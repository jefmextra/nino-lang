// compiler/c_codegen.nino: Single-pass AST-to-ISO-C11 lowering, toolchain discovery & syntax balance
fn lower_expr(mut pool: AstPool, nid: int, mut ctx: LowerCtx) -> string {
    if nid < 0 || nid >= len(pool.nodes) {
        return ""
    }
    let nd: AstNode = pool.nodes[nid]
    let lb = "{"
    let rb = "}"
    if nd.kind == NK_INT_LIT() {
        lower_set_node_types(pool, nid, "int", "int64_t")
        return nd.str_val
    }
    if nd.kind == NK_FLOAT_LIT() {
        lower_set_node_types(pool, nid, "float", "double")
        return nd.str_val
    }
    if nd.kind == NK_BOOL_LIT() {
        lower_set_node_types(pool, nid, "bool", "bool")
        return nd.str_val
    }
    if nd.kind == NK_NIL_LIT() {
        lower_set_node_types(pool, nid, "any", "void*")
        return "nil"
    }
    if nd.kind == NK_STR_LIT() {
        lower_set_node_types(pool, nid, "string", "const char*")
        return nd.str_val
    }
    if nd.kind == NK_STR_INTERP() {
        lower_set_node_types(pool, nid, "string", "const char*")
        if nd.child_count == 0 {
            return "\"\""
        }
        let c0_id = pool.children[nd.child_start]
        mut acc = lower_expr(pool, c0_id, ctx)
        let c0_nd: AstNode = pool.nodes[c0_id]
        mut acc_is_str = (c0_nd.c11_type == "const char*")
        if nd.child_count == 1 {
            if acc_is_str {
                return acc
            }
            return "nino_auto_concat(\"\", " + acc + ")"
        }
        for ci in 1..nd.child_count {
            let cid = pool.children[nd.child_start + ci]
            let rc = lower_expr(pool, cid, ctx)
            let cnd: AstNode = pool.nodes[cid]
            let r_is_str = (cnd.c11_type == "const char*")
            if acc_is_str && r_is_str {
                acc = "nino_str_concat(" + acc + ", " + rc + ")"
            } else if acc_is_str && r_is_str == false {
                acc = "nino_auto_concat(" + acc + ", " + rc + ")"
            } else if acc_is_str == false && r_is_str {
                acc = "nino_auto_concat_r(" + acc + ", " + rc + ")"
            } else {
                acc = "nino_auto_concat(nino_auto_concat(\"\", " + acc + "), " + rc + ")"
            }
            acc_is_str = true
        }
        return acc
    }
    if nd.kind == NK_IDENT() {
        let sid = sym_lookup(ctx.sym, nd.name)
        if sid != -1 {
            let e: SymbolInfo = ctx.sym.entries[sid]
            lower_set_node_types(pool, nid, e.nino_type, e.c11_type)
            if e.is_sealed && e.c11_type != "const char*" && e.c11_type != "void*" {
                return "unseal_i64(" + nd.name + ")"
            }
            if e.is_morphic {
                return "nino_morphic_read(&" + nd.name + ")"
            }
        }
        return nd.name
    }
    if nd.kind == NK_UNARY_OP() {
        let lc = lower_expr(pool, nd.left, ctx)
        let lnd: AstNode = pool.nodes[nd.left]
        if nd.op == "!" || nd.op == "not" {
            lower_set_node_types(pool, nid, "bool", "bool")
            return "(!" + lc + ")"
        }
        if nd.op == "&" {
            lower_set_node_types(pool, nid, "any", lnd.c11_type + "*")
            return "(&" + lc + ")"
        }
        lower_set_node_types(pool, nid, lnd.inferred_type, lnd.c11_type)
        return "(" + nd.op + lc + ")"
    }
    if nd.kind == NK_TERNARY() {
        let cc = lower_expr(pool, nd.left, ctx)
        let tc = lower_expr(pool, nd.right, ctx)
        let ec = lower_expr(pool, nd.extra, ctx)
        let tnd: AstNode = pool.nodes[nd.right]
        let end_nd: AstNode = pool.nodes[nd.extra]
        mut res_c11 = tnd.c11_type
        mut res_nt = tnd.inferred_type
        if tnd.c11_type == "const char*" || end_nd.c11_type == "const char*" {
            res_c11 = "const char*"
            res_nt = "string"
        }
        lower_set_node_types(pool, nid, res_nt, res_c11)
        return "(" + cc + " ? " + tc + " : " + ec + ")"
    }
    if nd.kind == NK_BIN_OP() {
        let lc = lower_expr(pool, nd.left, ctx)
        let rc = lower_expr(pool, nd.right, ctx)
        let lnd: AstNode = pool.nodes[nd.left]
        let rnd: AstNode = pool.nodes[nd.right]
        let lt = lnd.c11_type
        let rt = rnd.c11_type
        let is_l_str = (lt == "const char*")
        let is_r_str = (rt == "const char*")
        if nd.op == "||" || nd.op == "or" {
            lower_set_node_types(pool, nid, "bool", "bool")
            return "(" + lc + " || " + rc + ")"
        }
        if nd.op == "&&" || nd.op == "and" {
            lower_set_node_types(pool, nid, "bool", "bool")
            return "(" + lc + " && " + rc + ")"
        }
        if nd.op == "==" {
            lower_set_node_types(pool, nid, "bool", "bool")
            if is_l_str || is_r_str {
                return "nino_str_eq(" + lc + ", " + rc + ")"
            }
            return "(" + lc + " == " + rc + ")"
        }
        if nd.op == "!=" {
            lower_set_node_types(pool, nid, "bool", "bool")
            if is_l_str || is_r_str {
                return "(!nino_str_eq(" + lc + ", " + rc + "))"
            }
            return "(" + lc + " != " + rc + ")"
        }
        if nd.op == "+" {
            if is_l_str && is_r_str {
                lower_set_node_types(pool, nid, "string", "const char*")
                return "nino_str_concat(" + lc + ", " + rc + ")"
            }
            if is_l_str && is_r_str == false {
                lower_set_node_types(pool, nid, "string", "const char*")
                return "nino_auto_concat(" + lc + ", " + rc + ")"
            }
            if is_l_str == false && is_r_str {
                lower_set_node_types(pool, nid, "string", "const char*")
                return "nino_auto_concat_r(" + lc + ", " + rc + ")"
            }
            if lt == "double" || rt == "double" {
                lower_set_node_types(pool, nid, "float", "double")
            } else {
                lower_set_node_types(pool, nid, "int", "int64_t")
            }
            return "(" + lc + " + " + rc + ")"
        }
        if nd.op == "<" || nd.op == "<=" || nd.op == ">" || nd.op == ">=" {
            lower_set_node_types(pool, nid, "bool", "bool")
            return "(" + lc + " " + nd.op + " " + rc + ")"
        }
        if nd.op == "-" || nd.op == "*" || nd.op == "/" || nd.op == "%" {
            if lt == "double" || rt == "double" {
                lower_set_node_types(pool, nid, "float", "double")
            } else {
                lower_set_node_types(pool, nid, "int", "int64_t")
            }
            return "(" + lc + " " + nd.op + " " + rc + ")"
        }
        lower_set_node_types(pool, nid, "int", "int64_t")
        return "(" + lc + " " + nd.op + " " + rc + ")"
    }
    if nd.kind == NK_ARRAY_LIT() {
        if nd.child_count == 0 {
            lower_set_node_types(pool, nid, "[any]", "void*")
            return "_nino_alloc_arr(256)"
        }
        mut items_c = ""
        mut elem_c11 = ""
        mut elem_nt = ""
        for ci in 0..nd.child_count {
            let cid = pool.children[nd.child_start + ci]
            let ec = lower_expr(pool, cid, ctx)
            if ci == 0 {
                let cnd: AstNode = pool.nodes[cid]
                elem_c11 = cnd.c11_type
                elem_nt = cnd.inferred_type
            }
            if ci > 0 {
                items_c = items_c + ", "
            }
            items_c = items_c + ec
        }
        if len(elem_c11) == 0 {
            elem_c11 = "int64_t"
            elem_nt = "int"
        }
        lower_set_node_types(pool, nid, "[" + elem_nt + "]", elem_c11 + "*")
        mut arr_cast = "(const " + elem_c11 + "[])"
        if starts_with(elem_c11, "const ") {
            arr_cast = "(" + elem_c11 + "[])"
        }
        return "_nino_make_arr(" + int_to_str(nd.child_count) + ", sizeof(" + elem_c11 + "), " + arr_cast + lb + " " + items_c + " " + rb + ")"
    }
    if nd.kind == NK_DICT_LIT() {
        lower_set_node_types(pool, nid, "dict", "NinoDict*")
        if nd.child_count == 0 {
            return "nino_dict_create()"
        }
        mut d_expr = "nino_dict_create()"
        for ci in 0..nd.child_count {
            let eid = pool.children[nd.child_start + ci]
            let ent: AstNode = pool.nodes[eid]
            let kc = lower_expr(pool, ent.left, ctx)
            let vc = lower_expr(pool, ent.right, ctx)
            d_expr = "nino_dict_chain(" + d_expr + ", " + kc + ", " + vc + ")"
        }
        return d_expr
    }
    if nd.kind == NK_STRUCT_LIT() {
        let ct = map_type(nd.name)
        lower_set_node_types(pool, nid, nd.name, ct)
        if nd.child_count == 0 {
            return "(" + ct + ")" + lb + "0" + rb
        }
        mut f_c = ""
        for ci in 0..nd.child_count {
            let fid_n = pool.children[nd.child_start + ci]
            let fnd: AstNode = pool.nodes[fid_n]
            let vc = lower_expr(pool, fnd.left, ctx)
            if ci > 0 {
                f_c = f_c + ", "
            }
            f_c = f_c + "." + fnd.name + " = " + vc
        }
        return "(" + ct + ")" + lb + " " + f_c + " " + rb
    }
    if nd.kind == NK_MEMBER() {
        let obj_c = lower_expr(pool, nd.left, ctx)
        let obj_nd: AstNode = pool.nodes[nd.left]
        let fnt = lower_resolve_member_nino_type(ctx.sym, obj_nd.c11_type, nd.name)
        let ft = lower_resolve_member_type(ctx.sym, obj_nd.c11_type, nd.name)
        lower_set_node_types(pool, nid, fnt, ft)
        return obj_c + "." + nd.name
    }
    if nd.kind == NK_INDEX() {
        let tgt_c = lower_expr(pool, nd.left, ctx)
        let idx_c = lower_expr(pool, nd.right, ctx)
        let t_nd: AstNode = pool.nodes[nd.left]
        let i_nd: AstNode = pool.nodes[nd.right]
        if i_nd.c11_type == "const char*" || t_nd.c11_type == "NinoDict*" {
            lower_set_node_types(pool, nid, "string", "const char*")
            return "nino_dict_get(" + tgt_c + ", " + idx_c + ")"
        }
        let elem_c11 = f1_c11_elem_type(t_nd.c11_type)
        lower_set_node_types(pool, nid, f1_nino_elem_type(t_nd.inferred_type), elem_c11)
        if t_nd.kind == NK_IDENT() && i_nd.kind == NK_IDENT() && lower_has_bce_pair(ctx, t_nd.name, i_nd.name) {
            return "((" + tgt_c + ")[" + idx_c + "])"
        }
        return "((" + elem_c11 + "*)nino_bounds_check((void*)(" + tgt_c + "), (int64_t)(" + idx_c + ")))[" + idx_c + "]"
    }
    if nd.kind == NK_CALL() || nd.kind == NK_PIPE() {
        mut fn_name = ""
        mut arg_ids: [int] = []
        if nd.kind == NK_PIPE() {
            arg_ids = push(arg_ids, nd.left)
            let rhs_nd: AstNode = pool.nodes[nd.right]
            if rhs_nd.kind == NK_CALL() {
                let cal_nd: AstNode = pool.nodes[rhs_nd.left]
                fn_name = cal_nd.name
                for ci in 0..rhs_nd.child_count {
                    let cid = pool.children[rhs_nd.child_start + ci]
                    arg_ids = push(arg_ids, cid)
                }
            } else if rhs_nd.kind == NK_IDENT() {
                fn_name = rhs_nd.name
            }
        } else {
            let cal_nd: AstNode = pool.nodes[nd.left]
            fn_name = cal_nd.name
            for ci in 0..nd.child_count {
                let cid = pool.children[nd.child_start + ci]
                arg_ids = push(arg_ids, cid)
            }
        }
        let acnt = len(arg_ids)
        if fn_name == "len" && acnt == 1 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            lower_set_node_types(pool, nid, "int", "int64_t")
            return "nino_len(" + a0 + ")"
        }
        if fn_name == "argc" && acnt == 0 {
            lower_set_node_types(pool, nid, "int", "int64_t")
            return "nino_get_argc()"
        }
        if fn_name == "unseal" && acnt == 1 {
            let a0_nd: AstNode = pool.nodes[arg_ids[0]]
            if a0_nd.kind == NK_IDENT() {
                let sid = sym_lookup(ctx.sym, a0_nd.name)
                if sid != -1 {
                    let se: SymbolInfo = ctx.sym.entries[sid]
                    if se.is_sealed && se.c11_type != "const char*" && se.c11_type != "void*" {
                        lower_set_node_types(pool, nid, se.nino_type, se.c11_type)
                        return "unseal_i64(" + a0_nd.name + ")"
                    }
                }
            }
        }
        if fn_name == "argv" && acnt == 1 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            lower_set_node_types(pool, nid, "string", "const char*")
            return "nino_get_arg(" + a0 + ")"
        }
        if fn_name == "char_code" && acnt == 1 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            lower_set_node_types(pool, nid, "int", "int64_t")
            return "nino_char_code(" + a0 + ")"
        }
        if fn_name == "read_file" && acnt == 1 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            lower_set_node_types(pool, nid, "string", "const char*")
            return "nino_read_file(" + a0 + ")"
        }
        if fn_name == "file_exists" && acnt == 1 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            lower_set_node_types(pool, nid, "bool", "bool")
            return "nino_file_exists(" + a0 + ")"
        }
        if fn_name == "file_delete" && acnt == 1 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            lower_set_node_types(pool, nid, "bool", "bool")
            return "nino_file_delete(" + a0 + ")"
        }
        if fn_name == "exec_cmd" && acnt == 1 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            lower_set_node_types(pool, nid, "int", "int64_t")
            return "nino_exec_cmd(" + a0 + ")"
        }
        if fn_name == "char_at" && acnt == 2 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            let a1 = lower_expr(pool, arg_ids[1], ctx)
            lower_set_node_types(pool, nid, "string", "const char*")
            return "nino_str_char_at(" + a0 + ", " + a1 + ")"
        }
        if fn_name == "slice" && acnt == 3 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            let a1 = lower_expr(pool, arg_ids[1], ctx)
            let a2 = lower_expr(pool, arg_ids[2], ctx)
            lower_set_node_types(pool, nid, "string", "const char*")
            return "nino_str_slice(" + a0 + ", " + a1 + ", " + a2 + ")"
        }
        if fn_name == "write_file" && acnt == 2 {
            let a0 = lower_expr(pool, arg_ids[0], ctx)
            let a1 = lower_expr(pool, arg_ids[1], ctx)
            lower_set_node_types(pool, nid, "int", "int64_t")
            return "nino_write_file(" + a0 + ", " + a1 + ")"
        }
        if fn_name == "print" {
            lower_set_node_types(pool, nid, "void", "void")
            if acnt == 0 {
                return "printf(\"\\n\")"
            }
            if acnt == 1 {
                let a0 = lower_expr(pool, arg_ids[0], ctx)
                return "nino_print(" + a0 + ")"
            }
            mut p_expr = ""
            for pi in 0..acnt {
                let ap = lower_expr(pool, arg_ids[pi], ctx)
                p_expr = p_expr + "nino_print_val(" + ap + "), "
            }
            return "(" + p_expr + "printf(\"\\n\"))"
        }
        if fn_name == "push" && acnt == 2 {
            let a0_c = lower_expr(pool, arg_ids[0], ctx)
            let a1_c = lower_expr(pool, arg_ids[1], ctx)
            let a0_nd: AstNode = pool.nodes[arg_ids[0]]
            let a1_nd: AstNode = pool.nodes[arg_ids[1]]
            mut elem_c11 = a1_nd.c11_type
            if len(elem_c11) == 0 {
                elem_c11 = f1_c11_elem_type(a0_nd.c11_type)
            }
            mut res_t = a0_nd.c11_type
            if len(res_t) == 0 || res_t == "void*" {
                res_t = elem_c11 + "*"
            }
            mut res_nt = a0_nd.inferred_type
            if len(res_nt) == 0 && len(a1_nd.inferred_type) > 0 {
                res_nt = "[" + a1_nd.inferred_type + "]"
            }
            lower_set_node_types(pool, nid, res_nt, res_t)
            let seq = ctx.temp_seq
            let next_seq = seq + 1
            ctx.temp_seq = next_seq
            let sfx = int_to_str(seq)
            let vname = "_nino_pv_" + sfx
            let rname = "_nino_pr_" + sfx
            let s1 = "    " + elem_c11 + " " + vname + " = (" + a1_c + ");\n"
            let s2 = "    " + res_t + " " + rname + " = (" + res_t + ")_nino_push_impl((void*)(" + a0_c + "), (const void*)&" + vname + ", sizeof(" + elem_c11 + "), sizeof(" + elem_c11 + "));\n"
            mut nxt_pre = ctx.pre_stmts
            nxt_pre = m1_scat(nxt_pre, s1)
            nxt_pre = m1_scat(nxt_pre, s2)
            ctx.pre_stmts = nxt_pre
            return rname
        }
        if fn_name == "arr_map" && acnt == 2 {
            let arr_c = lower_expr(pool, arg_ids[0], ctx)
            let arr_nd: AstNode = pool.nodes[arg_ids[0]]
            let src_elem_c11 = f1_c11_elem_type(arr_nd.c11_type)
            let src_elem_nt = f1_nino_elem_type(arr_nd.inferred_type)
            let lam_nd: AstNode = pool.nodes[arg_ids[1]]
            if lam_nd.kind == NK_LAMBDA() && lam_nd.child_count >= 1 {
                let p_nd: AstNode = pool.nodes[pool.children[lam_nd.child_start]]
                let vname = p_nd.name
                let saved_pre = ctx.pre_stmts
                let empty_pre = ""
                ctx.pre_stmts = empty_pre
                let sc_blk = SCOPE_BLOCK()
                sym_push_scope(ctx.sym, sc_blk, 0)
                mut pinfo = sym_info_empty()
                pinfo.kind = SK_PARAM()
                pinfo.nino_type = src_elem_nt
                pinfo.c11_type = src_elem_c11
                sym_insert(ctx.sym, vname, pinfo)
                let body_c = lower_expr(pool, lam_nd.left, ctx)
                let body_pre = ctx.pre_stmts
                let b_nd: AstNode = pool.nodes[lam_nd.left]
                mut out_elem = b_nd.c11_type
                if len(out_elem) == 0 {
                    out_elem = "int64_t"
                }
                mut out_nt = b_nd.inferred_type
                if len(out_nt) == 0 {
                    out_nt = "int"
                }
                sym_pop_scope(ctx.sym)
                let seq = ctx.temp_seq
                let next_seq = seq + 1
                ctx.temp_seq = next_seq
                let sfx = int_to_str(seq)
                let res_var = "_nino_map_" + sfx
                mut loop_c = "    const " + src_elem_c11 + "* _msrc_" + sfx + " = (const " + src_elem_c11 + "*)(" + arr_c + ");\n"
                loop_c = loop_c + "    int64_t _mn_" + sfx + " = nino_len_arr(_msrc_" + sfx + ");\n"
                loop_c = loop_c + "    void* _mout_" + sfx + " = _nino_alloc_arr((size_t)(_mn_" + sfx + " > 0 ? _mn_" + sfx + " : 1) * sizeof(" + out_elem + "));\n"
                loop_c = loop_c + "    for (int64_t _mi_" + sfx + " = 0; _mi_" + sfx + " < _mn_" + sfx + "; _mi_" + sfx + "++) " + lb + "\n"
                loop_c = loop_c + "        " + src_elem_c11 + " " + vname + " = _msrc_" + sfx + "[_mi_" + sfx + "];\n"
                loop_c = m1_scat(loop_c, body_pre)
                loop_c = loop_c + "        " + out_elem + " _mv_" + sfx + " = (" + body_c + ");\n"
                loop_c = loop_c + "        _mout_" + sfx + " = _nino_push_impl(_mout_" + sfx + ", &_mv_" + sfx + ", sizeof(" + out_elem + "), sizeof(" + out_elem + "));\n"
                loop_c = loop_c + "    " + rb + "\n"
                loop_c = loop_c + "    " + out_elem + "* " + res_var + " = (" + out_elem + "*)_mout_" + sfx + ";\n"
                ctx.pre_stmts = m1_scat(saved_pre, loop_c)
                lower_set_node_types(pool, nid, "[" + out_nt + "]", out_elem + "*")
                return res_var
            }
        }
        if fn_name == "arr_filter" && acnt == 2 {
            let arr_c = lower_expr(pool, arg_ids[0], ctx)
            let arr_nd: AstNode = pool.nodes[arg_ids[0]]
            let src_elem_c11 = f1_c11_elem_type(arr_nd.c11_type)
            let src_elem_nt = f1_nino_elem_type(arr_nd.inferred_type)
            let lam_nd: AstNode = pool.nodes[arg_ids[1]]
            if lam_nd.kind == NK_LAMBDA() && lam_nd.child_count >= 1 {
                let p_nd: AstNode = pool.nodes[pool.children[lam_nd.child_start]]
                let vname = p_nd.name
                let saved_pre = ctx.pre_stmts
                let empty_pre = ""
                ctx.pre_stmts = empty_pre
                let sc_blk = SCOPE_BLOCK()
                sym_push_scope(ctx.sym, sc_blk, 0)
                mut pinfo = sym_info_empty()
                pinfo.kind = SK_PARAM()
                pinfo.nino_type = src_elem_nt
                pinfo.c11_type = src_elem_c11
                sym_insert(ctx.sym, vname, pinfo)
                let cond_c = lower_expr(pool, lam_nd.left, ctx)
                let body_pre = ctx.pre_stmts
                sym_pop_scope(ctx.sym)
                let seq = ctx.temp_seq
                let next_seq = seq + 1
                ctx.temp_seq = next_seq
                let sfx = int_to_str(seq)
                let res_var = "_nino_flt_" + sfx
                mut loop_c = "    const " + src_elem_c11 + "* _fsrc_" + sfx + " = (const " + src_elem_c11 + "*)(" + arr_c + ");\n"
                loop_c = loop_c + "    int64_t _fn_" + sfx + " = nino_len_arr(_fsrc_" + sfx + ");\n"
                loop_c = loop_c + "    void* _fout_" + sfx + " = _nino_alloc_arr((size_t)(_fn_" + sfx + " > 0 ? _fn_" + sfx + " : 1) * sizeof(" + src_elem_c11 + "));\n"
                loop_c = loop_c + "    for (int64_t _fi_" + sfx + " = 0; _fi_" + sfx + " < _fn_" + sfx + "; _fi_" + sfx + "++) " + lb + "\n"
                loop_c = loop_c + "        " + src_elem_c11 + " " + vname + " = _fsrc_" + sfx + "[_fi_" + sfx + "];\n"
                loop_c = m1_scat(loop_c, body_pre)
                loop_c = loop_c + "        if (" + cond_c + ") " + lb + " _fout_" + sfx + " = _nino_push_impl(_fout_" + sfx + ", &" + vname + ", sizeof(" + src_elem_c11 + "), sizeof(" + src_elem_c11 + ")); " + rb + "\n"
                loop_c = loop_c + "    " + rb + "\n"
                loop_c = loop_c + "    " + src_elem_c11 + "* " + res_var + " = (" + src_elem_c11 + "*)_fout_" + sfx + ";\n"
                ctx.pre_stmts = m1_scat(saved_pre, loop_c)
                lower_set_node_types(pool, nid, arr_nd.inferred_type, src_elem_c11 + "*")
                return res_var
            }
        }
        if fn_name == "arr_reduce" && acnt == 3 {
            let arr_c = lower_expr(pool, arg_ids[0], ctx)
            let arr_nd: AstNode = pool.nodes[arg_ids[0]]
            let src_elem_c11 = f1_c11_elem_type(arr_nd.c11_type)
            let src_elem_nt = f1_nino_elem_type(arr_nd.inferred_type)
            let init_c = lower_expr(pool, arg_ids[1], ctx)
            let init_nd: AstNode = pool.nodes[arg_ids[1]]
            mut acc_c11 = init_nd.c11_type
            if len(acc_c11) == 0 {
                acc_c11 = "int64_t"
            }
            let lam_nd: AstNode = pool.nodes[arg_ids[2]]
            if lam_nd.kind == NK_LAMBDA() && lam_nd.child_count >= 2 {
                let p0_nd: AstNode = pool.nodes[pool.children[lam_nd.child_start]]
                let p1_nd: AstNode = pool.nodes[pool.children[lam_nd.child_start + 1]]
                let acc_v = p0_nd.name
                let elem_v = p1_nd.name
                let saved_pre = ctx.pre_stmts
                let empty_pre = ""
                ctx.pre_stmts = empty_pre
                let sc_blk = SCOPE_BLOCK()
                sym_push_scope(ctx.sym, sc_blk, 0)
                mut p0info = sym_info_empty()
                p0info.kind = SK_PARAM()
                p0info.nino_type = init_nd.inferred_type
                p0info.c11_type = acc_c11
                sym_insert(ctx.sym, acc_v, p0info)
                mut p1info = sym_info_empty()
                p1info.kind = SK_PARAM()
                p1info.nino_type = src_elem_nt
                p1info.c11_type = src_elem_c11
                sym_insert(ctx.sym, elem_v, p1info)
                let body_c = lower_expr(pool, lam_nd.left, ctx)
                let body_pre = ctx.pre_stmts
                sym_pop_scope(ctx.sym)
                let seq = ctx.temp_seq
                let next_seq = seq + 1
                ctx.temp_seq = next_seq
                let sfx = int_to_str(seq)
                let res_var = "_nino_red_" + sfx
                mut loop_c = "    const " + src_elem_c11 + "* _rsrc_" + sfx + " = (const " + src_elem_c11 + "*)(" + arr_c + ");\n"
                loop_c = loop_c + "    int64_t _rn_" + sfx + " = nino_len_arr(_rsrc_" + sfx + ");\n"
                loop_c = loop_c + "    " + acc_c11 + " " + res_var + " = (" + init_c + ");\n"
                loop_c = loop_c + "    for (int64_t _ri_" + sfx + " = 0; _ri_" + sfx + " < _rn_" + sfx + "; _ri_" + sfx + "++) " + lb + "\n"
                loop_c = loop_c + "        " + acc_c11 + " " + acc_v + " = " + res_var + ";\n"
                loop_c = loop_c + "        " + src_elem_c11 + " " + elem_v + " = _rsrc_" + sfx + "[_ri_" + sfx + "];\n"
                loop_c = m1_scat(loop_c, body_pre)
                loop_c = loop_c + "        " + res_var + " = (" + body_c + ");\n"
                loop_c = loop_c + "    " + rb + "\n"
                ctx.pre_stmts = m1_scat(saved_pre, loop_c)
                lower_set_node_types(pool, nid, init_nd.inferred_type, acc_c11)
                return res_var
            }
        }
        let fn_sid = sym_lookup(ctx.sym, fn_name)
        mut args_c = ""
        for ai in 0..acnt {
            mut ac = lower_expr(pool, arg_ids[ai], ctx)
            if fn_sid != -1 {
                let f_e: SymbolInfo = ctx.sym.entries[fn_sid]
                if ai < f_e.child_count {
                    let pi: ParamInfo = ctx.sym.params[f_e.child_start + ai]
                    if pi.is_ptr_writeback {
                        ac = "&(" + ac + ")"
                    }
                }
            }
            if ai > 0 {
                args_c = args_c + ", "
            }
            args_c = args_c + ac
        }
        if fn_name == "push" && acnt >= 2 {
            let a0_nd: AstNode = pool.nodes[arg_ids[0]]
            let a1_nd: AstNode = pool.nodes[arg_ids[1]]
            mut res_t = a0_nd.c11_type
            if len(res_t) == 0 || res_t == "void*" {
                if len(a1_nd.c11_type) > 0 {
                    res_t = a1_nd.c11_type + "*"
                }
            }
            lower_set_node_types(pool, nid, a0_nd.inferred_type, res_t)
        } else if fn_name == "pop" && acnt >= 1 {
            let a0_nd: AstNode = pool.nodes[arg_ids[0]]
            lower_set_node_types(pool, nid, a0_nd.inferred_type, a0_nd.c11_type)
        } else if fn_sid != -1 {
            let f_e: SymbolInfo = ctx.sym.entries[fn_sid]
            lower_set_node_types(pool, nid, f_e.ret_nino_type, f_e.ret_c11_type)
            if fn_name == "arena_rollback" || fn_name == "arena_reset" || (f_e.kind == SK_FN() && f_e.decl_line > 0) {
                lower_pop_bce_depth(ctx, 0)
            }
        } else if ends_with(fn_name, "_to_json") {
            lower_set_node_types(pool, nid, "string", "const char*")
        } else if ends_with(fn_name, "_eq") {
            lower_set_node_types(pool, nid, "bool", "bool")
        }
        return fn_name + "(" + args_c + ")"
    }
    return ""
}

fn lower_sealed_leak_check(pool: AstPool, nid: int, sym: SymTable) -> string {
    if nid < 0 || nid >= len(pool.nodes) {
        return ""
    }
    let nd: AstNode = pool.nodes[nid]
    if nd.kind == NK_CALL() && nd.left >= 0 && nd.left < len(pool.nodes) {
        let cal: AstNode = pool.nodes[nd.left]
        if cal.kind == NK_IDENT() && (cal.name == "unseal" || cal.name == "unseal_i64" || cal.name == "seal_destroy" || cal.name == "enclave_attest" || cal.name == "len" || starts_with(cal.name, "zk_") || starts_with(cal.name, "zkp_")) {
            return ""
        }
    }
    if nd.kind == NK_IDENT() {
        let sid = sym_lookup(sym, nd.name)
        if sid != -1 {
            let e: SymbolInfo = sym.entries[sid]
            if e.is_sealed || e.sealed_tainted {
                return nd.name
            }
        }
    }
    if nd.left != -1 {
        let r1 = lower_sealed_leak_check(pool, nd.left, sym)
        if len(r1) > 0 {
            return r1
        }
    }
    if nd.right != -1 {
        let r2 = lower_sealed_leak_check(pool, nd.right, sym)
        if len(r2) > 0 {
            return r2
        }
    }
    if nd.extra != -1 {
        let r3 = lower_sealed_leak_check(pool, nd.extra, sym)
        if len(r3) > 0 {
            return r3
        }
    }
    for ci in 0..nd.child_count {
        let cid = pool.children[nd.child_start + ci]
        let r4 = lower_sealed_leak_check(pool, cid, sym)
        if len(r4) > 0 {
            return r4
        }
    }
    return ""
}

fn f1_scat(a: string, b: string) -> string {
    return a + b
}

fn m3_hex_nib_val(ch: string) -> int {
    let c = char_code(ch)
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    let neg1: int = -1
    return neg1
}

fn m3_decode_str_lit(raw_tok: string, mut ok_out: [bool]) -> [int] {
    mut out: [int] = []
    if len(raw_tok) < 2 || starts_with(raw_tok, "\"") == false || ends_with(raw_tok, "\"") == false {
        let f_false = false
        ok_out[0] = f_false
        return out
    }
    let n = len(raw_tok) - 1
    mut i = 1
    while i < n {
        let ch = char_at(raw_tok, i)
        if ch == "\\" {
            if i + 1 >= n {
                let f_false = false
                ok_out[0] = f_false
                return out
            }
            let esc = char_at(raw_tok, i + 1)
            if esc == "n" {
                let b_n: int = 10
                out = push(out, b_n)
                i = i + 2
            } else if esc == "r" {
                let b_r: int = 13
                out = push(out, b_r)
                i = i + 2
            } else if esc == "t" {
                let b_t: int = 9
                out = push(out, b_t)
                i = i + 2
            } else if esc == "0" {
                let b_z: int = 0
                out = push(out, b_z)
                i = i + 2
            } else if esc == "\\" {
                let b_s: int = 92
                out = push(out, b_s)
                i = i + 2
            } else if esc == "\"" {
                let b_q: int = 34
                out = push(out, b_q)
                i = i + 2
            } else if esc == "'" {
                let b_sq: int = 39
                out = push(out, b_sq)
                i = i + 2
            } else if esc == "x" && i + 3 < n {
                let h1 = m3_hex_nib_val(char_at(raw_tok, i + 2))
                let h2 = m3_hex_nib_val(char_at(raw_tok, i + 3))
                if h1 < 0 || h2 < 0 {
                    let f_false = false
                    ok_out[0] = f_false
                    return out
                }
                let hx = h1 * 16 + h2
                out = push(out, hx)
                i = i + 4
            } else {
                let f_false = false
                ok_out[0] = f_false
                return out
            }
        } else {
            let bv = char_code(ch)
            out = push(out, bv)
            i = i + 1
        }
    }
    let f_true = true
    ok_out[0] = f_true
    return out
}

fn m3_emit_sealed_str_lit(vname: string, raw_tok: string, seq: int) -> string {
    mut ok_flag: [bool] = [false]
    let bytes = m3_decode_str_lit(raw_tok, ok_flag)
    if ok_flag[0] == false {
        return ""
    }
    let blen = len(bytes)
    if blen == 0 {
        return "    const nino_sealed_t* " + vname + " = nino_seal_bytes(NULL, 0, NULL, 0);\n"
    }
    let kh = sha256("NINO_OBF_SEAL_V1:" + vname + ":" + int_to_str(seq) + ":" + int_to_str(blen))
    let sfx = int_to_str(seq)
    let dn = "_nino_sd_" + sfx
    let mn = "_nino_sm_" + sfx
    mut d_arr = "    uint8_t " + dn + "[" + int_to_str(blen) + "] = {"
    mut m_arr = "    uint8_t " + mn + "[" + int_to_str(blen) + "] = {"
    for bi in 0..blen {
        let kp = (bi % 32) * 2
        let h1 = m3_hex_nib_val(char_at(kh, kp))
        let h2 = m3_hex_nib_val(char_at(kh, kp + 1))
        mut kv = (h1 * 16 + h2) ^ ((bi * 131 + 37) % 256)
        if kv == 0 {
            kv = 0x5A
        }
        let enc_b = bytes[bi] ^ kv
        if bi > 0 {
            d_arr = d_arr + ","
            m_arr = m_arr + ","
        }
        d_arr = d_arr + int_to_str(enc_b)
        m_arr = m_arr + int_to_str(kv)
    }
    d_arr = d_arr + "};\n"
    m_arr = m_arr + "};\n"
    let call_s = "    const nino_sealed_t* " + vname + " = nino_seal_bytes(" + dn + ", " + int_to_str(blen) + ", " + mn + ", " + int_to_str(blen) + ");\n"
    let zero_s = "    _nino_secure_zero(" + dn + ", sizeof(" + dn + ")); _nino_secure_zero(" + mn + ", sizeof(" + mn + "));\n"
    return f1_scat(f1_scat(d_arr, m_arr), f1_scat(call_s, zero_s))
}

fn lower_vec_expr(mut pool: AstPool, nid: int, mut ctx: LowerCtx, iv: string, lane: int, ptr_pre: string) -> string {
    if nid < 0 || nid >= len(pool.nodes) {
        return "0"
    }
    let nd: AstNode = pool.nodes[nid]
    if nd.kind == NK_IDENT() {
        if nd.name == iv {
            if lane >= 0 {
                return "(" + iv + " + " + int_to_str(lane) + ")"
            }
            return iv
        }
        return lower_expr(pool, nid, ctx)
    }
    if nd.kind == NK_INDEX() {
        let arr_name = pool.nodes[nd.left].name
        let idx_s = lane >= 0 ? ("(" + iv + " + " + int_to_str(lane) + ")") : iv
        if len(ptr_pre) > 0 {
            return "(" + ptr_pre + arr_name + "[" + idx_s + "])"
        }
        let sid = sym_lookup(ctx.sym, arr_name)
        let elem_c11 = f1_c11_elem_type(ctx.sym.entries[sid].c11_type)
        return "((" + elem_c11 + "*)(" + arr_name + "))[" + idx_s + "]"
    }
    if nd.kind == NK_UNARY_OP() {
        return "(" + nd.op + "(" + lower_vec_expr(pool, nd.left, ctx, iv, lane, ptr_pre) + "))"
    }
    if nd.kind == NK_BIN_OP() {
        let lc = lower_vec_expr(pool, nd.left, ctx, iv, lane, ptr_pre)
        let rc = lower_vec_expr(pool, nd.right, ctx, iv, lane, ptr_pre)
        return "(" + lc + " " + nd.op + " " + rc + ")"
    }
    return lower_expr(pool, nid, ctx)
}

fn lower_try_emit_vec_for(mut pool: AstPool, nid: int, mut ctx: LowerCtx, emit_ldir: bool, ldir: string) -> bool {
    let fnd: AstNode = pool.nodes[nid]
    let vm = nir_vec_analyze_for(pool, nid)
    if nir_is_vec_sym_ok(pool, nid, vm, ctx.sym) == false {
        return false
    }
    let lb = "{"
    let rb = "}"
    let iv = fnd.name
    let hi_c = lower_expr(pool, fnd.right, ctx)
    let stmts = nir_vec_collect_stmts(pool, pool.children[fnd.child_start])
    mut w_arrs: [string] = []
    mut all_arrs: [string] = []
    for si in 0..len(stmts) {
        let snd: AstNode = pool.nodes[stmts[si]]
        if vm == 1 {
            let lnd: AstNode = pool.nodes[snd.left]
            let wn = pool.nodes[lnd.left].name
            w_arrs = nir_vec_add_uniq(w_arrs, wn)
            all_arrs = nir_vec_add_uniq(all_arrs, wn)
            all_arrs = nir_vec_collect_expr_arrs(pool, snd.right, iv, all_arrs)
        } else {
            all_arrs = nir_vec_collect_expr_arrs(pool, snd.right, iv, all_arrs)
        }
    }
    mut pre = ctx.pre_stmts
    let empty_s = ""
    ctx.pre_stmts = empty_s
    let vseq = ctx.temp_seq
    let nseq = vseq + 1
    ctx.temp_seq = nseq
    let vn = "_nino_vn_" + int_to_str(vseq)
    let ptr_pre = "_vr_" + int_to_str(vseq) + "_"

    mut out = ctx.body_code
    if emit_ldir {
        out = f1_scat(out, ldir)
    }
    out = f1_scat(out, pre)
    out = out + "    int64_t " + vn + " = (int64_t)(" + hi_c + ");\n"
    out = out + "    if (" + vn + " > 0) " + lb + "\n"
    for ai in 0..len(all_arrs) {
        let an = all_arrs[ai]
        out = out + "        nino_bounds_check((void*)(" + an + "), 0);\n"
        out = out + "        nino_bounds_check((void*)(" + an + "), " + vn + " - 1);\n"
    }
    out = out + "    " + rb + "\n"

    mut no_alias = "1"
    for wi in 0..len(w_arrs) {
        let wn = w_arrs[wi]
        for ai in 0..len(all_arrs) {
            let an = all_arrs[ai]
            if wn != an {
                no_alias = no_alias + " && (const void*)(" + wn + ") != (const void*)(" + an + ")"
            }
        }
    }

    mut rdecls = ""
    for ai in 0..len(all_arrs) {
        let an = all_arrs[ai]
        let sid = sym_lookup(ctx.sym, an)
        let elem_c11 = f1_c11_elem_type(ctx.sym.entries[sid].c11_type)
        if nir_vec_str_in(w_arrs, an) {
            rdecls = rdecls + "        " + elem_c11 + " * restrict " + ptr_pre + an + " = (" + elem_c11 + "*)(" + an + ");\n"
        } else {
            rdecls = rdecls + "        const " + elem_c11 + " * restrict " + ptr_pre + an + " = (const " + elem_c11 + "*)(" + an + ");\n"
        }
    }

    out = out + "    " + lb + "\n"
    out = out + "    int64_t " + iv + " = 0;\n"
    out = out + "    if (_nino_tx.depth == 0 && (" + no_alias + ") && (" + vn + " >= 4)) " + lb + "\n"
    out = out + rdecls
    if vm == 1 {
        out = out + "        for (; " + iv + " + 4 <= " + vn + "; " + iv + " += 4) " + lb + "\n"
        for si in 0..len(stmts) {
            let snd: AstNode = pool.nodes[stmts[si]]
            let lnd: AstNode = pool.nodes[snd.left]
            let wn = pool.nodes[lnd.left].name
            for lane in 0..4 {
                let rhs_l = lower_vec_expr(pool, snd.right, ctx, iv, lane, ptr_pre)
                out = out + "            " + ptr_pre + wn + "[(" + iv + " + " + int_to_str(lane) + ")] = " + rhs_l + ";\n"
            }
        }
        out = out + "        " + rb + "\n"
    } else {
        let snd: AstNode = pool.nodes[stmts[0]]
        let lnd: AstNode = pool.nodes[snd.left]
        let acc = lnd.name
        let sid_a = sym_lookup(ctx.sym, acc)
        let acc_c11 = ctx.sym.entries[sid_a].c11_type
        let rnd: AstNode = pool.nodes[snd.right]
        let rl: AstNode = pool.nodes[rnd.left]
        let term_id = (rl.kind == NK_IDENT() && rl.name == acc) ? rnd.right : rnd.left
        let a0 = "_va0_" + int_to_str(vseq)
        let a1 = "_va1_" + int_to_str(vseq)
        let a2 = "_va2_" + int_to_str(vseq)
        let a3 = "_va3_" + int_to_str(vseq)
        out = out + "        " + acc_c11 + " " + a0 + " = 0, " + a1 + " = 0, " + a2 + " = 0, " + a3 + " = 0;\n"
        out = out + "        for (; " + iv + " + 4 <= " + vn + "; " + iv + " += 4) " + lb + "\n"
        out = out + "            " + a0 + " += " + lower_vec_expr(pool, term_id, ctx, iv, 0, ptr_pre) + ";\n"
        out = out + "            " + a1 + " += " + lower_vec_expr(pool, term_id, ctx, iv, 1, ptr_pre) + ";\n"
        out = out + "            " + a2 + " += " + lower_vec_expr(pool, term_id, ctx, iv, 2, ptr_pre) + ";\n"
        out = out + "            " + a3 + " += " + lower_vec_expr(pool, term_id, ctx, iv, 3, ptr_pre) + ";\n"
        out = out + "        " + rb + "\n"
        out = out + "        " + acc + " = (" + acc_c11 + ")(" + acc + " + ((" + a0 + " + " + a1 + ") + (" + a2 + " + " + a3 + ")));\n"
    }
    out = out + "    " + rb + "\n"

    out = out + "    for (; " + iv + " < " + vn + "; " + iv + "++) " + lb + "\n"
    if vm == 1 {
        for si in 0..len(stmts) {
            let snd: AstNode = pool.nodes[stmts[si]]
            let lnd: AstNode = pool.nodes[snd.left]
            let wn = pool.nodes[lnd.left].name
            let sid_w = sym_lookup(ctx.sym, wn)
            let w_elem = f1_c11_elem_type(ctx.sym.entries[sid_w].c11_type)
            let rhs_t = lower_vec_expr(pool, snd.right, ctx, iv, -1, "")
            out = out + "        if (_nino_tx.depth > 0) { nino_tx_checkpoint((void*)&(((" + w_elem + "*)(" + wn + "))[" + iv + "]), sizeof(" + w_elem + ")); }\n"
            out = out + "        ((" + w_elem + "*)(" + wn + "))[" + iv + "] = " + rhs_t + ";\n"
        }
    } else {
        let snd: AstNode = pool.nodes[stmts[0]]
        let lnd: AstNode = pool.nodes[snd.left]
        let acc = lnd.name
        let sid_a = sym_lookup(ctx.sym, acc)
        let acc_c11 = ctx.sym.entries[sid_a].c11_type
        let rnd: AstNode = pool.nodes[snd.right]
        let rl: AstNode = pool.nodes[rnd.left]
        let term_id = (rl.kind == NK_IDENT() && rl.name == acc) ? rnd.right : rnd.left
        let rhs_t = lower_vec_expr(pool, term_id, ctx, iv, -1, "")
        out = out + "        if (_nino_tx.depth > 0) { nino_tx_checkpoint((void*)&(" + acc + "), sizeof(" + acc + ")); }\n"
        out = out + "        " + acc + " = (" + acc_c11 + ")(" + acc + " + " + rhs_t + ");\n"
    }
    out = out + "    " + rb + "\n"
    out = out + "    " + rb + "\n"
    ctx.body_code = out
    let fl_false = false
    ctx.last_stmt_was_return = fl_false
    return true
}

fn lower_stmt(mut pool: AstPool, nid: int, mut ctx: LowerCtx, emit_ldir: bool) {
    if nid < 0 || nid >= len(pool.nodes) || ctx.has_error {
        return
    }
    let nd: AstNode = pool.nodes[nid]
    if (nd.flags & NF_DEAD()) != 0 {
        return
    }
    let lb = "{"
    let rb = "}"
    let fnm = lower_node_file_name(pool, nd.file_id)
    let ldir = "#line " + int_to_str(nd.line) + " \"" + fnm + "\"\n"
    if nd.kind == NK_BLOCK() {
        let sc_blk = SCOPE_BLOCK()
        sym_push_scope(ctx.sym, sc_blk, 0)
        for ci in 0..nd.child_count {
            let cid = pool.children[nd.child_start + ci]
            lower_stmt(pool, cid, ctx, emit_ldir)
        }
        sym_pop_scope(ctx.sym)
        return
    }
    if nd.kind == NK_DEFER_STMT() {
        let saved_body = ctx.body_code
        let empty_s = ""
        ctx.body_code = empty_s
        lower_stmt(pool, nd.left, ctx, false)
        let d_code = trim(ctx.body_code)
        ctx.body_code = saved_body
        let cur_d = ctx.sym.scope_depth
        let d_item = DeferItem { stmt_node_id: nd.left, scope_depth: cur_d, c_code: d_code }
        mut d_arr = ctx.defers
        d_arr = push(d_arr, d_item)
        ctx.defers = d_arr
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_LET_STMT() {
        let is_mut = (nd.flags & NF_MUT()) != 0
        let is_sealed = (nd.flags & NF_SEALED()) != 0
        let is_morphic = (nd.flags & NF_MORPHIC()) != 0
        let rhs_c = lower_expr(pool, nd.left, ctx)
        let r_nd: AstNode = pool.nodes[nd.left]
        mut decl_c11 = ""
        mut decl_nino = ""
        mut elem_nino = ""
        mut elem_c11 = ""
        if len(nd.type_ann) > 0 {
            decl_nino = nd.type_ann
            decl_c11 = map_type(nd.type_ann)
            if f1_is_arr_nino_type(nd.type_ann) {
                elem_nino = f1_nino_elem_type(nd.type_ann)
                elem_c11 = map_type(elem_nino)
            }
        } else {
            decl_nino = r_nd.inferred_type
            decl_c11 = r_nd.c11_type
            if len(decl_c11) == 0 {
                decl_c11 = "int64_t"
            }
        }
        mut sinfo = sym_info_empty()
        sinfo.kind = SK_VAR()
        sinfo.nino_type = decl_nino
        sinfo.c11_type = decl_c11
        sinfo.elem_nino_type = elem_nino
        sinfo.elem_c11_type = elem_c11
        sinfo.is_mut = is_mut
        sinfo.is_sealed = is_sealed
        sinfo.sealed_tainted = len(lower_sealed_leak_check(pool, nd.left, ctx.sym)) > 0
        sinfo.is_morphic = is_morphic
        sinfo.decl_line = nd.line
        sym_insert(ctx.sym, nd.name, sinfo)
        mut is_sealed_ptr_alias = false
        if is_sealed == false && r_nd.kind == NK_IDENT() {
            let rsid_s = sym_lookup(ctx.sym, r_nd.name)
            if rsid_s != -1 {
                let rse_s: SymbolInfo = ctx.sym.entries[rsid_s]
                if rse_s.is_sealed && rse_s.c11_type == "const char*" {
                    is_sealed_ptr_alias = true
                }
            }
        }
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut stmt_c = ""
        if is_sealed {
            if decl_c11 == "const char*" {
                mut emitted_obf = ""
                if r_nd.kind == NK_STR_LIT() {
                    let seq = ctx.temp_seq
                    let nseq = seq + 1
                    ctx.temp_seq = nseq
                    emitted_obf = m3_emit_sealed_str_lit(nd.name, r_nd.str_val, seq)
                }
                if len(emitted_obf) > 0 {
                    stmt_c = emitted_obf
                } else {
                    stmt_c = "    const nino_sealed_t* " + nd.name + " = nino_seal_str(" + rhs_c + ");\n"
                }
            } else {
                stmt_c = "    const nino_sealed_i64_t " + nd.name + " = nino_seal_i64((int64_t)(" + rhs_c + "));\n"
            }
        } else if is_sealed_ptr_alias {
            stmt_c = "    const nino_sealed_t* " + nd.name + " = " + rhs_c + ";\n"
        } else if is_morphic {
            stmt_c = "    nino_morphic_t " + nd.name + " = nino_morphic_init((int64_t)(" + rhs_c + "));\n"
        } else if is_mut {
            stmt_c = "    " + decl_c11 + " " + nd.name + " = " + rhs_c + ";\n"
        } else {
            if starts_with(decl_c11, "const ") {
                stmt_c = "    " + decl_c11 + " " + nd.name + " = " + rhs_c + ";\n"
            } else if ends_with(decl_c11, "*") {
                stmt_c = "    " + decl_c11 + " const " + nd.name + " = " + rhs_c + ";\n"
            } else {
                stmt_c = "    const " + decl_c11 + " " + nd.name + " = " + rhs_c + ";\n"
            }
        }
        mut out_b = ctx.body_code
        if emit_ldir {
            out_b = f1_scat(out_b, ldir)
        }
        out_b = f1_scat(out_b, pre)
        out_b = f1_scat(out_b, stmt_c)
        ctx.body_code = out_b
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_ASSIGN_STMT() {
        let l_nd: AstNode = pool.nodes[nd.left]
        if l_nd.kind == NK_IDENT() {
            let sid = sym_lookup(ctx.sym, l_nd.name)
            if sid != -1 {
                let se: SymbolInfo = ctx.sym.entries[sid]
                if se.is_mut == false && se.is_morphic == false {
                    print("\033[91m[Nino Type Error]\033[0m Cannot mutate immutable variable '" + l_nd.name + "' (declared with 'let') at line " + int_to_str(nd.line))
                    let snip = lower_diag_line_text(pool, nd.file_id, nd.line)
                    emit_rustc_style_diag(fnm, nd.line, nd.col, "E0384", "type_error", "Cannot mutate immutable variable '" + l_nd.name + "'", snip, len(l_nd.name), "variables declared with 'let' are immutable by default; use 'mut' to allow mutation")
                    let err_t = true
                    ctx.has_error = err_t
                    return
                }
            }
        } else if l_nd.kind == NK_MEMBER() {
            mut rcur = l_nd.left
            while rcur >= 0 && rcur < len(pool.nodes) && pool.nodes[rcur].kind == NK_MEMBER() {
                rcur = pool.nodes[rcur].left
            }
            if rcur >= 0 && rcur < len(pool.nodes) && pool.nodes[rcur].kind == NK_IDENT() {
                let r_name = pool.nodes[rcur].name
                let rsid = sym_lookup(ctx.sym, r_name)
                if rsid != -1 {
                    let rse: SymbolInfo = ctx.sym.entries[rsid]
                    if rse.is_mut == false && rse.is_morphic == false {
                        print("\033[91m[Nino Type Error]\033[0m Cannot mutate field '" + l_nd.name + "' of immutable variable '" + r_name + "' (declared with 'let') at line " + int_to_str(nd.line))
                        let snip = lower_diag_line_text(pool, nd.file_id, nd.line)
                        emit_rustc_style_diag(fnm, nd.line, nd.col, "E0384", "type_error", "Cannot mutate field of immutable variable '" + r_name + "'", snip, len(r_name), "variables declared with 'let' are immutable by default; use 'mut' to allow mutation")
                        let err_t = true
                        ctx.has_error = err_t
                        return
                    }
                }
            }
            lower_expr(pool, l_nd.left, ctx)
            let recv_nd: AstNode = pool.nodes[l_nd.left]
            let sname = strip_generic_args(recv_nd.inferred_type)
            let st_sid = sym_lookup(ctx.sym, sname)
            if st_sid != -1 {
                let st_e: SymbolInfo = ctx.sym.entries[st_sid]
                if st_e.kind == SK_STRUCT() {
                    for fi in 0..st_e.child_count {
                        let finfo: FieldInfo = ctx.sym.fields[st_e.child_start + fi]
                        if finfo.name == l_nd.name && finfo.is_mut == false {
                            print("\033[91m[Nino Type Error]\033[0m Cannot mutate immutable struct field '" + sname + "." + l_nd.name + "' at line " + int_to_str(nd.line))
                            let snip = lower_diag_line_text(pool, nd.file_id, nd.line)
                            emit_rustc_style_diag(fnm, nd.line, nd.col, "E0384", "type_error", "Cannot mutate immutable struct field '" + sname + "." + l_nd.name + "'", snip, len(l_nd.name), "declare struct field with 'mut " + l_nd.name + ": ...' to allow mutation")
                            let err_t = true
                            ctx.has_error = err_t
                            return
                        }
                    }
                }
            }
        }
        let rhs_c = lower_expr(pool, nd.right, ctx)
        mut stmt_c = ""
        if l_nd.kind == NK_INDEX() {
            mut rcur_i = l_nd.left
            while rcur_i >= 0 && rcur_i < len(pool.nodes) && (pool.nodes[rcur_i].kind == NK_INDEX() || pool.nodes[rcur_i].kind == NK_MEMBER()) {
                rcur_i = pool.nodes[rcur_i].left
            }
            if rcur_i >= 0 && rcur_i < len(pool.nodes) && pool.nodes[rcur_i].kind == NK_IDENT() {
                let r_name_i = pool.nodes[rcur_i].name
                let rsid_i = sym_lookup(ctx.sym, r_name_i)
                if rsid_i != -1 {
                    let rse_i: SymbolInfo = ctx.sym.entries[rsid_i]
                    if rse_i.kind != SK_PARAM() && rse_i.is_mut == false && rse_i.is_morphic == false {
                        print("\033[91m[Nino Type Error]\033[0m Cannot mutate elements of immutable variable '" + r_name_i + "' (declared with 'let') at line " + int_to_str(nd.line))
                        let snip_i = lower_diag_line_text(pool, nd.file_id, nd.line)
                        emit_rustc_style_diag(fnm, nd.line, nd.col, "E0384", "type_error", "Cannot mutate elements of immutable variable '" + r_name_i + "'", snip_i, len(r_name_i), "variables declared with 'let' are immutable by default; use 'mut' to allow mutation")
                        let err_ti = true
                        ctx.has_error = err_ti
                        return
                    }
                }
            }
            let tgt_c = lower_expr(pool, l_nd.left, ctx)
            let idx_c = lower_expr(pool, l_nd.right, ctx)
            let t_nd: AstNode = pool.nodes[l_nd.left]
            let i_nd: AstNode = pool.nodes[l_nd.right]
            if i_nd.c11_type == "const char*" || t_nd.c11_type == "NinoDict*" {
                stmt_c = "    nino_dict_set_auto(" + tgt_c + ", " + idx_c + ", " + rhs_c + ");\n"
            } else {
                let elem_c11 = f1_c11_elem_type(t_nd.c11_type)
                stmt_c = "    { " + elem_c11 + "* _nino_tx_tgt = (" + elem_c11 + "*)(" + tgt_c + "); int64_t _nino_tx_idx = (int64_t)(" + idx_c + "); nino_bounds_check((void*)_nino_tx_tgt, _nino_tx_idx); nino_tx_checkpoint_arr((void*)_nino_tx_tgt, (void*)&_nino_tx_tgt[_nino_tx_idx], sizeof(_nino_tx_tgt[_nino_tx_idx])); _nino_tx_tgt[_nino_tx_idx] = " + rhs_c + "; }\n"
            }
        } else {
            mut is_loc = false
            mut is_mor = false
            if l_nd.kind == NK_IDENT() {
                let sid_a = sym_lookup(ctx.sym, l_nd.name)
                if sid_a != -1 {
                    let sea: SymbolInfo = ctx.sym.entries[sid_a]
                    if sea.scope_depth > 0 {
                        is_loc = true
                    }
                    is_mor = sea.is_morphic
                }
            } else if l_nd.kind == NK_MEMBER() {
                is_loc = true
            }
            if is_mor && l_nd.kind == NK_IDENT() {
                stmt_c = "    nino_tx_checkpoint_local((void*)&(" + l_nd.name + "), sizeof(" + l_nd.name + ")); nino_morphic_write(&" + l_nd.name + ", (int64_t)(" + rhs_c + "));\n"
            } else if is_loc {
                let lhs_c = lower_expr(pool, nd.left, ctx)
                stmt_c = "    nino_tx_checkpoint_local((void*)&(" + lhs_c + "), sizeof(" + lhs_c + ")); " + lhs_c + " = (" + rhs_c + ");\n"
            } else {
                let lhs_c = lower_expr(pool, nd.left, ctx)
                stmt_c = "    nino_tx_checkpoint((void*)&(" + lhs_c + "), sizeof(" + lhs_c + ")); " + lhs_c + " = (" + rhs_c + ");\n"
            }
        }
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut out_b = ctx.body_code
        if emit_ldir {
            out_b = f1_scat(out_b, ldir)
        }
        out_b = f1_scat(out_b, pre)
        out_b = f1_scat(out_b, stmt_c)
        ctx.body_code = out_b
        let fl_false = false
        ctx.last_stmt_was_return = fl_false
        return
    }
    if nd.kind == NK_RETURN_STMT() {
        if ctx.in_actor {
            mut stmt_c = "    return \"\";\n"
            if nd.left != -1 {
                let rc = lower_expr(pool, nd.left, ctx)
                let rnd: AstNode = pool.nodes[nd.left]
                if rnd.c11_type == "const char*" {
                    stmt_c = "    return (" + rc + ");\n"
                } else {
                    stmt_c = "    return nino_auto_concat(\"\", (" + rc + "));\n"
                }
            }
            mut out_b = ctx.body_code
            if emit_ldir {
                out_b = f1_scat(out_b, ldir)
            }
            out_b = f1_scat(out_b, stmt_c)
            ctx.body_code = out_b
            let fl_true = true
            ctx.last_stmt_was_return = fl_true
            return
        }
        let cleanup = lower_emit_cleanup(ctx)
        mut full_cleanup = cleanup
        if ctx.is_no_std == false && ctx.in_actor == false {
            full_cleanup = full_cleanup + "        nino_tx_fn_leave(_nino_fn_tx_sc);\n"
        }
