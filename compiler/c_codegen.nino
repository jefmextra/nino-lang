        if nd.left != -1 {
            let leak_ret = lower_sealed_leak_check(pool, nd.left, ctx.sym)
            if len(leak_ret) > 0 {
                print("\033[91m[Nino Security Error]\033[0m Cannot return sealed secret or alias '" + leak_ret + "' without explicit unseal() at line " + int_to_str(nd.line))
                let snip_r = lower_diag_line_text(pool, nd.file_id, nd.line)
                emit_rustc_style_diag(fnm, nd.line, nd.col, "E0042", "security_error", "Cannot return sealed secret or alias '" + leak_ret + "' without explicit unseal()", snip_r, len(leak_ret), "confidential memory enclaves must be explicitly unsealed with unseal(" + leak_ret + ") before returning")
                let err_tr = true
                ctx.has_error = err_tr
                return
            }
            let rc = lower_expr(pool, nd.left, ctx)
            let rnd: AstNode = pool.nodes[nd.left]
            if len(full_cleanup) > 0 {
                mut ret_t = ctx.cur_fn_ret_c11
                if len(ret_t) == 0 || ret_t == "void" {
                    ret_t = rnd.c11_type
                }
                if len(ret_t) == 0 {
                    ret_t = "int64_t"
                }
                stmt_c = "    " + lb + "\n        " + ret_t + " _nino_ret = (" + rc + ");\n" + full_cleanup + "        return _nino_ret;\n    " + rb + "\n"
            } else {
                stmt_c = "    return " + rc + ";\n"
            }
        } else {
            if len(full_cleanup) > 0 {
                if ctx.is_main_fn {
                    stmt_c = "    " + lb + "\n" + full_cleanup + "        return 0;\n    " + rb + "\n"
                } else {
                    stmt_c = "    " + lb + "\n" + full_cleanup + "        return;\n    " + rb + "\n"
                }
            } else {
                if ctx.is_main_fn {
                    stmt_c = "    return 0;\n"
                } else {
                    stmt_c = "    return;\n"
                }
            }
        }
        mut pre = ctx.pre_stmts
        let empty_s = ""
        ctx.pre_stmts = empty_s
        mut out_b = ctx.body_code
        if emit_ldir {
            out_b = f1_scat(out_b, ldir)
        }
        out_b = f1_scat(out_b, pre)
        out_b = f1_scat(out_b, stmt_c)
        ctx.body_code = out_b
        let fl_true = true
        ctx.last_stmt_was_return = fl_true
        return
