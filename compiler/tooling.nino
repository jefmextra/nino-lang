    print("  witness <file.nino> [-o <out.nino>]    Synthesize executable Z3 counterexample witness tests")
    print("  bindgen <header.h> [-o <out.nino>]     Generate zero-overhead Nino FFI bindings from C headers")
    print("  trace <file.nino>                      Execute with SHA-256 deterministic flight recorder")
