    print("\033[96m================================================================================\033[0m")
    print("\033[93m[Nino Sovereign Self-Hosting Toolchain (ninoc)]\033[0m")
    print("Self-Sovereign Systems Language with Deterministic Memory & Formal Contracts\n")
