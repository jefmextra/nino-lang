    let arch_t = is_host_windows() ? "x86_64-pc-windows-gnu" : "x86_64-unknown-linux-gnu"
    print("Nino Sovereign Systems Language Toolchain v1.2.1")
    print("Compiler Engine    : ninoc (Modular Self-Hosted Native Machine Code)")
    print("Architecture Target: " + arch_t + " (Standalone Executable)")
    print("Runtime Subsystem  : Morphic Deterministic Memory / Zero-Overhead Contracts")
    print("Bootstrap Stage    : Stage-3 Fixed-Point Deterministic Convergence")
}

struct EqSmtCtx {
    pfx: string,
    mut sym_map: string,
    mut bool_syms: string,
    mut decls: string,
    mut asserts: string,
    mut ret_conds: [string],
    mut ret_vals: [string],
    mut path_cond: string,
    mut seq: int,
    mut unsupported: bool,
    mut always_returned: bool
}

fn eq_smt_map_get(sym_map: string, key: string) -> string {
    let pat = "|" + key + "="
    let p = find_str(sym_map, pat, 0)
    if p == -1 {
        return ""
    }
    let vs = p + len(pat)
    let ve = find_char(sym_map, "|", vs)
    if ve == -1 {
        return ""
    }
    return slice(sym_map, vs, ve - vs)
}

fn eq_smt_map_set(sym_map: string, key: string, val: string) -> string {
    let pat = "|" + key + "="
    let p = find_str(sym_map, pat, 0)
    if p == -1 {
        return sym_map + key + "=" + val + "|"
    }
    let vs = p + len(pat)
    let ve = find_char(sym_map, "|", vs)
    if ve == -1 {
        return sym_map + key + "=" + val + "|"
    }
    return slice(sym_map, 0, p) + "|" + key + "=" + val + slice(sym_map, ve, len(sym_map) - ve)
}

fn eq_smt_map_keys(sym_map: string) -> [string] {
    mut out: [string] = []
    let n = len(sym_map)
    mut i = 1
    while i < n {
        let eq = find_char(sym_map, "=", i)
        let bar = find_char(sym_map, "|", i)
        if eq == -1 || bar == -1 {
            break
        }
        if eq < bar {
            out = push(out, slice(sym_map, i, eq - i))
        }
        i = bar + 1
    }
    return out
}

fn eq_smt_and(a: string, b: string) -> string {
    if len(a) == 0 {
        return b
    }
    if len(b) == 0 {
        return a
    }
    return "(and " + a + " " + b + ")"
}

fn eq_smt_is_bool_expr(pool: AstPool, nid: int, bool_syms: string) -> bool {
    if nid < 0 || nid >= len(pool.nodes) {
        return false
    }
    let nd: AstNode = pool.nodes[nid]
    if nd.kind == NK_BOOL_LIT() {
        return true
    }
    if nd.kind == NK_IDENT() {
        return find_str(bool_syms, "|" + nd.name + "|", 0) != -1
    }
    if nd.kind == NK_UNARY_OP() && nd.op == "!" {
        return true
    }
    if nd.kind == NK_BIN_OP() {
        return nd.op == "==" || nd.op == "!=" || nd.op == "<" || nd.op == "<=" || nd.op == ">" || nd.op == ">=" || nd.op == "&&" || nd.op == "||"
    }
    if nd.kind == NK_TERNARY() {
        return eq_smt_is_bool_expr(pool, nd.right, bool_syms)
    }
    return false
}

fn eq_smt_expr(pool: AstPool, nid: int, sym_map: string, mut ok_out: [int]) -> string {
    if nid < 0 || nid >= len(pool.nodes) {
        ok_out[0] = 0
        return "0"
    }
    let nd: AstNode = pool.nodes[nid]
    if nd.kind == NK_INT_LIT() {
        return nd.str_val
    }
    if nd.kind == NK_BOOL_LIT() {
        return nd.str_val
    }
    if nd.kind == NK_IDENT() {
        let mapped = eq_smt_map_get(sym_map, nd.name)
        if len(mapped) == 0 {
            ok_out[0] = 0
            return "0"
        }
        return mapped
    }
    if nd.kind == NK_UNARY_OP() {
        let sub = eq_smt_expr(pool, nd.left, sym_map, ok_out)
        if nd.op == "-" {
            return "(- " + sub + ")"
        }
        if nd.op == "!" {
            return "(not " + sub + ")"
        }
        ok_out[0] = 0
        return "0"
    }
    if nd.kind == NK_TERNARY() {
        let c = eq_smt_expr(pool, nd.left, sym_map, ok_out)
        let t = eq_smt_expr(pool, nd.right, sym_map, ok_out)
        let e = eq_smt_expr(pool, nd.extra, sym_map, ok_out)
        return "(ite " + c + " " + t + " " + e + ")"
    }
    if nd.kind == NK_BIN_OP() {
        let l = eq_smt_expr(pool, nd.left, sym_map, ok_out)
        let r = eq_smt_expr(pool, nd.right, sym_map, ok_out)
        mut op = nd.op
        if op == "+" || op == "-" || op == "*" || op == "<" || op == "<=" || op == ">" || op == ">=" {
            return "(" + op + " " + l + " " + r + ")"
        }
        if op == "/" {
            return "(div " + l + " " + r + ")"
        }
        if op == "%" {
            return "(mod " + l + " " + r + ")"
        }
        if op == "==" {
            return "(= " + l + " " + r + ")"
        }
        if op == "!=" {
            return "(distinct " + l + " " + r + ")"
        }
        if op == "&&" {
            return "(and " + l + " " + r + ")"
        }
        if op == "||" {
            return "(or " + l + " " + r + ")"
        }
        ok_out[0] = 0
        return "0"
    }
    ok_out[0] = 0
    return "0"
}

fn eq_smt_lower_stmt(pool: AstPool, nid: int, mut ctx: EqSmtCtx) {
    if ctx.always_returned || ctx.unsupported || nid < 0 || nid >= len(pool.nodes) {
        return
    }
    let nd: AstNode = pool.nodes[nid]
    if nd.kind == NK_BLOCK() {
        for ci in 0..nd.child_count {
            if ctx.always_returned || ctx.unsupported {
                return
            }
            eq_smt_lower_stmt(pool, pool.children[nd.child_start + ci], ctx)
        }
        return
    }
    if nd.kind == NK_CONTRACT_REQ() {
        mut ok = [1]
        let c = eq_smt_expr(pool, nd.left, ctx.sym_map, ok)
        if ok[0] == 1 {
            if len(ctx.path_cond) > 0 {
                ctx.asserts = ctx.asserts + "(assert (=> " + ctx.path_cond + " " + c + "))\n"
            } else {
                ctx.asserts = ctx.asserts + "(assert " + c + ")\n"
            }
        } else {
            ctx.unsupported = true
        }
        return
    }
    if nd.kind == NK_EXPR_STMT() {
        let cid = nd.left
        if cid >= 0 && cid < len(pool.nodes) && pool.nodes[cid].kind == NK_CALL() {
            let cnd: AstNode = pool.nodes[cid]
            if cnd.left >= 0 && cnd.left < len(pool.nodes) && pool.nodes[cnd.left].name == "require" && cnd.child_count >= 1 {
                mut ok = [1]
                let c = eq_smt_expr(pool, pool.children[cnd.child_start], ctx.sym_map, ok)
                if ok[0] == 1 {
                    if len(ctx.path_cond) > 0 {
                        ctx.asserts = ctx.asserts + "(assert (=> " + ctx.path_cond + " " + c + "))\n"
                    } else {
                        ctx.asserts = ctx.asserts + "(assert " + c + ")\n"
                    }
                    return
                }
            }
        }
        ctx.unsupported = true
        return
    }
    if nd.kind == NK_LET_STMT() {
        mut ok = [1]
        let rhs = eq_smt_expr(pool, nd.left, ctx.sym_map, ok)
        if ok[0] == 0 {
            ctx.unsupported = true
            return
        }
        mut sort = "Int"
        if trim(nd.type_ann) == "bool" || eq_smt_is_bool_expr(pool, nd.left, ctx.bool_syms) {
            sort = "Bool"
            if find_str(ctx.bool_syms, "|" + nd.name + "|", 0) == -1 {
                ctx.bool_syms = ctx.bool_syms + nd.name + "|"
            }
        }
        ctx.seq = ctx.seq + 1
        let ssa = ctx.pfx + nd.name + "_" + int_to_str(ctx.seq)
        ctx.decls = ctx.decls + "(declare-const " + ssa + " " + sort + ")\n"
        ctx.asserts = ctx.asserts + "(assert (= " + ssa + " " + rhs + "))\n"
        ctx.sym_map = eq_smt_map_set(ctx.sym_map, nd.name, ssa)
        return
    }
    if nd.kind == NK_ASSIGN_STMT() {
        if nd.op != "=" || nd.left < 0 || nd.left >= len(pool.nodes) || pool.nodes[nd.left].kind != NK_IDENT() {
            ctx.unsupported = true
            return
        }
        let vname = pool.nodes[nd.left].name
        mut ok = [1]
        let rhs = eq_smt_expr(pool, nd.right, ctx.sym_map, ok)
        if ok[0] == 0 {
            ctx.unsupported = true
            return
        }
        mut sort = "Int"
        if find_str(ctx.bool_syms, "|" + vname + "|", 0) != -1 {
            sort = "Bool"
        }
        ctx.seq = ctx.seq + 1
        let ssa = ctx.pfx + vname + "_" + int_to_str(ctx.seq)
        ctx.decls = ctx.decls + "(declare-const " + ssa + " " + sort + ")\n"
        ctx.asserts = ctx.asserts + "(assert (= " + ssa + " " + rhs + "))\n"
        ctx.sym_map = eq_smt_map_set(ctx.sym_map, vname, ssa)
        return
    }
    if nd.kind == NK_RETURN_STMT() {
        mut ok = [1]
        let rv = eq_smt_expr(pool, nd.left, ctx.sym_map, ok)
        if ok[0] == 0 {
            ctx.unsupported = true
            return
        }
        ctx.ret_conds = push(ctx.ret_conds, ctx.path_cond)
        ctx.ret_vals = push(ctx.ret_vals, rv)
        ctx.always_returned = true
        return
    }
    if nd.kind == NK_IF_STMT() {
        mut ok = [1]
        let cond_s = eq_smt_expr(pool, nd.left, ctx.sym_map, ok)
        if ok[0] == 0 {
            ctx.unsupported = true
            return
        }
        let pre_map = ctx.sym_map
        let pre_pc = ctx.path_cond
        ctx.path_cond = eq_smt_and(pre_pc, cond_s)
        ctx.always_returned = false
        eq_smt_lower_stmt(pool, nd.right, ctx)
        let then_map = ctx.sym_map
        let then_ret = ctx.always_returned
        let then_pc = ctx.path_cond

        ctx.sym_map = pre_map
        ctx.path_cond = eq_smt_and(pre_pc, "(not " + cond_s + ")")
        ctx.always_returned = false
        if nd.extra != -1 {
            eq_smt_lower_stmt(pool, nd.extra, ctx)
        }
        let else_map = ctx.sym_map
        let else_ret = ctx.always_returned
        let else_pc = ctx.path_cond

        ctx.path_cond = pre_pc
        ctx.sym_map = pre_map
        ctx.always_returned = (then_ret && else_ret)
        if ctx.always_returned == false {
            if then_ret && else_ret == false {
                ctx.path_cond = else_pc
            } else if then_ret == false && else_ret {
                ctx.path_cond = then_pc
            }
            let keys = eq_smt_map_keys(pre_map)
            for ki in 0..len(keys) {
                let k = keys[ki]
                let vp = eq_smt_map_get(pre_map, k)
                let vt = eq_smt_map_get(then_map, k)
                let ve = eq_smt_map_get(else_map, k)
                if vt != vp || ve != vp {
                    if then_ret && else_ret == false {
                        ctx.sym_map = eq_smt_map_set(ctx.sym_map, k, ve)
                    } else if then_ret == false && else_ret {
                        ctx.sym_map = eq_smt_map_set(ctx.sym_map, k, vt)
                    } else {
                        mut sort = "Int"
                        if find_str(ctx.bool_syms, "|" + k + "|", 0) != -1 {
                            sort = "Bool"
                        }
                        ctx.seq = ctx.seq + 1
                        let phi = ctx.pfx + k + "_phi_" + int_to_str(ctx.seq)
                        ctx.decls = ctx.decls + "(declare-const " + phi + " " + sort + ")\n"
                        ctx.asserts = ctx.asserts + "(assert (= " + phi + " (ite " + cond_s + " " + vt + " " + ve + ")))\n"
                        ctx.sym_map = eq_smt_map_set(ctx.sym_map, k, phi)
                    }
                }
            }
        }
        return
    }
    ctx.unsupported = true
}

fn eq_smt_first_fn(pool: AstPool) -> int {
    if pool.has_error || pool.root < 0 || pool.root >= len(pool.nodes) {
        return -1
    }
    let rnd: AstNode = pool.nodes[pool.root]
    for ci in 0..rnd.child_count {
        let cid = pool.children[rnd.child_start + ci]
        if cid >= 0 && cid < len(pool.nodes) && pool.nodes[cid].kind == NK_FN_DECL() {
            return cid
        }
    }
    return -1
}

fn synthesize_equiv_smt(src_a: string, src_b: string) -> string {
    let pa = ast_parse_unit_ex(src_a, ".", "equiv_a.nino", false)
    let pb = ast_parse_unit_ex(src_b, ".", "equiv_b.nino", false)
    let fa = eq_smt_first_fn(pa)
    let fb = eq_smt_first_fn(pb)
    if fa == -1 || fb == -1 {
        return "(set-logic ALL)\n(assert true)\n(check-sat)\n(get-model)\n"
    }
    let fnd_a: AstNode = pa.nodes[fa]
    let fnd_b: AstNode = pb.nodes[fb]
    if fnd_a.child_count != fnd_b.child_count {
        return "(set-logic ALL)\n(declare-const _div_a Int)\n(declare-const _div_b Int)\n(assert (not (= _div_a _div_b)))\n(check-sat)\n(get-model)\n"
    }
    mut param_decls = ""
    mut map_a = "|"
    mut map_b = "|"
    mut bsyms = "|"
    for pi in 0..fnd_a.child_count {
        let pan: AstNode = pa.nodes[pa.children[fnd_a.child_start + pi]]
        let pbn: AstNode = pb.nodes[pb.children[fnd_b.child_start + pi]]
        let ta = trim(pan.type_ann)
        let tb = trim(pbn.type_ann)
        let a_bool = (ta == "bool")
        let b_bool = (tb == "bool")
        if a_bool != b_bool {
            return "(set-logic ALL)\n(declare-const _div_a Int)\n(declare-const _div_b Int)\n(assert (not (= _div_a _div_b)))\n(check-sat)\n(get-model)\n"
        }
        let psym = "_eq_p_" + int_to_str(pi)
        mut psort = "Int"
        if a_bool {
            psort = "Bool"
            bsyms = bsyms + pan.name + "|" + pbn.name + "|"
        }
        param_decls = param_decls + "(declare-const " + psym + " " + psort + ")\n"
        map_a = eq_smt_map_set(map_a, pan.name, psym)
        map_b = eq_smt_map_set(map_b, pbn.name, psym)
    }
    mut ca = EqSmtCtx { pfx: "a_", sym_map: map_a, bool_syms: bsyms, decls: "", asserts: "", ret_conds: [], ret_vals: [], path_cond: "", seq: 0, unsupported: false, always_returned: false }
    mut cb = EqSmtCtx { pfx: "b_", sym_map: map_b, bool_syms: bsyms, decls: "", asserts: "", ret_conds: [], ret_vals: [], path_cond: "", seq: 0, unsupported: false, always_returned: false }
    if fnd_a.left != -1 {
        eq_smt_lower_stmt(pa, fnd_a.left, ca)
    }
    if fnd_b.left != -1 {
        eq_smt_lower_stmt(pb, fnd_b.left, cb)
    }
    mut ret_sort = "Int"
    if trim(fnd_a.type_ann) == "bool" {
        ret_sort = "Bool"
    }
    if ca.unsupported || cb.unsupported || len(ca.ret_vals) == 0 || len(cb.ret_vals) == 0 {
        return "(set-logic ALL)\n" + param_decls + "(declare-const _ret_a " + ret_sort + ")\n(declare-const _ret_b " + ret_sort + ")\n(assert (not (= _ret_a _ret_b)))\n(check-sat)\n(get-model)\n"
    }
    mut out = "(set-logic ALL)\n" + param_decls
    out = out + "(declare-const _ret_a " + ret_sort + ")\n(declare-const _ret_b " + ret_sort + ")\n"
    out = out + ca.decls + cb.decls + ca.asserts + cb.asserts
    for i in 0..len(ca.ret_vals) {
        if len(ca.ret_conds[i]) == 0 {
            out = out + "(assert (= _ret_a " + ca.ret_vals[i] + "))\n"
        } else {
            out = out + "(assert (=> " + ca.ret_conds[i] + " (= _ret_a " + ca.ret_vals[i] + ")))\n"
        }
    }
    for i in 0..len(cb.ret_vals) {
        if len(cb.ret_conds[i]) == 0 {
            out = out + "(assert (= _ret_b " + cb.ret_vals[i] + "))\n"
        } else {
            out = out + "(assert (=> " + cb.ret_conds[i] + " (= _ret_b " + cb.ret_vals[i] + ")))\n"
        }
    }
    out = out + "(assert (not (= _ret_a _ret_b)))\n(check-sat)\n(get-model)\n"
    return out
}

fn generate_cyclonedx_sbom(src_path: string, src_text: string) -> string {
    let root_sha = sha256(src_text)
    let base_dir = get_directory_of(src_path)
    let lb = "{"
    let rb = "}"
    mut comps = "    " + lb + "\n"
    comps = comps + "      \"type\": \"application\",\n"
    comps = comps + "      \"name\": \"" + src_path + "\",\n"
    comps = comps + "      \"version\": \"1.0.0\",\n"
    comps = comps + "      \"hashes\": [" + lb + " \"alg\": \"SHA-256\", \"content\": \"" + root_sha + "\" " + rb + "]\n"
    comps = comps + "    " + rb
    let slen = len(src_text)
    mut pos = 0
    while pos < slen {
        mut lend = pos
        while lend < slen && char_at(src_text, lend) != "\n" {
            lend = lend + 1
        }
        let line = trim(slice(src_text, pos, lend - pos))
        if starts_with(line, "import \"") && ends_with(line, "\"") {
            let imp = slice(line, 8, len(line) - 9)
            let resolved = resolve_import_path(imp, base_dir)
            mut imp_sha = sha256(imp)
            if file_exists(resolved) {
                imp_sha = sha256(read_file(resolved))
            }
            comps = comps + ",\n    " + lb + "\n"
            comps = comps + "      \"type\": \"library\",\n"
            comps = comps + "      \"name\": \"" + imp + "\",\n"
            comps = comps + "      \"version\": \"1.0.0\",\n"
            comps = comps + "      \"hashes\": [" + lb + " \"alg\": \"SHA-256\", \"content\": \"" + imp_sha + "\" " + rb + "]\n"
            comps = comps + "    " + rb
        }
        pos = lend + 1
    }
    let serial_h = sha256("SBOM:" + src_path + ":" + root_sha)
    mut sbom = lb + "\n"
    sbom = sbom + "  \"bomFormat\": \"CycloneDX\",\n"
    sbom = sbom + "  \"specVersion\": \"1.5\",\n"
    sbom = sbom + "  \"serialNumber\": \"urn:uuid:" + slice(serial_h, 0, 8) + "-" + slice(serial_h, 8, 4) + "-4" + slice(serial_h, 13, 3) + "-a" + slice(serial_h, 17, 3) + "-" + slice(serial_h, 20, 12) + "\",\n"
    sbom = sbom + "  \"version\": 1,\n"
    sbom = sbom + "  \"components\": [\n" + comps + "\n  ]\n"
    sbom = sbom + rb + "\n"
    return sbom
}

struct LintAstState {
    cur_fn: string,
    strict_mode: bool,
    mut has_contract: bool,
    mut max_line: int,
    mut violations: int
}

fn lint_audit_ast(pool: AstPool, nid: int, mut st: LintAstState) {
    if nid < 0 || nid >= len(pool.nodes) {
        return
    }
    let nd: AstNode = pool.nodes[nid]
    if nd.line > st.max_line {
        st.max_line = nd.line
    }
    if nd.kind == NK_CONTRACT_REQ() || nd.kind == NK_CONTRACT_ENS() || nd.kind == NK_CONTRACT_INV() {
        st.has_contract = true
    } else if nd.kind == NK_WHILE_STMT() {
        if nd.left >= 0 && nd.left < len(pool.nodes) {
            let cnd: AstNode = pool.nodes[nd.left]
            if (cnd.kind == NK_BOOL_LIT() && cnd.str_val == "true") || (cnd.kind == NK_INT_LIT() && cnd.str_val == "1") {
                print("  [✗ JPL-2 VIOLATION] Unbounded loop condition at line " + int_to_str(nd.line) + " in fn '" + st.cur_fn + "'")
                st.violations = st.violations + 1
            }
        }
    } else if nd.kind == NK_CALL() {
        if nd.left >= 0 && nd.left < len(pool.nodes) {
            let cal: AstNode = pool.nodes[nd.left]
            if cal.kind == NK_IDENT() {
                if cal.name == "require" || cal.name == "ensure" {
                    st.has_contract = true
                } else if st.strict_mode && cal.name == st.cur_fn {
                    print("  [✗ JPL-1 VIOLATION] Direct recursion detected at line " + int_to_str(nd.line) + " in fn '" + st.cur_fn + "'")
                    st.violations = st.violations + 1
                }
            }
        }
    }
    if nd.left != -1 {
        lint_audit_ast(pool, nd.left, st)
    }
    if nd.right != -1 {
        lint_audit_ast(pool, nd.right, st)
    }
    if nd.extra != -1 {
        lint_audit_ast(pool, nd.extra, st)
    }
    for ci in 0..nd.child_count {
        lint_audit_ast(pool, pool.children[nd.child_start + ci], st)
    }
}

fn lint_fn_end_line(clean: string, start_line: int) -> int {
    let n = len(clean)
    mut line = 1
    mut i = 0
    while i < n && line < start_line {
        if char_at(clean, i) == "\n" {
            line = line + 1
        }
        i = i + 1
    }
    mut depth = 0
    mut seen_brace = false
    mut in_str = false
    mut esc = false
    mut in_blk_cmt = false
    while i < n {
        let ch = char_at(clean, i)
        if in_blk_cmt {
            if ch == "*" && i + 1 < n && char_at(clean, i + 1) == "/" {
                in_blk_cmt = false
                i = i + 2
            } else {
                if ch == "\n" { line = line + 1 }
                i = i + 1
            }
        } else if in_str {
            if esc {
                esc = false
                if ch == "\n" { line = line + 1 }
                i = i + 1
            } else if ch == "\\" {
                esc = true
                i = i + 1
            } else if ch == "\"" {
                in_str = false
                i = i + 1
            } else {
                if ch == "\n" { line = line + 1 }
                i = i + 1
            }
        } else if ch == "/" && i + 1 < n && char_at(clean, i + 1) == "/" {
            i = i + 2
            while i < n && char_at(clean, i) != "\n" {
                i = i + 1
            }
        } else if ch == "/" && i + 1 < n && char_at(clean, i + 1) == "*" {
            in_blk_cmt = true
            i = i + 2
        } else if ch == "\"" {
            in_str = true
            i = i + 1
        } else if ch == "{" {
            depth = depth + 1
            seen_brace = true
            i = i + 1
        } else if ch == "}" {
            depth = depth - 1
            if seen_brace && depth <= 0 {
                return line
            }
            i = i + 1
        } else {
            if ch == "\n" { line = line + 1 }
            i = i + 1
        }
    }
    return line
}

fn run_architecture_linter(src_path: string, src_text: string, strict_mode: bool) -> int {
    print("\033[96m================================================================================\033[0m")
    print("\033[93m[Nino Static Architecture & Safety Linter (MISRA-C / NASA JPL Power-of-10)]\033[0m")
    print("  Target Unit : " + src_path)
    if verify_syntax_balance(src_text) == false {
        print("  [✗ MISRA-1 VIOLATION] Unbalanced block or expression delimiters detected.")
        print("\033[96m================================================================================\033[0m")
        return 1
    }
    let clean = replace_str(src_text, "\r\n", "\n")
    let pool = ast_parse_unit_ex(clean, ".", src_path, false)
    if pool.has_error || pool.root < 0 || pool.root >= len(pool.nodes) {
        print("  [✗ MISRA-1 VIOLATION] Parse error during AST architectural audit: " + pool.err_msg)
        print("\033[96m================================================================================\033[0m")
        return 1
    }
    mut fn_count = 0
    mut contract_fns = 0
    mut violations = 0
    let rnd: AstNode = pool.nodes[pool.root]
    for ci in 0..rnd.child_count {
        let fid = pool.children[rnd.child_start + ci]
        if fid >= 0 && fid < len(pool.nodes) && pool.nodes[fid].kind == NK_FN_DECL() {
            let fnd: AstNode = pool.nodes[fid]
            fn_count = fn_count + 1
            mut st = LintAstState { cur_fn: fnd.name, strict_mode: strict_mode, has_contract: false, max_line: fnd.line, violations: 0 }
            if fnd.left != -1 {
                lint_audit_ast(pool, fnd.left, st)
            }
            if st.has_contract {
                contract_fns = contract_fns + 1
            }
            violations = violations + st.violations
            mut end_ln = lint_fn_end_line(clean, fnd.line)
            if st.max_line > end_ln {
                end_ln = st.max_line
            }
            let fn_lines = end_ln - fnd.line
            if strict_mode && fn_lines > 250 {
                print("  [✗ JPL-4 VIOLATION] Function '" + fnd.name + "' exceeds 250-line safety limit (" + int_to_str(fn_lines) + " lines)")
                violations = violations + 1
            }
        }
    }
    print("  Rule MISRA-1 (Delimiter & Scope Balance) : [PASS]")
    print("  Rule JPL-1   (Acyclic Call Graph Audit)  : " + (violations == 0 ? "[PASS]" : "[FAIL]"))
    print("  Rule JPL-2   (Bounded Loop Condition)    : " + (violations == 0 ? "[PASS]" : "[FAIL]"))
    print("  Functions Audited                        : " + int_to_str(fn_count) + " (" + int_to_str(contract_fns) + " with formal contracts)")
    if violations == 0 {
        print("  Linter Verdict                           : \033[92m[✓ 0 ARCHITECTURAL VIOLATIONS]\033[0m")
        print("\033[96m================================================================================\033[0m")
        return 0
    }
    print("  Linter Verdict                           : \033[91m[✗ " + int_to_str(violations) + " VIOLATIONS DETECTED]\033[0m")
    print("\033[96m================================================================================\033[0m")
    return 1
}

