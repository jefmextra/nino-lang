    print("  lsp                                    Launch JSON-RPC 2.0 Language Server Protocol engine")
    print("  pkg <command>                          Manage packages (search, add, install, registry)")
    print("  llvm <file.nino> [-o <ll>]             Emit direct LLVM SSA IR (fail-closed subset; use build --backend=llvm for full language)")
    print("  ir <file.nino>                         Emit optimized Nino Intermediate Representation (NIR)")
    print("  lex <file.nino>                        Scan source into formal token stream via DFA lexer")
    print("  doc <file.nino> [-o <doc>]             Generate automated API documentation from AST")
    print("  prove <file.nino>                      Synthesize and verify formal invariant contracts")
    print("  asm <file.nino> [--arch=x86_64|aarch64] Emit native machine code & annotated assembly directly")
    print("  keygen [--seed <64-hex>]               Generate RFC 8032 Ed25519 keypair for asymmetric PCC signing")
    print("  test                                   Execute native test suite across examples")
    print("  version                                Display sovereign toolchain version and architecture")
    print("  help                                   Display this command reference menu")
    print("\033[96m================================================================================\033[0m")
}

