fn check_nino_source_file(path: string) -> int {
    if file_exists(path) == false {
        print("  [ERROR] Missing expected source file: " + path)
        return 1
    }
    let src = read_file(path)
    let n = len(src)
    mut i = 0
    mut line = 1
    mut violations = 0
    mut in_lcmt = false
    mut in_bcmt = false
    while i < n {
        let ch = char_at(src, i)
        let b0 = char_code_at(src, i)
        if b0 == 226 && i + 2 < n {
            let b1 = char_code_at(src, i + 1)
            let b2 = char_code_at(src, i + 2)
            if b1 == 128 && (b2 == 148 || b2 == 147) {
                print("  [VIOLATION] Forbidden dash character in " + path + " at line " + int_to_str(line))
                violations = violations + 1
            }
        }
        if ch == "\n" {
            line = line + 1
            in_lcmt = false
            i = i + 1
        } else if in_lcmt {
            i = i + 1
        } else if in_bcmt {
            if ch == "*" && i + 1 < n && char_at(src, i + 1) == "/" {
                in_bcmt = false
                i = i + 2
            } else {
                i = i + 1
            }
        } else if ch == "\"" {
            i = i + 1
            mut in_str = true
            while i < n && in_str {
                let sc = char_at(src, i)
                if sc == "\\" {
                    if i + 1 < n && char_at(src, i + 1) == "\n" {
                        line = line + 1
                    }
                    i = i + 2
                } else if sc == "\"" {
                    i = i + 1
                    in_str = false
                } else {
                    if sc == "\n" {
                        line = line + 1
                    }
                    i = i + 1
                }
            }
        } else if ch == "/" && i + 1 < n && char_at(src, i + 1) == "/" {
            in_lcmt = true
            i = i + 2
        } else if ch == "/" && i + 1 < n && char_at(src, i + 1) == "*" {
            in_bcmt = true
            i = i + 2
        } else if ch == "*" && i + 1 < n && char_at(src, i + 1) == "/" {
            print("  [VIOLATION] Unmatched block comment close in " + path + " at line " + int_to_str(line))
            violations = violations + 1
            i = i + 2
        } else if ch == "#" {
            let no_std_tag = "#" + "no_std"
            if slice(src, i, 7) == no_std_tag {
                i = i + 7
            } else {
                print("  [VIOLATION] Forbidden hash comment in " + path + " at line " + int_to_str(line))
                violations = violations + 1
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    if in_bcmt {
        print("  [VIOLATION] Unclosed block comment in " + path + " at line " + int_to_str(line))
        violations = violations + 1
    }
    return violations
}

fn check_text_no_dashes(path: string) -> int {
    if file_exists(path) == false {
        return 0
    }
    let txt = read_file(path)
    let n = len(txt)
    mut i = 0
    mut line = 1
    mut violations = 0
    let e1 = "&" + "mdash;"
    let e2 = "&" + "ndash;"
    let e3 = "&#" + "8212;"
    let e4 = "&#" + "8211;"
    while i < n {
        let b0 = char_code_at(txt, i)
        if b0 == 10 {
            line = line + 1
        } else if b0 == 226 && i + 2 < n {
            let b1 = char_code_at(txt, i + 1)
            let b2 = char_code_at(txt, i + 2)
            if b1 == 128 && (b2 == 148 || b2 == 147) {
                print("  [VIOLATION] Forbidden UTF-8 dash in " + path + " at line " + int_to_str(line))
                violations = violations + 1
            }
        } else if b0 == 38 && i + 7 <= n {
            let sub7 = slice(txt, i, 7)
            if sub7 == e1 || sub7 == e2 || sub7 == e3 || sub7 == e4 {
                print("  [VIOLATION] Forbidden HTML dash entity in " + path + " at line " + int_to_str(line))
                violations = violations + 1
            }
        }
        i = i + 1
    }
    return violations
}

