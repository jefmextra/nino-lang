fn main() -> int {
    let data: [int] = [1, 2, 3, 4, 5, 6, 7, 8]
    let stage1 = arr_filter(data, |x| x > 2 && x < 8)
    let stage2 = arr_map(stage1, |x| x * 3 - 1)
    let total = arr_reduce(stage2, 10, |acc, x| acc + x)
    let chained = arr_reduce(arr_map(arr_filter(data, |n| n % 2 == 1), |n| n * n), 0, |a, b| a + b)
    require(total == 80 && chained == 84, "nested strict-c11 lambdas check failed")
    print("T2-F05-01:PASS")
    return 0
}
