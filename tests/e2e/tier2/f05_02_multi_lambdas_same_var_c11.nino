fn main() -> int {
    let xs: [int] = [1, 2, 3, 4]
    let a = arr_map(xs, |x| x + 1)
    let b = arr_map(xs, |x| x * 2)
    let c = arr_filter(xs, |x| x >= 2)
    let d = arr_filter(xs, |x| x % 2 == 1)
    let sa = arr_reduce(a, 0, |acc, x| acc + x)
    let sb = arr_reduce(b, 0, |acc, x| acc + x)
    require(sa == 14 && sb == 20 && len(c) == 3 && len(d) == 2, "multiple lambdas with same param x failed")
    print("T2-F05-02:PASS")
    return 0
}
