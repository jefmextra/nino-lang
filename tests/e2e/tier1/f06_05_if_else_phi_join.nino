fn phi_pick(a: int) -> int {
    mut x = 1
    if a > 0 {
        x = 2
    } else {
        x = 3
    }
    ensure(x == 2 || x == 3, "phi join preserves branch values")
    return x
}

fn early_ret_phi(b: int) -> int {
    mut y = 5
    if b < 0 {
        return 10
    } else {
        y = 7
    }
    ensure(y == 7, "post-return phi excludes early return path")
    return y
}

fn main() -> int {
    require(phi_pick(5) == 2 && phi_pick(-1) == 3, "phi_pick works")
    require(early_ret_phi(-2) == 10 && early_ret_phi(1) == 7, "early_ret_phi works")
    print("T1-F06-05:PASS")
    return 0
}
