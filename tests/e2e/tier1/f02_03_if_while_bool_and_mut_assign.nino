fn main() -> int {
    mut acc: int = 0
    mut idx: int = 0
    let limit: int = 5
    while idx < limit && acc < 100 {
        if (idx % 2 == 0) && (idx != 4) {
            acc = acc + 10
        } else if idx == 4 || idx == 3 {
            acc = acc + 5
        } else {
            acc = acc + 1
        }
        idx = idx + 1
    }
    require(acc == 31, "compound control flow accumulator must be 31")
    print("T1-F02-03:PASS")
    return 0
}
