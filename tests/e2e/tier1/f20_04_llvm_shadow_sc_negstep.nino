import "std/str.nino"

fn resolve_ninoc_cmd() -> string {
    if is_windows() {
        if file_exists("ninoc.exe") { return "ninoc.exe" }
        return "ninoc.exe"
    }
    if file_exists("./ninoc") { return "./ninoc" }
    return "ninoc"
}

fn c11_neg_step_sum() -> int {
    mut s = 0
    for i in 5..0 step -1 {
        s = s + i
    }
    return s
}

fn main() -> int {
    require(c11_neg_step_sum() == 15, "C11 negative-step for loop sum must equal 15")
    let ninoc = resolve_ninoc_cmd()
    let lb = "{"
    let rb = "}"
    let src_p = "temp_e2e_f20_04_llvm.nino"
    let ll_p = "temp_e2e_f20_04_llvm.ll"
    mut code = "fn sum_down() -> int " + lb + "\n    mut s = 0\n    for i in 5..0 step -1 " + lb + "\n        s = s + i\n    " + rb + "\n    return s\n" + rb + "\n"
    code = code + "fn main() -> int " + lb + "\n    let r1 = 7\n    let x = 5\n    if true " + lb + "\n        let x = 99\n        if x != 99 " + lb + "\n            return 1\n        " + rb + "\n    " + rb + "\n    if x != 5 || r1 != 7 " + lb + "\n        return 2\n    " + rb + "\n    let z = 0\n    if z != 0 && (10 / z) > 1 " + lb + "\n        return 3\n    " + rb + "\n    if sum_down() != 15 " + lb + "\n        return 4\n    " + rb + "\n    return 0\n" + rb + "\n"
    write_file(src_p, code)
    require(exec_cmd(ninoc + " llvm " + src_p + " -o " + ll_p) == 0, "ninoc llvm must emit IR for shadow/short-circuit/neg-step test")
    let ir = read_file(ll_p)
    require(str_contains(ir, "%lv.r1."), "Local allocas must use %lv.<name>.<seq> prefix to avoid SSA collisions")
    require(str_contains(ir, "sc.rhs."), "Logical conjunction must lower via short-circuit basic blocks")
    require(str_contains(ir, "select i1 "), "Negative-step for loop must emit sign-aware bound select")
    if !is_windows() {
        let obj_p = "temp_e2e_f20_04_llvm.o"
        let exe_p = "temp_e2e_f20_04_llvm.exe"
        if exec_cmd("clang --version >/dev/null 2>&1") == 0 {
            require(exec_cmd("clang -c " + ll_p + " -o " + obj_p) == 0, "clang must compile emitted LLVM IR")
            require(exec_cmd("gcc " + obj_p + " -o " + exe_p) == 0, "gcc must link compiled LLVM IR")
            require(exec_cmd("./" + exe_p) == 0, "compiled LLVM IR executable must return 0")
            file_delete(obj_p)
            file_delete(exe_p)
        }
    }
    file_delete(src_p)
    file_delete(ll_p)
    print("T1-F20-04:PASS")
    return 0
}
