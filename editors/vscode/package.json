{
  "name": "nino-lang",
  "displayName": "Nino Language Support",
  "description": "Official Language Server Protocol and syntax highlighting for the Nino systems programming language.",
  "version": "1.0.0",
  "publisher": "vvictor",
  "repository": {
    "type": "git",
    "url": "https://github.com/jefmextra/nino-lang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:nino"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nino",
        "aliases": [
          "Nino",
          "nino"
        ],
        "extensions": [
          ".nino"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nino",
        "scopeName": "source.nino",
        "path": "./syntaxes/nino.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "nino.restartServer",
        "title": "Nino: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Nino",
      "properties": {
        "nino.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ninoc (or nino) compiler executable. Leave empty to auto-detect from workspace, NINO_HOME, or PATH."
        },
        "nino.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Nino language server."
        }
      }
    }
  }
}
